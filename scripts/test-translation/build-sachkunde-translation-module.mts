import { readFile, writeFile } from "node:fs/promises";
import path from "node:path";

type Lang = "hu" | "ro" | "en";
type ResultRow = {
  id: string;
  status: string;
  translations?: Record<string, string>;
  error?: string;
};

const manifestPath = path.resolve(process.argv[2] ?? "translation-work/sachkunde-test/source-manifest.json");
const resultDir = path.resolve(process.argv[3] ?? "translation-work/sachkunde-test");
const outputPath = path.resolve(process.argv[4] ?? "lib/sachkundeQuestionTranslations.generated.ts");
const repairManifestPath = process.argv[5] ? path.resolve(process.argv[5]) : undefined;
const repairResultDir = process.argv[6] ? path.resolve(process.argv[6]) : undefined;
const huQualityManifestPath = process.argv[7] ? path.resolve(process.argv[7]) : undefined;
const huQualityResultDir = process.argv[8] ? path.resolve(process.argv[8]) : undefined;

async function loadLanguage(manifest: Record<string, string>, directory: string, lang: Lang, prefix = "result") {
  const rows = (await readFile(path.join(directory, `${prefix}-${lang}.jsonl`), "utf8"))
    .split(/\r?\n/)
    .filter(Boolean)
    .map(line => JSON.parse(line) as ResultRow);
  const latestByBatch = new Map<string, ResultRow>();
  for (const row of rows) latestByBatch.set(row.id, row);
  const byKey: Record<string, string> = {};
  for (const row of latestByBatch.values()) {
    if (row.status !== "completed" || !row.translations) {
      throw new Error(`${lang}: incomplete batch ${row.id}: ${row.error ?? row.status}`);
    }
    for (const [key, value] of Object.entries(row.translations)) {
      if (!(key in manifest)) throw new Error(`${lang}: unknown key ${key}`);
      if (!value.trim()) throw new Error(`${lang}: empty translation ${key}`);
      byKey[key] = value.trim();
    }
  }
  const missing = Object.keys(manifest).filter(key => !(key in byKey));
  if (missing.length) throw new Error(`${lang}: ${missing.length} translations missing`);
  return Object.fromEntries(Object.entries(manifest).map(([key, source]) => [source, byKey[key]]));
}

const manifest = JSON.parse(await readFile(manifestPath, "utf8")) as Record<string, string>;
const repairManifest = repairManifestPath
  ? JSON.parse(await readFile(repairManifestPath, "utf8")) as Record<string, string>
  : undefined;
const huQualityManifest = huQualityManifestPath
  ? JSON.parse(await readFile(huQualityManifestPath, "utf8")) as Record<string, string>
  : undefined;
const translations: Record<Lang, Record<string, string>> = { hu: {}, ro: {}, en: {} };
for (const lang of ["hu", "ro", "en"] as Lang[]) {
  Object.assign(translations[lang], await loadLanguage(manifest, resultDir, lang));
  if (repairManifest && repairResultDir) {
    Object.assign(translations[lang], await loadLanguage(repairManifest, repairResultDir, lang, "repair"));
  }
}
if (huQualityManifest && huQualityResultDir) {
  Object.assign(
    translations.hu,
    await loadLanguage(huQualityManifest, huQualityResultDir, "hu", "repair2"),
  );
}

const output = "// Generated by scripts/test-translation/build-sachkunde-translation-module.mts.\n" +
  "// Do not edit by hand. German source strings are exact lookup keys.\n" +
  `export const SACHKUNDE_QUESTION_TRANSLATIONS = ${JSON.stringify(translations, null, 2)} as const;\n`;
await writeFile(outputPath, output, "utf8");
console.log(JSON.stringify({ strings: Object.keys(translations.hu).length, languages: 3, outputPath }));
