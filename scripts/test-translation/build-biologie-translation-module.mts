import { readFile, writeFile } from "node:fs/promises";
import path from "node:path";

type Lang = "hu" | "ro" | "en";
type ResultRow = {
  id: string;
  status: string;
  translations?: Record<string, string>;
  error?: string;
};

const root = path.resolve(process.argv[2] ?? "translation-work/biologie-test");
const manifest = JSON.parse(
  await readFile(path.join(root, "source-manifest.json"), "utf8"),
) as Record<string, string>;

async function loadLanguage(lang: Lang) {
  const resultFiles = [path.join(root, `result-${lang}.jsonl`)];
  if (lang === "hu") {
    resultFiles.push(path.join(root, "repair-hu", "result-hu.jsonl"));
    resultFiles.push(path.join(root, "repair2-hu", "result-hu.jsonl"));
  }
  if (lang === "ro") resultFiles.push(path.join(root, "repair2-ro", "result-ro.jsonl"));
  const rows: ResultRow[] = [];
  for (const resultFile of resultFiles) {
    try {
      rows.push(...(await readFile(resultFile, "utf8"))
        .split(/\r?\n/)
        .filter(Boolean)
        .map(line => JSON.parse(line) as ResultRow));
    } catch (error) {
      if ((error as NodeJS.ErrnoException).code !== "ENOENT" || resultFile === resultFiles[0]) throw error;
    }
  }
  const latestByBatch = new Map<string, ResultRow>();
  for (const row of rows) latestByBatch.set(row.id, row);
  const byKey: Record<string, string> = {};
  for (const row of latestByBatch.values()) {
    if (row.status !== "completed" || !row.translations) {
      throw new Error(`${lang}: incomplete batch ${row.id}: ${row.error ?? row.status}`);
    }
    for (const [key, value] of Object.entries(row.translations)) {
      if (!(key in manifest)) throw new Error(`${lang}: unknown key ${key}`);
      if (!value.trim()) throw new Error(`${lang}: empty translation ${key}`);
      byKey[key] = value.trim();
    }
  }
  const missing = Object.keys(manifest).filter(key => !(key in byKey));
  if (missing.length) throw new Error(`${lang}: ${missing.length} translations missing`);
  return Object.fromEntries(Object.entries(manifest).map(([key, source]) => [source, byKey[key]]));
}

const translations = {
  hu: await loadLanguage("hu"),
  ro: await loadLanguage("ro"),
  en: await loadLanguage("en"),
};

const output = "// Generated by scripts/test-translation/build-biologie-translation-module.mts.\n" +
  "// Do not edit by hand. German source strings are exact lookup keys.\n" +
  `export const BIOLOGIE_QUESTION_TRANSLATIONS = ${JSON.stringify(translations, null, 2)} as const;\n`;
const outputPath = path.resolve(process.argv[3] ?? "lib/biologieQuestionTranslations.generated.ts");
await writeFile(outputPath, output, "utf8");
console.log(JSON.stringify({ strings: Object.keys(manifest).length, languages: 3, outputPath }));
