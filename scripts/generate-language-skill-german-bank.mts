import fs from "node:fs";
import deutschCurriculum from "../lib/deutschCurriculum.ts";
import type { DeutschMCQ } from "../lib/deutsch/types.ts";

const { DEUTSCH_CURRICULUM } = deutschCurriculum;

const GAME_IDS = ["lese-detektiv", "grammatik-scanner", "text-retter", "wort-netz", "schreibwerkstatt", "literatur-lupe"] as const;
type GameId = (typeof GAME_IDS)[number];
type Entry = readonly [string, string, string, string, string, string];

const FILTERS: Record<GameId, RegExp> = {
  "lese-detektiv": /les|text|inhalt|versteh|sachtext|erzähl|geschichte|fabel|brief|bericht|beschreibung|argument/i,
  "grammatik-scanner": /gram|wortart|satzglied|satzbau|kasus|nomen|verb|adjektiv|pronomen|zeitform|konjunktiv|aktiv|passiv|objekt|prädikat/i,
  "text-retter": /rechtsch|zeichen|komma|groß|klein|getrennt|zusammen|das_dass|fehler|dehnung|konsonant|silben/i,
  "wort-netz": /wortschatz|synonym|antonym|wortfamil|wortbildung|fremdwort|redewendung|sprich|wortfeld|vorsilbe|nachsilbe|bedeutung/i,
  "schreibwerkstatt": /schreib|aufsatz|argument|beschreib|bericht|erörter|zusammenfass|textarbeit|brief|erzähl/i,
  "literatur-lupe": /literatur|stilmittel|lyrik|gedicht|metapher|vergleich|personifikation|perspektiv|erzählform|ironie|rhetorik|interpretation/i,
};

const PROMPTS: Record<GameId, string> = {
  "lese-detektiv": "Welche Aussage wird durch den Text oder die Aufgabe gestützt?",
  "grammatik-scanner": "Welche sprachliche Einordnung ist richtig?",
  "text-retter": "Welche Reparatur oder Schreibweise ist richtig?",
  "wort-netz": "Welche Wortverbindung oder Bedeutung passt?",
  "schreibwerkstatt": "Welche Lösung erfüllt den Schreibauftrag am besten?",
  "literatur-lupe": "Welche Deutung oder Wirkung passt zum Text?",
};

interface Candidate { entry: Entry; label: string; complexity: number; key: string }
function candidatesForGrade(grade: number): Candidate[] {
  const result: Candidate[] = [];
  for (const theme of DEUTSCH_CURRICULUM[grade] ?? []) for (const sub of theme.subtopics) for (const question of sub.questions) {
    if (question.type !== "mcq") continue;
    const item = question as DeutschMCQ;
    if (!item.question?.trim() || !Array.isArray(item.options) || item.options.length < 3 || item.correct < 0 || item.correct >= item.options.length) continue;
    const options = item.options.map((value) => value.trim()).filter(Boolean);
    const correct = item.options[item.correct]?.trim();
    if (!correct) continue;
    const normalizedCorrect = correct.toLocaleLowerCase("de").replace(/\s+/g, " ");
    const seenOptions = new Set([normalizedCorrect]);
    const wrong: string[] = [];
    for (const value of item.options.filter((_, index) => index !== item.correct).map((option) => option.trim()).filter(Boolean)) {
      const normalized = value.toLocaleLowerCase("de").replace(/\s+/g, " ");
      if (seenOptions.has(normalized)) continue;
      seenOptions.add(normalized);
      wrong.push(value);
    }
    if (wrong.length < 2) continue;
    const label = `${theme.id} ${theme.name} ${sub.id} ${sub.name}`;
    const key = item.question.trim().toLocaleLowerCase("de").replace(/\s+/g, " ");
    result.push({ entry: [item.question.trim(), "", correct, wrong[0], wrong[1], `Zum Themenfeld „${sub.name}“ passt die Lösung „${correct}“.`], label, key, complexity: item.question.length + options.reduce((sum, value) => sum + value.length, 0) / options.length });
  }
  return [...new Map(result.map((item) => [item.key, item])).values()];
}

function evenlyPick(values: Candidate[], count: number): Candidate[] {
  if (values.length <= count) return [...values];
  const sorted = [...values].sort((a, b) => a.complexity - b.complexity || a.key.localeCompare(b.key, "de"));
  return Array.from({ length: count }, (_, index) => sorted[Math.floor((index * sorted.length) / count)]);
}

const bank: Record<GameId, Record<number, Entry[]>> = Object.fromEntries(GAME_IDS.map((gameId) => [gameId, {}])) as Record<GameId, Record<number, Entry[]>>;
for (let grade = 1; grade <= 8; grade += 1) {
  const all = candidatesForGrade(grade);
  for (const gameId of GAME_IDS) {
    const preferred = all.filter((item) => FILTERS[gameId].test(`${item.label} ${item.entry[0]}`));
    const selected = evenlyPick(preferred, 40);
    if (selected.length < 40) {
      const used = new Set(selected.map((item) => item.key));
      selected.push(...evenlyPick(all.filter((item) => !used.has(item.key)), 40 - selected.length));
    }
    const final = selected.slice(0, 40).sort((a, b) => a.complexity - b.complexity || a.key.localeCompare(b.key, "de"));
    bank[gameId][grade] = final.map((item) => [item.entry[0], PROMPTS[gameId], item.entry[2], item.entry[3], item.entry[4], item.entry[5]]);
  }
}

const output = `// Generated by scripts/generate-language-skill-german-bank.mts.\n// Forty distinct, difficulty-ordered rounds per grade and skill game.\nimport type { LanguageSkillGameId } from "./languageSkillContent";\n\nexport type GermanSkillEntry = readonly [string, string, string, string, string, string];\nexport const GERMAN_SKILL_BANK: Record<LanguageSkillGameId, Record<number, readonly GermanSkillEntry[]>> = ${JSON.stringify(bank, null, 2)};\n`;
fs.writeFileSync(new URL("../lib/visualLab/languageSkillGermanBank.ts", import.meta.url), output, "utf8");
console.log(`Generated German skill bank: ${GAME_IDS.length * 8 * 40} rows.`);
