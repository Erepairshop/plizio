// Build-time script: scans lib/visualLab/data/*.ts and generates
// _all_poi_sources.generated.ts with static imports of every POI file.
// Run before any script that consumes ALL_POI_SOURCES.
import fs from "node:fs";
import path from "node:path";
import { fileURLToPath } from "node:url";

const __dirname = path.dirname(fileURLToPath(import.meta.url));
const DATA = path.resolve(__dirname, "..", "lib", "visualLab", "data");
const OUT = path.join(DATA, "_all_poi_sources.generated.ts");

const SKIP_PATTERNS = [
  /\.bak/, /\.before/, /^_/, /\.generated\./,
  /\.json$/, /\.tmp/, /^poi\.ts$/,  // poi.ts is the type def, not data
  /^index\.ts$/,
  /^\./,  // hidden dot-files (e.g. .hungaryPoi.backup)
  /\.backup$/i, /\.backup\.ts$/i, /\.old\.ts$/i,
  /_old\.ts$/i, /_OLD\.ts$/, /_test\.ts$/i, /_unused\.ts$/i,
];

const files = fs.readdirSync(DATA)
  .filter(f => f.endsWith(".ts"))
  .filter(f => !SKIP_PATTERNS.some(p => p.test(f)))
  .sort();

console.log(`Scanning ${files.length} POI source files...`);

const imports: string[] = [];
const flatten: string[] = [];

for (const file of files) {
  const base = file.replace(/\.ts$/, "");
  // Parse file to find exported array names. We grep for `export const NAME[: ... ]? =`
  const txt = fs.readFileSync(path.join(DATA, file), "utf-8");
  const exportRe = /export\s+const\s+(\w+)\s*(?::\s*[^=]+)?=\s*\[/g;
  const exports: string[] = [];
  let m;
  while ((m = exportRe.exec(txt))) {
    exports.push(m[1]);
  }
  if (exports.length === 0) continue;
  // Alias to file basename for uniqueness
  const aliasNamespace = `_src_${base.replace(/[^a-zA-Z0-9]/g, "_")}`;
  imports.push(`import * as ${aliasNamespace} from "./${base}";`);
  for (const exp of exports) {
    flatten.push(`  ...((${aliasNamespace} as any).${exp} as any[]),`);
  }
}

const banner = `// AUTO-GENERATED by scripts/gen_poi_manifest.mts. Do not edit by hand.
// Re-run that script whenever a POI data file is added or removed.
// eslint-disable-next-line @typescript-eslint/no-explicit-any
`;

const code = `${banner}
${imports.join("\n")}

const _raw: any[] = [
${flatten.join("\n")}
];

// Dedup by id, keep RICHEST copy (counts description/descriptionAdvanced length
// + sights heavily + image + factsAdvanced + faq). 119K entries → ~44K unique.
function _richness(p: any): number {
  let n = 0;
  for (const L of ["de","hu","ro","en"]) {
    n += (p?.description?.[L]?.length || 0);
    n += (p?.descriptionAdvanced?.[L]?.length || 0);
  }
  if (p?.image) n += 50;
  if (p?.sights) for (const L of ["de","hu","ro","en"]) n += ((p.sights[L]?.length || 0) * 100);
  if (p?.nearbySights) for (const L of ["de","hu","ro","en"]) n += ((p.nearbySights[L]?.length || 0) * 100);
  if (p?.factsAdvanced) for (const L of ["de","hu","ro","en"]) n += ((p.factsAdvanced[L]?.length || 0) * 10);
  if (p?.faq) n += 100;
  return n;
}
const _byId = new Map<string, any>();
const _noId: any[] = [];
for (const p of _raw) {
  if (!p?.id) { _noId.push(p); continue; }
  const prev = _byId.get(p.id);
  if (!prev || _richness(p) > _richness(prev)) _byId.set(p.id, p);
}
export const ALL_POI_SOURCES: any[] = [..._byId.values(), ..._noId];
`;

fs.writeFileSync(OUT, code, "utf-8");
console.log(`Wrote ${OUT}`);
console.log(`  ${files.length} files, ${imports.length} files-with-exports, ${flatten.length} exported arrays`);
