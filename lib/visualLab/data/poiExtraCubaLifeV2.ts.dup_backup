  {
    id: "valle-prehistoria-life-v2",
    type: "kid-landmark",
    parent: "CU-13",
    coords: [-75.4600, 19.9000],
    name: { de: "Tal der Urzeit", hu: "Őstörténeti völgy", ro: "Valea Preistoriei", en: "Prehistoric Valley" },
    description: {
      de: "Ein Bereich im Baconao Park mit lebensgroßen Dinosaurier-Skulpturen.",
      hu: "Őstörténeti témájú szabadtéri látványosság, amely a családi kirándulásokhoz kapcsolódik.",
      ro: "O zonă în parcul Baconao cu sculpturi de dinozauri în mărime naturală.",
      en: "A section in Baconao Park with life-sized dinosaur sculptures."
    },
    facts: {
      de: ["Über 200 Skulpturen", "Bildung für Kinder", "Outdoor-Attraktion", "Familienfreundlich"],
      hu: ["Szabadtéri park", "Őslénytani tematika", "Látványos szobrok"],
      ro: ["Peste 200 de sculpturi", "Educație pentru copii", "Atracție în aer liber", "Ideal pentru familii"],
      en: ["Over 200 sculptures", "Educational for children", "Outdoor attraction", "Family-friendly"]
    },
    descriptionAdvanced: {
      de: "Ein Bereich im Baconao Park mit lebensgroßen Dinosaurier-Skulpturen. Über 200 Skulpturen. Bildung für Kinder. Outdoor-Attraktion. Familienfreundlich. Damit zählt der Ort zu den charakteristischen Punkten der karibischen Inselrepublik Kuba und spiegelt die Verbindung von Geschichte, Tabak- und Zuckerrohranbau sowie tropischer Natur wider. Liegt im karibischen Inselstaat Kuba. Tropisch-feuchtes Klima mit ausgeprägter Regen- und Trockenzeit. Hauptstadt Havanna ist das politische und kulturelle Zentrum des Landes. Region ist eng mit dem Anbau von Tabak, Zuckerrohr und Kaffee verbunden. Sierra Maestra im Südosten prägt die Topografie der Insel.",
      hu: "Terület a Baconao Parkban, élethű dinoszaurusz-szobrokkal. Több mint 200 szobor. Oktatás gyermekeknek. Szabadtéri látnivaló. Családbarát. Ezzel a hely Kuba, a karibi szigetállam egyik jellegzetes pontja, amely a történelem, a dohány- és cukornádtermesztés, valamint a trópusi természet összefonódását tükrözi. A karibi térség legnagyobb szigetországában, Kubában fekszik. Trópusi-nedves éghajlat jellemzi, kifejezett esős és száraz évszakkal. Az ország politikai és kulturális központja a főváros, Havanna. A régió szorosan kötődik a dohány-, cukornád- és kávétermesztéshez. A délkeleti Sierra Maestra hegység meghatározza a sziget domborzatát.",
      ro: "O zonă în parcul Baconao cu sculpturi de dinozauri în mărime naturală. Peste 200 de sculpturi. Educație pentru copii. Atracție în aer liber. Ideal pentru familii. Astfel, locul se numără printre punctele caracteristice ale Cubei, statul insular caraibian, reflectând împletirea dintre istorie, cultivarea tutunului și a trestiei de zahăr și natura tropicală. Este situat în Cuba, cel mai mare stat insular din Caraibe. Climat tropical-umed, cu sezon ploios și sezon secetos bine conturate. Capitala Havana este centrul politic și cultural al țării.",
      en: "A section in Baconao Park with life-sized dinosaur sculptures. Over 200 sculptures. Educational for children. Outdoor attraction. Family-friendly. Thus, the site is among the characteristic points of Cuba, the Caribbean island nation, reflecting the interplay of history, tobacco and sugarcane cultivation, and tropical nature. Located in Cuba, the largest island state in the Caribbean. Tropical-humid climate with distinct wet and dry seasons. Havana, the capital, is the country's political and cultural hub. The region is closely tied to tobacco, sugarcane and coffee cultivation."
    },
    factsAdvanced: {
      de: ["Über 200 Skulpturen", "Bildung für Kinder", "Outdoor-Attraktion", "Familienfreundlich", "Ein Bereich im Baconao Park mit lebensgroßen Dinosaurier-Skulpturen.", "Liegt im karibischen Inselstaat Kuba.", "Tropisch-feuchtes Klima mit ausgeprägter Regen- und Trockenzeit.", "Hauptstadt Havanna ist das politische und kulturelle Zentrum des Landes."],
      hu: ["Több mint 200 szobor", "Oktatás gyermekeknek", "Szabadtéri látnivaló", "Családbarát", "Terület a Baconao Parkban, élethű dinoszaurusz-szobrokkal.", "A karibi térség legnagyobb szigetországában, Kubában fekszik.", "Trópusi-nedves éghajlat jellemzi, kifejezett esős és száraz évszakkal.", "Az ország politikai és kulturális központja a főváros, Havanna."],
      ro: ["Peste 200 de sculpturi", "Educație pentru copii", "Atracție în aer liber", "Ideal pentru familii", "O zonă în parcul Baconao cu sculpturi de dinozauri în mărime naturală.", "Este situat în Cuba, cel mai mare stat insular din Caraibe.", "Climat tropical-umed, cu sezon ploios și sezon secetos bine conturate.", "Capitala Havana este centrul politic și cultural al țării."],
      en: ["Over 200 sculptures", "Educational for children", "Outdoor attraction", "Family-friendly", "A section in Baconao Park with life-sized dinosaur sculptures.", "Located in Cuba, the largest island state in the Caribbean.", "Tropical-humid climate with distinct wet and dry seasons.", "Havana, the capital, is the country's political and cultural hub."]
    }
  },
  {
    id: "zoologico-de-26-life-v2",
    type: "animal-habitat",
    parent: "CU-10",
    coords: [-82.3900, 23.1200],
    name: { de: "Zoo von Havanna (26. Juli)", hu: "Havannai Állatkert (Július 26.)", ro: "Grădina Zoologică din Havana (26 Iulie)", en: "Havana Zoo (July 26)" },
    description: {
      de: "Ein kleinerer Stadtzoo im Zentrum von Havanna. Er eignet sich für kurze Besuche und zeigt vor allem lokale Tierarten.",
      hu: "Kisebb városi állatkert Havanna szívében.",
      ro: "O grădină zoologică urbană mai mică în inima Havanei. Este potrivită pentru vizite scurte și pentru a vedea specii locale.",
      en: "A city zoo in Havana that serves as a small family attraction."
    },
    facts: {
      de: ["Im Zentrum von Havanna", "Lokale Tierarten", "Schattige Wege"],
      hu: ["Központi elhelyezkedés", "Ideális rövid kirándulásokhoz", "Helyi állatfajok", "Árnyékos sétányok"],
      ro: ["situată central", "ideal pentru excursii scurte", "specii locale", "alei umbrite"],
      en: ["Havana", "Urban zoo", "Family visits"]
    }, image: "/poi-images/zoologico-de-26-life-v2.webp",
    descriptionAdvanced: {
      de: "Ein kleinerer städtischer Zoo im Herzen von Havanna. Zentral gelegen. Ideal für kurze Ausflüge. Lokale Tierarten. Schattige Wege. Damit zählt der Ort zu den charakteristischen Punkten der karibischen Inselrepublik Kuba und spiegelt die Verbindung von Geschichte, Tabak- und Zuckerrohranbau sowie tropischer Natur wider. Liegt im karibischen Inselstaat Kuba. Tropisch-feuchtes Klima mit ausgeprägter Regen- und Trockenzeit. Hauptstadt Havanna ist das politische und kulturelle Zentrum des Landes. Region ist eng mit dem Anbau von Tabak, Zuckerrohr und Kaffee verbunden. Sierra Maestra im Südosten prägt die Topografie der Insel.",
      hu: "Kisebb városi állatkert Havanna szívében. Központi elhelyezkedés. Ideális rövid kirándulásokhoz. Helyi állatfajok. Árnyékos sétányok. Ezzel a hely Kuba, a karibi szigetállam egyik jellegzetes pontja, amely a történelem, a dohány- és cukornádtermesztés, valamint a trópusi természet összefonódását tükrözi. A karibi térség legnagyobb szigetországában, Kubában fekszik. Trópusi-nedves éghajlat jellemzi, kifejezett esős és száraz évszakkal. Az ország politikai és kulturális központja a főváros, Havanna. A régió szorosan kötődik a dohány-, cukornád- és kávétermesztéshez. A délkeleti Sierra Maestra hegység meghatározza a sziget domborzatát.",
      ro: "O grădină zoologică urbană mai mică în inima Havanei. Situată central. Ideal pentru excursii scurte. Specii locale. Aleile umbrite. Astfel, locul se numără printre punctele caracteristice ale Cubei, statul insular caraibian, reflectând împletirea dintre istorie, cultivarea tutunului și a trestiei de zahăr și natura tropicală. Este situat în Cuba, cel mai mare stat insular din Caraibe. Climat tropical-umed, cu sezon ploios și sezon secetos bine conturate. Capitala Havana este centrul politic și cultural al țării. Regiunea este strâns legată de cultura tutunului, a trestiei de zahăr și a cafelei.",
      en: "A smaller urban zoo located in the heart of Havana. Centrally located. Great for short visits. Features local species. Shady walkways. Thus, the site is among the characteristic points of Cuba, the Caribbean island nation, reflecting the interplay of history, tobacco and sugarcane cultivation, and tropical nature. Located in Cuba, the largest island state in the Caribbean. Tropical-humid climate with distinct wet and dry seasons. Havana, the capital, is the country's political and cultural hub. The region is closely tied to tobacco, sugarcane and coffee cultivation."
    },
    factsAdvanced: {
      de: ["Zentral gelegen", "Ideal für kurze Ausflüge", "Lokale Tierarten", "Schattige Wege", "Ein kleinerer städtischer Zoo im Herzen von Havanna.", "Liegt im karibischen Inselstaat Kuba.", "Tropisch-feuchtes Klima mit ausgeprägter Regen- und Trockenzeit.", "Hauptstadt Havanna ist das politische und kulturelle Zentrum des Landes."],
      hu: ["Központi elhelyezkedés", "Ideális rövid kirándulásokhoz", "Helyi állatfajok", "Árnyékos sétányok", "Kisebb városi állatkert Havanna szívében.", "A karibi térség legnagyobb szigetországában, Kubában fekszik.", "Trópusi-nedves éghajlat jellemzi, kifejezett esős és száraz évszakkal.", "Az ország politikai és kulturális központja a főváros, Havanna."],
      ro: ["Situată central", "Ideal pentru excursii scurte", "Specii locale", "Aleile umbrite", "O grădină zoologică urbană mai mică în inima Havanei.", "Este situat în Cuba, cel mai mare stat insular din Caraibe.", "Climat tropical-umed, cu sezon ploios și sezon secetos bine conturate.", "Capitala Havana este centrul politic și cultural al țării."],
      en: ["Centrally located", "Great for short visits", "Features local species", "Shady walkways", "A smaller urban zoo located in the heart of Havana.", "Located in Cuba, the largest island state in the Caribbean.", "Tropical-humid climate with distinct wet and dry seasons.", "Havana, the capital, is the country's political and cultural hub."]
    }
