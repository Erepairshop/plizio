  {
    id: "parque-industrial-cartago-economic-v2",
    type: "industry",
    parent: "CR-C",
    coords: [-83.8967, 9.8700],
    name: { de: "Industriepark Cartago", hu: "Cartago Iparközpont", ro: "Parc Industrial Cartago", en: "Cartago Industrial Park" },
    description: { de: "Ein bedeutender Industriestandort für Technologie und Fertigung.", hu: "Jelentős ipari helyszín technológiai és gyártási szektorban.", ro: "Un centru industrial semnificativ pentru tehnologie și producție.", en: "A major industrial hub for technology and manufacturing." },
    descriptionAdvanced: {
      de: "Der Industriepark Cartago liegt in einer der traditionsreichsten Städte Costa Ricas und verbindet alte Hauptstadtgeschichte mit moderner Fertigung. Der Standort ist besonders stark in der Herstellung medizinischer Gerște, bei Elektronik und im Gesundheitsbereich. Seine Lage im Umfeld von Cartago und in Reichweite von San Jos? macht ihn f?r hochqualifizierte Arbeitskr?fte attraktiv, w?hrend das nahe TEC den technologischen Charakter der Region st?tzt. So ist der Park ein typisches Beispiel daf?r, wie Ausbildung, Exportindustrie und Stadtentwicklung in Costa Rica zusammenwirken. Geografie K8 ? Industriecluster und Qualifikationsr?ume.",
      hu: "A Cartago Iparközpont Costa Rica egyik legrégebbi és legfontosabb ipari zónája, amely az egykori főváros közelében fekszik. A területet kifejezetten a technológiai orientációjú vállalatok számára alakították ki, így ma számos orvostechnikai, elektronikai és precíziós gyártással foglalkozó nemzetközi cégnek ad otthont. Az iparközpont elhelyezkedése ideális, mivel közel van a rangos Costa Rica-i Technológiai Intézethez (TEC), ami biztosítja a magasan képzett munkaerőt. A modern infrastruktúra és a kedvező adózási környezet miatt a park a régió gazdasági motorjává vált. Az itt gyártott termékek jelentős részét az észak-amerikai és európai piacokra exportálják. Földrajz K8 – ipari körzetek és technológiai transzfer.",
      ro: "Parcul Industrial Cartago este una dintre cele mai vechi și importante zone industriale din Costa Rica, situată lângă fosta capitală. Zona a fost special concepută pentru companii cu orientare tehnologică, găzduind astăzi numeroase firme internaționale de tehnologie medicală, electronică și producție de precizie. Locația parcului industrial este ideală, fiind aproape de prestigiosul Institut Tehnologic din Costa Rica (TEC), ceea ce asigură o forță de muncă înalt calificată. Datorită infrastructurii moderne și a mediului fiscal favorabil, parcul a devenit motorul economic al regiunii. O parte semnificativă a produselor fabricate aici este exportată pe piețele nord-americane și europene. Geografie K8 – districte industriale și transfer tehnologic.",
      en: "The Cartago Industrial Park is a major manufacturing hub located in the central highlands, focusing on medical devices and advanced technology components. It plays a vital role in Costa Rica's shift from an agricultural-based economy to a high-tech electronics and healthcare exporter. Geography K7 — economic zones."
    },
    factsAdvanced: {
      en: ["Located in the historic city of Cartago.", "Major cluster for medical device manufacturing.", "Supports thousands of high-tech jobs.", "Focus on electronics and healthcare.", "Strategically located near San José.", "Key contributor to national export growth."],
      de: ["Der Park liegt in der historischen Stadt Cartago.", "Ein Schwerpunkt ist die Produktion medizinischer Gerște.", "Er unterst?tzt Tausende hochqualifizierter Arbeitspl?tze.", "Elektronik und Gesundheitswirtschaft prägen den Standort.", "Er liegt strategisch nahe San Jos?.", "Er tr?gt zum Wachstum der Exporte bei."]
    },
    facts: {
      de: ["Technologiezentrum", "Viele multinationale Firmen", "Regionale Arbeitsplätze", "Wirtschaftsmotor"],
      hu: ["Technológiai központ", "Sok multinacionális cég", "Regionális munkahelyteremtés", "Gazdasági motor"],
      ro: ["Centru tehnologic", "Multe companii multinaționale", "Locuri de muncă regionale", "Motor economic"],
      en: ["Tech and electronics hub", "Hosting multinational firms", "Regional job creator", "Economic engine"]
    },
    factsAdvanced: {
      de: [],
      hu: ["A parkot az 1980-as évek közepén hozták létre az iparosítás ösztönzésére.", "Több mint 50 nemzetközi vállalat üzemeltet itt gyártóüzemet.", "Közvetlen vasúti összeköttetése van a Központi-völgy más városaival.", "Az itt dolgozók száma meghaladja a 15 000 főt.", "A park nagy hangsúlyt fektet a fenntartható és zöld ipari megoldásokra."],
      ro: ["Parcul a fost creat la mijlocul anilor 1980 pentru a stimula industrializarea.", "Peste 50 de companii internaționale operează unități de producție aici.", "Are conexiune feroviară directă cu alte orașe din Valea Centrală.", "Numărul angajaților de aici depășește 15.000 de persoane.", "Parcul pune un mare accent pe soluții industriale durabile și verzi."],
