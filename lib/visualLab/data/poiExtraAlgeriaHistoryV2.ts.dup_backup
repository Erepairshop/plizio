    facts: {
      de: ["Gegründet 100 n. Chr.", "UNESCO-Weltkulturerbe seit 1982."],
      hu: ["Krisztus után 100-ban alapították.", "1982 óta UNESCO világörökség."],
      ro: ["Fondat în anul 100 d.Hr.", "Patrimoniul Mondial UNESCO din 1982."],
