  {
    id: "sancti-spiritus-cities-v2",
    type: "state-capital",
    parent: "CU-07",
    coords: [-79.443, 21.932],
    name: { de: "Sancti Spíritus", hu: "Sancti Spíritus", ro: "Sancti Spíritus", en: "Sancti Spíritus" },
    description: {
      de: "Hauptstadt der gleichnamigen Provinz und eine der ursprünglich sieben von den Spaniern gegründeten Städte.",
      hu: "Az azonos nevű tartomány fővárosa, egyike a spanyolok által alapított eredeti hét városnak.",
      ro: "Capitala provinciei cu același nume și unul dintre cele șapte orașe fondate inițial de spanioli.",
      en: "The capital of the province of the same name and one of the original seven cities founded by the Spanish."
    ,
    descriptionAdvanced: {
      de: "Sancti Spíritus ist eine der sieben ursprünglichen Städte Kubas, die von den Spaniern gegründet wurden, und besticht durch ihr klassisches koloniales Flair. Das Stadtbild ist geprägt von engen, gepflasterten Gassen und der ikonischen Yayabo-Brücke, einem nationalen Denkmal. Als Provinzhauptstadt ist sie das kulturelle und administrative Herz der Region. Geschichte K6 — Die Gründung der ersten kubanischen Städte.",
      hu: "Sancti Spíritus egyike Kuba eredeti hét, spanyolok által alapított városának, és klasszikus gyarmati bájával tűnik ki. A városképet szűk, macskaköves utcák és az ikonikus Yayabo-híd jellemzi, amely nemzeti műemlék. Tartományi fővárosként a régió kulturális és közigazgatási szíve. Történelem K6 — Az első kubai városok alapítása.",
      ro: "Sancti Spíritus este capitala provinciei cu același nume și unul dintre cele șapte orașe originale fondate de spanioli în Cuba. Orașul păstrează un farmec colonial pronunțat, cu străzi pietruite și clădiri istorice ce datează de secole, fiind o fereastră către trecutul profund al insulei. Istorie K6 — Fondarea orașelor cubaneze și viață colonială.",
      en: "Sancti Spíritus is one of the first seven villas founded by Spanish colonizers in Cuba. The city is renowned for its colonial architecture, particularly the Yayabo Bridge, an iconic stone arch bridge built during the colonial period. It remains a center for traditional music, arts, and history in central Cuba. History K8 — Colonial history and urban architectural heritage."
    },
    factsAdvanced: {
      en: ["Founded as one of Cuba's first seven villas", "Home to the historic Yayabo Bridge", "Renowned for colonial architecture", "Center for arts and Cuban history", "Iconic stone arch design", "Important central Cuban landmark"]
    },
    factsAdvanced: {
      ro: ["Capitala provinciei Sancti Spíritus", "Unul dintre orașele originale ale Cubei", "Străzi pietruite și arhitectură colonială", "Fondat în perioada timpurie a colonizării", "Farmec istoric pronunțat"]
    },
    factsAdvanced: {
      hu: ["Az egyik eredeti hét spanyol város közül", "Ikonikus Yayabo-híd (nemzeti műemlék)", "Történelmi gyarmati városkép", "Sancti Spíritus tartomány fővárosa", "A régió kulturális központja", "Fontos helyszín a gyarmati történelem számára"]
    },
    factsAdvanced: {
      de: ["Eine der sieben ursprünglichen spanischen Städte", "Ikonische Yayabo-Brücke (Nationaldenkmal)", "Historisches koloniales Stadtbild", "Hauptstadt der Provinz Sancti Spíritus", "Kulturelles Zentrum der Region", "Wichtiger Ort für koloniale Geschichte"]
    }
  },
    facts: {
      de: ["Yayabo-Brücke, ein Nationaldenkmal", "Gut erhaltenes historisches Zentrum", "Gegründet 1514"],
      hu: ["Yayabo-híd, nemzeti műemlék", "Jól megőrzött történelmi központ", "1514-ben alapították"],
      ro: ["Podul Yayabo, un monument național", "Centru istoric bine conservat", "Fondat în 1514"],
      en: ["Yayabo Bridge, a National Monument", "Well-preserved historic center", "Founded in 1514"]
    },
    descriptionAdvanced: {
      de: "Hauptstadt der gleichnamigen Provinz und eine der ursprünglich sieben von den Spaniern gegründeten Städte. Yayabo-Brücke, ein Nationaldenkmal. Gut erhaltenes historisches Zentrum. Gegründet 1514. Damit zählt der Ort zu den charakteristischen Punkten der karibischen Inselrepublik Kuba und spiegelt die Verbindung von Geschichte, Tabak- und Zuckerrohranbau sowie tropischer Natur wider. Liegt im karibischen Inselstaat Kuba. Tropisch-feuchtes Klima mit ausgeprägter Regen- und Trockenzeit. Hauptstadt Havanna ist das politische und kulturelle Zentrum des Landes. Region ist eng mit dem Anbau von Tabak, Zuckerrohr und Kaffee verbunden.",
      hu: "Az azonos nevű tartomány fővárosa, egyike a spanyolok által alapított eredeti hét városnak. Yayabo-híd, nemzeti műemlék. Jól megőrzött történelmi központ. 1514-ben alapították. Ezzel a hely Kuba, a karibi szigetállam egyik jellegzetes pontja, amely a történelem, a dohány- és cukornádtermesztés, valamint a trópusi természet összefonódását tükrözi. A karibi térség legnagyobb szigetországában, Kubában fekszik. Trópusi-nedves éghajlat jellemzi, kifejezett esős és száraz évszakkal. Az ország politikai és kulturális központja a főváros, Havanna. A régió szorosan kötődik a dohány-, cukornád- és kávétermesztéshez.",
      ro: "Capitala provinciei cu același nume și unul dintre cele șapte orașe fondate inițial de spanioli. Podul Yayabo, un monument național. Centru istoric bine conservat. Fondat în 1514. Astfel, locul se numără printre punctele caracteristice ale Cubei, statul insular caraibian, reflectând împletirea dintre istorie, cultivarea tutunului și a trestiei de zahăr și natura tropicală. Este situat în Cuba, cel mai mare stat insular din Caraibe. Climat tropical-umed, cu sezon ploios și sezon secetos bine conturate. Capitala Havana este centrul politic și cultural al țării.",
      en: "The capital of the province of the same name and one of the original seven cities founded by the Spanish. Yayabo Bridge, a National Monument. Well-preserved historic center. Founded in 1514. Thus, the site is among the characteristic points of Cuba, the Caribbean island nation, reflecting the interplay of history, tobacco and sugarcane cultivation, and tropical nature. Located in Cuba, the largest island state in the Caribbean. Tropical-humid climate with distinct wet and dry seasons. Havana, the capital, is the country's political and cultural hub."
    },
    factsAdvanced: {
      de: ["Yayabo-Brücke, ein Nationaldenkmal", "Gut erhaltenes historisches Zentrum", "Gegründet 1514", "Hauptstadt der gleichnamigen Provinz und eine der ursprünglich sieben von den Spaniern gegründeten Städte.", "Liegt im karibischen Inselstaat Kuba.", "Tropisch-feuchtes Klima mit ausgeprägter Regen- und Trockenzeit.", "Hauptstadt Havanna ist das politische und kulturelle Zentrum des Landes.", "Region ist eng mit dem Anbau von Tabak, Zuckerrohr und Kaffee verbunden."],
      hu: ["Yayabo-híd, nemzeti műemlék", "Jól megőrzött történelmi központ", "1514-ben alapították", "Az azonos nevű tartomány fővárosa, egyike a spanyolok által alapított eredeti hét városnak.", "A karibi térség legnagyobb szigetországában, Kubában fekszik.", "Trópusi-nedves éghajlat jellemzi, kifejezett esős és száraz évszakkal.", "Az ország politikai és kulturális központja a főváros, Havanna.", "A régió szorosan kötődik a dohány-, cukornád- és kávétermesztéshez."],
      ro: ["Podul Yayabo, un monument național", "Centru istoric bine conservat", "Fondat în 1514", "Capitala provinciei cu același nume și unul dintre cele șapte orașe fondate inițial de spanioli.", "Este situat în Cuba, cel mai mare stat insular din Caraibe.", "Climat tropical-umed, cu sezon ploios și sezon secetos bine conturate.", "Capitala Havana este centrul politic și cultural al țării.", "Regiunea este strâns legată de cultura tutunului, a trestiei de zahăr și a cafelei."],
      en: ["Yayabo Bridge, a National Monument", "Well-preserved historic center", "Founded in 1514", "The capital of the province of the same name and one of the original seven cities founded by the Spanish.", "Located in Cuba, the largest island state in the Caribbean.", "Tropical-humid climate with distinct wet and dry seasons.", "Havana, the capital, is the country's political and cultural hub.", "The region is closely tied to tobacco, sugarcane and coffee cultivation."]
    }
