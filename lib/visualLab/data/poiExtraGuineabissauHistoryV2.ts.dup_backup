      hu: [
        "A gyarmat egykori hatalmi központja.",
        "A neoklasszicista romok nagyszerű példája.",
        "Bolama hanyatlásának jelképe."
      ],
      ro: [
        "Fostul centru de putere al coloniei.",
        "Exemplu grandios de ruine neoclasice.",
        "Simbol al declinului orașului Bolama."
      ],
      en: [
        "Former power center of the colony.",
        "Grand example of neoclassical ruins.",
        "Symbol of the decline of Bolama."
      ]
    }, image: "/poi-images/bolama-governor-palace-history-v2.webp"},
  {
