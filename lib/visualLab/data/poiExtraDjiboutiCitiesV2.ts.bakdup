  {
    id: "kouta-bouyya-cities-v2",
    type: "city",
    parent: "DJ-TA",
    coords: [42.455, 11.825],
    name: {
      de: "Kouta Bouyya",
      hu: "Kouta Bouyya",
      ro: "Kouta Bouyya",
      en: "Kouta Bouyya"
    ,
    descriptionAdvanced: {
      de: "Kouta Bouyya ist ein Gebirgsort im Zentrum der Region Tadjourah, der von spektakulären und schroffen vulkanischen Bergketten umgeben ist. Die Stadt dient als wichtiger regionaler Handelsplatz, insbesondere für den Austausch von Vieh zwischen den Berggemeinschaften und den Händlern aus der Küstenebene. Von den Höhenlagen aus bietet sich ein beeindruckender Panoramablick auf die umliegenden Ebenen und Täler. Kouta Bouyya liegt an alten Karawanenwegen, die historisch das Landesinnere mit dem Golf von Tadjoura verbanden, und bewahrt so seine Rolle als wichtiges Bindeglied im Norden. Geografie K7 — Gebirgshandel und Karawanenrouten."
    },
    factsAdvanced: {
      de: ["Hochgelegene Siedlung inmitten vulkanischer Bergketten.", "Zentraler Handelsplatz für Vieh in der Region Tadjourah.", "Bietet weite Panoramablicke über die dschibutische Landschaft.", "Liegt an historisch bedeutsamen Karawanenpfaden.", "Wichtiger Treffpunkt für nomadische Afar-Gemeinschaften.", "Strategischer Standort für die Überwachung der Bergrouten."]
    }
  },
    description: {
      de: "Ein Bergort im Zentrum von Tadjourah, umgeben von spektakulären vulkanischen Bergketten.",
      hu: "Hegyi település Tadjoura központjában, látványos vulkáni hegyláncok veszik körül.",
      ro: "O localitate montană în centrul Tadjourah, înconjurată de lanțuri muntoase vulcanice spectaculoase.",
      en: "A mountain settlement in central Tadjourah, surrounded by spectacular volcanic mountain ranges."
    },
