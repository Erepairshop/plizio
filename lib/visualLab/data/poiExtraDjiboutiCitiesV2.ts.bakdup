  {
    id: "sagallou-cities-v2",
    type: "city",
    parent: "DJ-TA",
    coords: [42.725, 11.685],
    name: {
      de: "Sagallou",
      hu: "Sagallou",
      ro: "Sagallou",
      en: "Sagallou"
    ,
    descriptionAdvanced: {
      de: "Sagallou ist ein geschichtsträchtiges Küstendorf am Golf von Tadjoura, das im späten 19. Jahrhundert kurzzeitig internationale Aufmerksamkeit erregte. Im Jahr 1889 war es Schauplatz des sogenannten 'Sagallo-Vorfalls', einer gescheiterten russischen Kolonialmission unter Nikolai Aschinow. Heute sind die Ruinen einer alten ägyptischen Festung stille Zeugen dieser bewegten Vergangenheit. Das Dorf ist heute ein friedlicher Ort, der durch seine historische Bedeutung und den weiten Blick über den Ozean besticht. Es bietet einen faszinierenden Einblick in die geopolitischen Ambitionen der Kolonialmächte am Horn von Afrika. Geschichte K8 — Koloniale Rivalitäten und lokale Stützpunkte."
    },
    factsAdvanced: {
      de: ["Schauplatz einer versuchten russischen Kolonialgründung 1889.", "Beheimatet Ruinen einer Festung aus der Zeit des Khedivats Ägypten.", "Strategisch gelegen am nördlichen Ufer des Golfs von Tadjoura.", "Historisch bedeutsam für die Erforschung kolonialer Expansion.", "Ruhiges Fischerdorf mit tief verwurzelten Traditionen.", "Bietet archäologische Spuren aus verschiedenen Epochen."]
    }
  },
    description: {
      de: "Ein geschichtsträchtiges Küstendorf, das kurzzeitig Schauplatz einer russischen Kolonialmission war.",
      hu: "Történelmi tengerparti falu, amely rövid ideig egy orosz gyarmati misszió helyszíne volt.",
      ro: "Un sat de coastă încărcat de istorie, care a fost pentru scurt timp scena unei misiuni coloniale rusești.",
      en: "A historic coastal village that was briefly the site of a Russian colonial mission."
    },
    facts: {
      de: ["Schauplatz des 'Sagallo-Vorfalls' von 1889", "Ruinen einer alten Festung", "Ruhiges Dorf mit Blick auf den Ozean"],
      hu: ["Az 1889-es 'Sagallo-incidens' helyszíne", "Egy régi erőd romjai", "Csendes falu óceáni kilátással"],
      ro: ["Scena 'incidentului Sagallo' din 1889", "Ruinele unei vechi fortărețe", "Sat liniștit cu vedere la ocean"],
      en: ["Site of the 1889 'Sagallo incident'", "Ruins of an old fortress", "Quiet village with ocean views"]
    }
  },
  {
    id: "as-eyla-cities-v2",
    type: "city",
    parent: "DJ-DI",
    coords: [42.125, 11.005],
    name: {
      de: "As Eyla",
