  {
    id: "bondara-cities-v2",
    type: "city",
    parent: "DJ-DI",
    coords: [42.155, 11.235],
    name: {
      de: "Bondara",
      hu: "Bondara",
      ro: "Bondara",
      en: "Bondara"
    ,
    descriptionAdvanced: {
      de: "Bondara ist eine ländliche Gemeinde im Westen Dschibutis, die tief in der traditionellen Lebensweise der Afar-Bevölkerung verwurzelt ist. Abgelegen von den Hauptverkehrswegen, zeichnet sich Bondara durch weite, unberührte Landschaften aus, die ideal für die großflächige Kamelzucht geeignet sind. Die sozialen Strukturen werden hier noch stark von traditionellen Stammesrechten und Bräuchen bestimmt. Bondara bietet einen authentischen Einblick in das Leben abseits der modernen urbanen Zentren und zeigt die tiefe Verbundenheit der Menschen mit ihrem Land. Sozialkunde K7 — Traditionelle Kulturen und Lebensweisen."
    },
