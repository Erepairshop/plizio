  {
    id: "hanle-cities-v2",
    type: "city",
    parent: "DJ-DI",
    coords: [42.055, 11.625],
    name: {
      de: "Hanle",
      hu: "Hanle",
      ro: "Hanle",
      en: "Hanle"
    ,
    descriptionAdvanced: {
      de: "Hanle ist ein zentraler Ort inmitten der weiten Hanle-Ebene, einer der wenigen Regionen Dschibutis, die aufgrund ihrer Bodenbeschaffenheit und Wasserverfügbarkeit Potenzial für die Landwirtschaft bieten. Hier werden verschiedene Forschungsprojekte zur Bewässerung durchgeführt, um die Ernährungssicherheit des Landes zu verbessern. Die Ebene ist zudem ein wichtiger Migrationsweg für Wildtiere, was Hanle zu einem ökologisch sensiblen Standort macht. Die dortigen agro-pastoralen Gemeinschaften verbinden traditionelle Viehzucht mit ersten Ansätzen des Ackerbaus, was Hanle zu einem Modellprojekt für die zukünftige Entwicklung des Landes macht. Biologie K7 — Landwirtschaftliche Entwicklung in Trockengebieten."
    },
    factsAdvanced: {
      de: ["Liegt in der fruchtbaren Hanle-Ebene im Zentrum Dschibutis.", "Standort für innovative Bewässerungs- und Agrarprojekte.", "Wichtiger Korridor für die Wanderungen lokaler Wildtiere.", "Zentrum für die Entwicklung sesshafter Landwirtschaft.", "Umgeben von Grasland, das ideal für die Viehzucht ist.", "Kombiniert traditionelle Pastoralwirtschaft mit modernem Ackerbau."]
    }
  },
