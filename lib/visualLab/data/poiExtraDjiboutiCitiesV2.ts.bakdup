  {
    id: "ribta-cities-v2",
    type: "city",
    parent: "DJ-TA",
    coords: [42.825, 11.725],
    name: {
      de: "Ribta",
      hu: "Ribta",
      ro: "Ribta",
      en: "Ribta"
    ,
    descriptionAdvanced: {
      de: "Ribta ist ein kleiner, beschaulicher Küstenort, der Besuchern eine ruhige und authentische Alternative zu den geschäftigen Hafenstädten Dschibutis bietet. Mit direktem Zugang zum glitzernden Wasser des Golfs von Tadjoura leben die Bewohner hier noch primär vom traditionellen Fischfang. Da der Ort bisher kaum touristisch erschlossen ist, hat sich Ribta seinen ursprünglichen Charakter bewahrt. Die Kombination aus karger Küstenlandschaft und dem tiefblauen Meer macht Ribta zu einem Ort der Stille, der die tiefe Verbundenheit der dschibutischen Küstenbewohner mit ihrer maritimen Umwelt widerspiegelt. Sachkunde K4 — Leben am Meer."
    },
    factsAdvanced: {
      de: ["Ruhige Küstensiedlung am Golf von Tadjoura.", "Wirtschaft basiert fast ausschließlich auf traditioneller Fischerei.", "Weitgehend unberührt vom modernen Massentourismus.", "Bietet direkten Zugang zu fischreichen Küstengewässern.", "Umgeben von einer typischen ariden Küstenlandschaft.", "Idealer Ort zur Beobachtung traditioneller Bootsbautechniken."]
    }
  },
    description: {
