  {
    id: "godoria-cities-v2",
    type: "city",
    parent: "DJ-OB",
    coords: [43.325, 12.155],
    name: {
      de: "Godoria",
      hu: "Godoria",
      ro: "Godoria",
      en: "Godoria"
    ,
    descriptionAdvanced: {
      de: "Godoria ist ein idyllisches Küstendorf nördlich von Obock, das vor allem für seine unberührte Natur und seine außergewöhnlichen Mangrovenwälder bekannt ist. Die umliegenden Gewässer beherbergen einige der am besten erhaltenen Korallenriffe Dschibutis, was Godoria zu einem Geheimtipp für Taucher und Schnorchler macht. Die lokale Bevölkerung lebt weitgehend vom traditionellen Fischfang und bewahrt eine enge Verbindung zum Meer. Das Dorf bietet eine ruhige Atmosphäre und ist ein wichtiger Forschungsort für marine Ökosysteme am Horn von Afrika. Biologie K8 — Marine Schutzgebiete und Korallenriffe."
    },
    factsAdvanced: {
      de: ["Bekannt für gut erhaltene Mangroven-Ökosysteme.", "Heimat prachtvoller und unberührter Korallenriffe.", "Wichtiger Ort für traditionelle Fischereimethoden.", "Geheimtipp für den ökologischen Tauchtourismus.", "Beheimatet eine reiche Vielfalt an mariner Flora und Fauna.", "Liegt abgeschieden an der nördlichen Küste der Region Obock."]
    }
  },
    description: {
