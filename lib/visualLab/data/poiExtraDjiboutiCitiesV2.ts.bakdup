  {
    id: "doumera-cities-v2",
    type: "city",
    parent: "DJ-OB",
    coords: [43.148, 12.712],
    name: {
      de: "Doumera",
      hu: "Doumera",
      ro: "Doumera",
      en: "Doumera"
    ,
    descriptionAdvanced: {
      de: "Doumera ist ein strategisch hochsensibler Grenzort am nördlichsten Punkt Dschibutis, direkt an der Küste des Roten Meeres gelegen. Der Ort markiert den Grenzpunkt zu Eritrea und bietet einen weiten Blick auf die Doumera-Insel, die in der Vergangenheit Gegenstand von Gebietsstreitigkeiten war. Aufgrund seiner Lage an der Straße von Bab al-Mandab ist Doumera von großer militärischer und geopolitischer Bedeutung für die Sicherheit des maritimen Verkehrs. Die Landschaft ist karg und von vulkanischem Gestein geprägt, was die strategische Isolation dieses Außenpostens unterstreicht. Geschichte K8 — Grenzkonflikte und Geopolitik."
    },
    factsAdvanced: {
      de: ["Nördlichster bewohnter Punkt der Republik Dschibuti.", "Direkter Grenzposten zum Nachbarstaat Eritrea.", "Strategisch wichtige Lage am Roten Meer.", "Blick auf die politisch umstrittene Doumera-Insel.", "Hohe militärische Präsenz zur Sicherung der Grenze.", "Karges, vulkanisches Gelände prägt die Umgebung."]
    }
  },
    description: {
