// @ts-nocheck
import type { POI } from "./poi";

export const poiExtraGuatemalaNatureV2: POI[] = [
  {
    id: "rio-usumacinta-guatemala-nature-v2",
    type: "river",
    parent: "GT-PE",
    coords: [-90.963, 17.801],
    name: { de: "Río Usumacinta", hu: "Usumacinta-folyó", ro: "Râul Usumacinta", en: "Usumacinta River" },
    description: { de: "Ein bedeutender Fluss, der die Grenze zwischen Guatemala und Mexiko bildet und für seine Maya-Stätten an den Ufern bekannt ist.", hu: "Jelentős folyó, amely Guatemala és Mexikó határát képezi, és a partjainál lévő maja lelőhelyekről ismert.", ro: "Un râu important care formează granița dintre Guatemala și Mexic, cunoscut pentru siturile mayașe de pe malurile sale.", en: "A major river forming the border between Guatemala and Mexico, known for Maya sites along its banks." },
    facts: {
      de: ["Bildet Grenze zu Mexiko", "Passiert Yaxchilán", "Wasserreichster Fluss Mittelamerikas", "Wichtig für Biodiversität"],
      hu: ["Határt képez Mexikóval", "Elhalad Yaxchilán mellett", "Közép-Amerika legbővizűbb folyója", "Fontos a biológiai sokféleség szempontjából"],
      ro: ["Formează granița cu Mexicul", "Trece pe lângă Yaxchilán", "Cel mai bogat râu în apă din America Centrală", "Important pentru biodiversitate"],
      en: ["Forms border with Mexico", "Passes the Yaxchilan site", "Largest river in Central America by volume", "Important for biodiversity"]
    },
    descriptionAdvanced: {
      hu: "A Río Usumacinta Mezoamerika legbővizűbb és leghatalmasabb folyója, amely a guatemalai magasföldeken ered, majd Guatemala (Petén megye) és Mexikó (Chiapas állam) természetes határvonalát alkotja hosszú szakaszokon keresztül, mielőtt a Mexikói-öbölbe ömlik. Ez a masszív, gyakran örvényekkel és zuhatagokkal teli folyó a klasszikus maja civilizáció fő kereskedelmi (jade, obszidián, kakaó) és kulturális 'autópályája' volt; partjait olyan lenyűgöző romvárosok szegélyezik, mint Yaxchilán és Piedras Negras. A folyó medencéje hatalmas trópusi dzsungeleket és mocsarakat (Lacanadon őserdő) táplál, és otthont ad az amerikai krokodilnak, a bőgőmajmoknak és több száz madárfajnak. Ugyanakkor a régió a drogcsempészet és az illegális határátlépések miatt ma is konfliktuszóna. Földrajz K8 — határfolyók és a maja folyami kereskedelem.",
      de: "Der mächtige Río Usumacinta ist der wasserreichste Fluss Zentralamerikas und bildet auf vielen Kilometern die natürliche Grenze zwischen Guatemala (Departamento Petén) und Mexiko (Chiapas). Entstanden aus dem Zusammenfluss von La Pasión und Salinas, fließt dieser breite, wilde Strom durch einen der undurchdringlichsten Dschungelabschnitte der Welt, bevor er in den Golf von Mexiko mündet. Für die klassischen Maya war der Usumacinta der absolute 'Highway' des Dschungels, was erklärt, warum mächtige Ruinenstädte wie Piedras Negras (Guatemala) und Yaxchilán (Mexiko) direkt an seinen hohen Ufern thronen. Die Navigation auf dem Usumacinta ist gefährlich, da gewaltige Stromschnellen, wie die berühmte 'Raudal de San José', den Flussverlauf unterbrechen. Heute ist die wilde, waldreiche Flussregion oft stark von Drogenschmuggel und illegaler Entwaldung geprägt. Geografie K8 — Grenzüberschreitende Flusssysteme."
    },
    factsAdvanced: {
      hu: ["A Usumacinta Mezoamerika legnagyobb vízhozamú folyója.", "Természetes és geopolitikai határt (frontera) képez Guatemala és Mexikó között.", "A klasszikus korban ez volt a legfontosabb maja kereskedelmi folyami útvonal.", "Partjain olyan jelentős régészeti lelőhelyek találhatók, mint Piedras Negras és Yaxchilán.", "A Pásión és a Salinas folyók összefolyásából (Altar de Sacrificiosnál) születik meg.", "Erőteljes sodrása és hírhedt zuhatagai (rauda) kedveltek a vadvízi evezősök (rafting) körében."],
      de: ["Der Usumacinta ist der Fluss mit der größten Wassermenge in Mexiko und Zentralamerika.", "Er bildet auf einem langen, von tiefem Dschungel umgebenen Abschnitt die Grenze zu Mexiko.", "Die klassischen Maya nutzten den breiten Fluss als wichtigste logistische Handelsroute.", "Bedeutende archäologische Stätten wie Piedras Negras liegen direkt an den Ufern.", "Massive, oft lebensgefährliche Stromschnellen (Raudales) durchziehen den Flusslauf.", "Das Flusstal ist heute Schauplatz intensiver Landkonflikte und illegaler Abholzung."]
    },
    descriptionAdvanced: { de: "Der mächtige Río Usumacinta ist der wasserreichste Fluss Zentralamerikas und bildet auf vielen Kilometern die natürliche Grenze zwischen Guatemala (Departamento Petén) und Mexiko (Chiapas). Entstanden aus dem Zusammenfluss von La Pasión und Salinas, fließt dieser breite, wilde Strom durch einen der undurchdringlichsten Dschungelabschnitte der Welt, bevor er in den Golf von Mexiko mündet. Für die klassischen Maya war der Usumacinta der absolute 'Highway' des Dschungels, was erklärt, warum mächtige Ruinenstädte wie Piedras Negras (Guatemala) und Yaxchilán (Mexiko) direkt an seinen hohen Ufern thronen. Die Navigation auf dem Usumacinta ist gefährlich, da gewaltige Stromschnellen, wie die berühmte 'Raudal de San José', den Flussverlauf unterbrechen. Heute ist die wilde, waldreiche Flussregion oft stark von Drogenschmuggel und illegaler Entwaldung geprägt. Geografie K8 — Grenzüberschreitende Flusssysteme.", hu: "Usumacinta-folyó Guatemala egyik figyelemre méltó pontja, ahol a maja örökség, a vulkáni felföld és az ország sokszínű kultúrája kézzelfoghatóan találkozik. Jelentős folyó, amely Guatemala és Mexikó határát képezi, és a partjainál lévő maja lelőhelyekről ismert. Ugyanakkor Határt képez Mexikóval. Emellett Elhalad Yaxchilán mellett. A környéken Közép-Amerika legbővizűbb folyója. Jellemző továbbá Fontos a biológiai sokféleség szempontjából. Mindezekkel együtt Usumacinta-folyó jól illeszkedik Guatemala összképébe, és megmutatja, mennyire szorosan kapcsolódik egymáshoz a maja kultúra, a vulkanikus felföld, valamint a kávé, a cukornád és a banán termesztése.", ro: "Râul Usumacinta este un punct remarcabil al Guatemalei, unde moștenirea maya, peisajul vulcanic și diversitatea culturală a țării se întâlnesc într-un mod expresiv. Un râu important care formează granița dintre Guatemala și Mexic, cunoscut pentru siturile mayașe de pe malurile sale. În același timp Formează granița cu Mexicul. Pe lângă acestea Trece pe lângă Yaxchilán. În zonă Cel mai bogat râu în apă din America Centrală. De asemenea Important pentru biodiversitate. Astfel, Râul Usumacinta se încadrează firesc în imaginea de ansamblu a Guatemalei, arătând cât de strâns sunt legate cultura maya, peisajul vulcanic și cultivarea cafelei, a trestiei de zahăr și a bananelor.", en: "Usumacinta River is a notable location in Guatemala where the rich Maya heritage, the volcanic highland landscape and the country's cultural diversity come together in a striking way. A major river forming the border between Guatemala and Mexico, known for Maya sites along its banks. At the same time Forms border with Mexico. In addition Passes the Yaxchilan site. In the surrounding area Largest river in Central America by volume. Another characteristic feature Important for biodiversity. In this way, Usumacinta River fits naturally into the wider picture of Guatemala, showing how closely Maya culture, the volcanic highlands and the cultivation of coffee, sugar cane and bananas are intertwined." },
    factsAdvanced: { de: ["Der Usumacinta ist der Fluss mit der größten Wassermenge in Mexiko und Zentralamerika.", "Er bildet auf einem langen, von tiefem Dschungel umgebenen Abschnitt die Grenze zu Mexiko.", "Die klassischen Maya nutzten den breiten Fluss als wichtigste logistische Handelsroute.", "Bedeutende archäologische Stätten wie Piedras Negras liegen direkt an den Ufern.", "Massive, oft lebensgefährliche Stromschnellen (Raudales) durchziehen den Flusslauf.", "Das Flusstal ist heute Schauplatz intensiver Landkonflikte und illegaler Abholzung."], hu: ["Határt képez Mexikóval", "Elhalad Yaxchilán mellett", "Közép-Amerika legbővizűbb folyója", "Fontos a biológiai sokféleség szempontjából", "Guatemalában, a maja örökségéről ismert közép-amerikai országban található.", "Tükrözi a felföld, a Petén-medence és a Csendes-óceáni partvidék közötti régiójára jellemző sajátosságokat.", "Beleilleszkedik Guatemala vulkánjai, az Atitlán-tó és az olyan maja helyszínek, mint Tikal és Antigua alkotta kulturális mozaikba."], ro: ["Formează granița cu Mexicul", "Trece pe lângă Yaxchilán", "Cel mai bogat râu în apă din America Centrală", "Important pentru biodiversitate", "Se află în Guatemala, o țară central-americană cu o moștenire maya pronunțată.", "Reflectă trăsăturile tipice ale regiunii sale, situată între podișul înalt, bazinul Petén și coasta Pacificului.", "Se integrează în mozaicul guatemalez format din vulcani, lacuri precum Atitlán și situri maya precum Tikal și Antigua."], en: ["Forms border with Mexico", "Passes the Yaxchilan site", "Largest river in Central America by volume", "Important for biodiversity", "Located in Guatemala, a Central American country with a strong Maya heritage.", "Reflects features typical of its region between the highlands, the Petén lowlands and the Pacific coast.", "Set within Guatemala's mosaic of volcanoes, lakes such as Atitlán and Maya sites like Tikal and Antigua."] }, image: "/poi-images/rio-usumacinta-guatemala-nature-v2.webp"},
  {
    id: "lago-peten-itza-nature-v2",
    type: "lake",
    parent: "GT-PE",
    coords: [-89.833, 16.983],
    name: { de: "Petén-Itzá-See", hu: "Petén Itzá-tó", ro: "Lacul Petén Itzá", en: "Lake Petén Itzá" },
    description: { de: "Ein großer, tiefer See im Herzen des Petén-Beckens, auf einer Insel liegt die Stadt Flores.", hu: "Nagy, mély tó a Petén-medence szívében, egy szigetén található Flores városa.", ro: "Un lac mare și adânc în inima bazinului Petén, cu orașul Flores situat pe o insulă.", en: "A large, deep lake in the heart of the Petén Basin, with the city of Flores on an island." },
    facts: {
      de: ["Zweitgrößter See Guatemalas", "Inselstadt Flores", "Tiefe bis zu 160m", "Krokodile und reiche Vogelwelt"],
      hu: ["Guatemala második legnagyobb tava", "Flores szigetváros", "Mélysége akár 160m", "Krokodilok és gazdag madárvilág"],
      ro: ["Al doilea cel mai mare lac din Guatemala", "Orașul insular Flores", "Adâncime de până la 160m", "Crocodili și o avifaună bogată"],
      en: ["Second largest lake in Guatemala", "Island city of Flores", "Depth up to 160m", "Crocodiles and rich birdlife"]
    },
    descriptionAdvanced: {
      hu: "A Lago Petén Itzá a hatalmas északi dzsungel, Petén megye ékköve, és Guatemala második legnagyobb tava az Izabal-tó után. A karsztos mélyedésben kialakult tó kristálytiszta vize meleg, színárnyalatai a mélykékből a zöldbe hajlanak. Történelmileg a tó volt a menedéke az itza majáknak (akik a mexikói Yucatánból vándoroltak ide), és szigetén, Tayasalon (ma Flores szigete) építették fel utolsó, független királyságukat. A tó ökoszisztémája rendkívül gazdag: a környező esőerdőkben tapírok és jaguárok élnek, míg a víz a helyi krokodiloknak (lagartos) ad otthont. A tó északi partján található a Cerro Cahuí Biotóp, míg a déli, sekélyebb részek San Benito és Santa Elena nyüzsgő városainak kikötőjeként szolgálnak. Földrajz K7 — karszttavak és trópusi ökoszisztémák.",
      de: "Der Petén-Itzá-See im Norden Guatemalas ist das zweitgrößte Gewässer des Landes und das blaue Herz des riesigen, flachen Dschungel-Departamentos Petén. Im Gegensatz zu den tiefen Vulkanseen des Hochlands ist dieser See ein warmes, tropisches Gewässer, umgeben von dichtem Kalkstein-Regenwald. Der See ist biologisch extrem wertvoll und beheimatet eine Vielzahl bedrohter Tierarten, darunter Krokodile (Morelet-Krokodile), Flussschildkröten und unzählige tropische Wasservögel. Seine Ufer waren vor Jahrhunderten extrem dicht von den Maya besiedelt; die letzte Maya-Hauptstadt Tayasal befand sich auf einer Insel im See (dem heutigen Flores). Der nördliche Teil des Sees ist weitgehend unberührt und wurde zum Biosphärenreservat (Biotopo Cerro Cahuí) erklärt, wo man am Ufer Brüllaffen rufen hören kann, während das Wasser mystisch in der dichten Hitze liegt. Geografie K7 — Tropische Tieflandseen."
    },
    factsAdvanced: {
      hu: ["Guatemala második legnagyobb tava (99 négyzetkilométer), de az egyik legmélyebb is (kb. 160 méter).", "A tó vizéből emelkedik ki a híres Isla de Flores, az ősi Tayasal maja város helyszíne.", "A tó teljesen endoreikus (zárt) medence, vagyis nincs felszíni lefolyása az óceán felé.", "Vizében jellegzetes faj a Morelet-krokodil (Crocodylus moreletii) és a 'blanco' halfajta.", "Északi partján fekszik az érintetlen Cerro Cahuí trópusi rezervátum.", "A vízszint az elmúlt évtizedekben ciklikus ingadozásokat mutatott, hol kiszáradt, hol elöntötte a falvakat."],
      de: ["Der Petén-Itzá-See ist der zweitgrößte See Guatemalas und der größte See der Tieflandregion.", "Die berühmte Touristenstadt Flores liegt auf einer Insel im Süden des Sees.", "Der See beheimatet das seltene und stark bedrohte mittelamerikanische Krokodil (Morelet).", "Aufgrund der Karstlandschaft verliert der See Wasser oft durch unterirdische Höhlensysteme.", "Die archäologische Fundstelle von Tayasal beweist die historische Wichtigkeit der Wasserressource.", "Das Wasser im See kann sehr hohe, tropisch-warme Temperaturen erreichen."]
    },
    descriptionAdvanced: { de: "Der Petén-Itzá-See im Norden Guatemalas ist das zweitgrößte Gewässer des Landes und das blaue Herz des riesigen, flachen Dschungel-Departamentos Petén. Im Gegensatz zu den tiefen Vulkanseen des Hochlands ist dieser See ein warmes, tropisches Gewässer, umgeben von dichtem Kalkstein-Regenwald. Der See ist biologisch extrem wertvoll und beheimatet eine Vielzahl bedrohter Tierarten, darunter Krokodile (Morelet-Krokodile), Flussschildkröten und unzählige tropische Wasservögel. Seine Ufer waren vor Jahrhunderten extrem dicht von den Maya besiedelt; die letzte Maya-Hauptstadt Tayasal befand sich auf einer Insel im See (dem heutigen Flores). Der nördliche Teil des Sees ist weitgehend unberührt und wurde zum Biosphärenreservat (Biotopo Cerro Cahuí) erklärt, wo man am Ufer Brüllaffen rufen hören kann, während das Wasser mystisch in der dichten Hitze liegt. Geografie K7 — Tropische Tieflandseen.", hu: "Petén Itzá-tó Guatemala egyik figyelemre méltó pontja, ahol a maja örökség, a vulkáni felföld és az ország sokszínű kultúrája kézzelfoghatóan találkozik. Nagy, mély tó a Petén-medence szívében, egy szigetén található Flores városa. Ugyanakkor Guatemala második legnagyobb tava. Emellett Flores szigetváros. A környéken Mélysége akár 160m. Jellemző továbbá Krokodilok és gazdag madárvilág. Mindezekkel együtt Petén Itzá-tó jól illeszkedik Guatemala összképébe, és megmutatja, mennyire szorosan kapcsolódik egymáshoz a maja kultúra, a vulkanikus felföld, valamint a kávé, a cukornád és a banán termesztése.", ro: "Lacul Petén Itzá este un punct remarcabil al Guatemalei, unde moștenirea maya, peisajul vulcanic și diversitatea culturală a țării se întâlnesc într-un mod expresiv. Un lac mare și adânc în inima bazinului Petén, cu orașul Flores situat pe o insulă. În același timp Al doilea cel mai mare lac din Guatemala. Pe lângă acestea Orașul insular Flores. În zonă Adâncime de până la 160m. De asemenea Crocodili și o avifaună bogată. Astfel, Lacul Petén Itzá se încadrează firesc în imaginea de ansamblu a Guatemalei, arătând cât de strâns sunt legate cultura maya, peisajul vulcanic și cultivarea cafelei, a trestiei de zahăr și a bananelor.", en: "Lake Petén Itzá is a notable location in Guatemala where the rich Maya heritage, the volcanic highland landscape and the country's cultural diversity come together in a striking way. A large, deep lake in the heart of the Petén Basin, with the city of Flores on an island. At the same time Second largest lake in Guatemala. In addition Island city of Flores. In the surrounding area Depth up to 160m. Another characteristic feature Crocodiles and rich birdlife. In this way, Lake Petén Itzá fits naturally into the wider picture of Guatemala, showing how closely Maya culture, the volcanic highlands and the cultivation of coffee, sugar cane and bananas are intertwined." },
    factsAdvanced: { de: ["Der Petén-Itzá-See ist der zweitgrößte See Guatemalas und der größte See der Tieflandregion.", "Die berühmte Touristenstadt Flores liegt auf einer Insel im Süden des Sees.", "Der See beheimatet das seltene und stark bedrohte mittelamerikanische Krokodil (Morelet).", "Aufgrund der Karstlandschaft verliert der See Wasser oft durch unterirdische Höhlensysteme.", "Die archäologische Fundstelle von Tayasal beweist die historische Wichtigkeit der Wasserressource.", "Das Wasser im See kann sehr hohe, tropisch-warme Temperaturen erreichen."], hu: ["Guatemala második legnagyobb tava", "Flores szigetváros", "Mélysége akár 160m", "Krokodilok és gazdag madárvilág", "Guatemalában, a maja örökségéről ismert közép-amerikai országban található.", "Tükrözi a felföld, a Petén-medence és a Csendes-óceáni partvidék közötti régiójára jellemző sajátosságokat.", "Beleilleszkedik Guatemala vulkánjai, az Atitlán-tó és az olyan maja helyszínek, mint Tikal és Antigua alkotta kulturális mozaikba."], ro: ["Al doilea cel mai mare lac din Guatemala", "Orașul insular Flores", "Adâncime de până la 160m", "Crocodili și o avifaună bogată", "Se află în Guatemala, o țară central-americană cu o moștenire maya pronunțată.", "Reflectă trăsăturile tipice ale regiunii sale, situată între podișul înalt, bazinul Petén și coasta Pacificului.", "Se integrează în mozaicul guatemalez format din vulcani, lacuri precum Atitlán și situri maya precum Tikal și Antigua."], en: ["Second largest lake in Guatemala", "Island city of Flores", "Depth up to 160m", "Crocodiles and rich birdlife", "Located in Guatemala, a Central American country with a strong Maya heritage.", "Reflects features typical of its region between the highlands, the Petén lowlands and the Pacific coast.", "Set within Guatemala's mosaic of volcanoes, lakes such as Atitlán and Maya sites like Tikal and Antigua."] }, image: "/poi-images/lago-peten-itza-nature-v2.webp"},
  {
    id: "rio-dulce-guatemala-nature-v2",
    type: "river",
    parent: "GT-IZ",
    coords: [-88.833, 15.75],
    name: { de: "Río Dulce", hu: "Río Dulce", ro: "Río Dulce", en: "Río Dulce" },
    description: { de: "Ein Fluss, der den Izabal-See mit der Karibik verbindet, bekannt für seine beeindruckende Schlucht.", hu: "Az Izabal-tavat a Karib-tengerrel összekötő folyó, amely lenyűgöző szurdokáról ismert.", ro: "Un râu care leagă Lacul Izabal de Marea Caraibilor, cunoscut pentru canionul său impresionant.", en: "A river connecting Lake Izabal to the Caribbean, known for its impressive gorge." },
    facts: {
      de: ["Verbindet Izabalsee und Karibik", "Tiefe Schlucht (Cañón del Río Dulce)", "Manati-Schutzgebiet", "Beliebt bei Seglern"],
      hu: ["Összeköti az Izabal-tavat és a Karib-tengert", "Mély szurdok (Cañón del Río Dulce)", "Manátusz-védelmi terület", "Népszerű a vitorlázók körében"],
      ro: ["Leagă Lacul Izabal de Caraibe", "Canion adânc (Cañón del Río Dulce)", "Sanctuar pentru lamantini", "Popular printre navigatori"],
      en: ["Connects Lake Izabal and the Caribbean", "Deep gorge (Cañón del Río Dulce)", "Manatee sanctuary", "Popular with sailors"]
    },
    descriptionAdvanced: {
      hu: "A Río Dulce (Édes Folyó) egy viszonylag rövid (kb. 43 km), de földrajzilag és gazdaságilag kulcsfontosságú vízi útvonal, amely az Izabal-tó hatalmas víztömegét vezeti le a Karib-tengerbe (Amatique-öböl). A folyó az 'El Golfete' nevű tóvá szélesedik ki, mielőtt bevetné magát a híres Kanyonba (El Cañón del Río Dulce), ahol sűrű trópusi dzsungellel borított, függőleges, 100 méteres mészkőfalak között kanyarog. A folyó sötét, meleg vize az egyik utolsó közép-amerikai menedéke a kihalófélben lévő karibi manátusznak (tengeri tehén), amelyet a helyi Chocón Machacas biotóp próbál védeni. A folyót a spanyoloktól kezdve a kalózokig mindenki használta, ma pedig a jachtok (hurrikánmenedék) és az ökoturizmus paradicsoma, amit a garífuna és q'eqchi' kultúra övez. Földrajz K6 — karibi folyami torkolatok és mészkőkanyonok.",
      de: "Der Río Dulce ('Süßer Fluss') ist weitaus mehr als ein gewöhnlicher Fluss; er ist eine spektakuläre, tiefe Wasserstraße, die den Izabal-See mit dem Karibischen Meer verbindet. Der bekannteste Abschnitt des Flusses ist der 'Cañón del Río Dulce', wo das Wasser sanft durch eine enge, majestätische Schlucht fließt. An beiden Seiten ragen über hundert Meter hohe, senkrechte Kalksteinwände auf, die dicht mit üppigem, grünem Regenwald bewachsen sind und von denen Kaskaden ins Wasser stürzen. Die Fauna ist spektakulär: Brüllaffen schreien in den Wipfeln, Krokodile lauern an den Ufern, und in den ruhigen, warmen Buchten am Ende des Flusses nisten die seltenen Seekühe (Manatis). Der Fluss ist die einzige Lebensader für die isolierten Q'eqchi'-Dörfer, die hier auf Stelzen über dem Wasser (Palafitos) leben. Geografie K8 — Flusscanyons und Biodiversität."
    },
    factsAdvanced: {
      hu: ["Az Izabal-tavat (Guatemala legnagyobb tava) köti össze a Karib-tengerrel Livingstonnál.", "Alsó folyásán egy látványos, 100 méter mély mészkő kanyonon halad keresztül.", "A 'hurricane hole' (hurrikánmenedék) a Karib-tengeri jachtosok egyik legfontosabb kikötője.", "Otthont ad a ritka és szigorúan védett karibi manátuszoknak (tengeri teheneknek).", "A spanyol gyarmati időkben a Castillo de San Felipe erőd védte a kalózok betöréseitől.", "A folyó feletti hatalmas híd (Puente Río Dulce) az egyik legfontosabb összeköttetés a Petén régió felé."],
      de: ["Der Río Dulce verbindet als einzige natürliche Wasserstraße den Izabal-See mit der Karibik.", "Der berühmteste Abschnitt ist ein massiver, von Lianen bewachsener Kalkstein-Canyon.", "Der Fluss bietet Lebensraum für Manatis (Seekühe), Tapire und Brüllaffen.", "Am Ufer gibt es kleine geothermische Quellen, die warmes Wasser in den Fluss speisen.", "Die Gemeinden am Río Dulce bestehen oft aus Holzhäusern, die auf Stelzen über dem Wasser stehen.", "Die Mündung des Flusses in die Karibik liegt in der Garífuna-Stadt Livingston."]
    },
    descriptionAdvanced: { de: "Der Río Dulce ('Süßer Fluss') ist weitaus mehr als ein gewöhnlicher Fluss; er ist eine spektakuläre, tiefe Wasserstraße, die den Izabal-See mit dem Karibischen Meer verbindet. Der bekannteste Abschnitt des Flusses ist der 'Cañón del Río Dulce', wo das Wasser sanft durch eine enge, majestätische Schlucht fließt. An beiden Seiten ragen über hundert Meter hohe, senkrechte Kalksteinwände auf, die dicht mit üppigem, grünem Regenwald bewachsen sind und von denen Kaskaden ins Wasser stürzen. Die Fauna ist spektakulär: Brüllaffen schreien in den Wipfeln, Krokodile lauern an den Ufern, und in den ruhigen, warmen Buchten am Ende des Flusses nisten die seltenen Seekühe (Manatis). Der Fluss ist die einzige Lebensader für die isolierten Q'eqchi'-Dörfer, die hier auf Stelzen über dem Wasser (Palafitos) leben. Geografie K8 — Flusscanyons und Biodiversität.", hu: "Río Dulce Guatemala egyik figyelemre méltó pontja, ahol a maja örökség, a vulkáni felföld és az ország sokszínű kultúrája kézzelfoghatóan találkozik. Az Izabal-tavat a Karib-tengerrel összekötő folyó, amely lenyűgöző szurdokáról ismert. Ugyanakkor Összeköti az Izabal-tavat és a Karib-tengert. Emellett Mély szurdok (Cañón del Río Dulce). A környéken Manátusz-védelmi terület. Jellemző továbbá Népszerű a vitorlázók körében. Mindezekkel együtt Río Dulce jól illeszkedik Guatemala összképébe, és megmutatja, mennyire szorosan kapcsolódik egymáshoz a maja kultúra, a vulkanikus felföld, valamint a kávé, a cukornád és a banán termesztése.", ro: "Río Dulce este un punct remarcabil al Guatemalei, unde moștenirea maya, peisajul vulcanic și diversitatea culturală a țării se întâlnesc într-un mod expresiv. Un râu care leagă Lacul Izabal de Marea Caraibilor, cunoscut pentru canionul său impresionant. În același timp Leagă Lacul Izabal de Caraibe. Pe lângă acestea Canion adânc (Cañón del Río Dulce). În zonă Sanctuar pentru lamantini. De asemenea Popular printre navigatori. Astfel, Río Dulce se încadrează firesc în imaginea de ansamblu a Guatemalei, arătând cât de strâns sunt legate cultura maya, peisajul vulcanic și cultivarea cafelei, a trestiei de zahăr și a bananelor.", en: "Río Dulce is a notable location in Guatemala where the rich Maya heritage, the volcanic highland landscape and the country's cultural diversity come together in a striking way. A river connecting Lake Izabal to the Caribbean, known for its impressive gorge. At the same time Connects Lake Izabal and the Caribbean. In addition Deep gorge (Cañón del Río Dulce). In the surrounding area Manatee sanctuary. Another characteristic feature Popular with sailors. In this way, Río Dulce fits naturally into the wider picture of Guatemala, showing how closely Maya culture, the volcanic highlands and the cultivation of coffee, sugar cane and bananas are intertwined." },
    factsAdvanced: { de: ["Der Río Dulce verbindet als einzige natürliche Wasserstraße den Izabal-See mit der Karibik.", "Der berühmteste Abschnitt ist ein massiver, von Lianen bewachsener Kalkstein-Canyon.", "Der Fluss bietet Lebensraum für Manatis (Seekühe), Tapire und Brüllaffen.", "Am Ufer gibt es kleine geothermische Quellen, die warmes Wasser in den Fluss speisen.", "Die Gemeinden am Río Dulce bestehen oft aus Holzhäusern, die auf Stelzen über dem Wasser stehen.", "Die Mündung des Flusses in die Karibik liegt in der Garífuna-Stadt Livingston."], hu: ["Összeköti az Izabal-tavat és a Karib-tengert", "Mély szurdok (Cañón del Río Dulce)", "Manátusz-védelmi terület", "Népszerű a vitorlázók körében", "Guatemalában, a maja örökségéről ismert közép-amerikai országban található.", "Tükrözi a felföld, a Petén-medence és a Csendes-óceáni partvidék közötti régiójára jellemző sajátosságokat.", "Beleilleszkedik Guatemala vulkánjai, az Atitlán-tó és az olyan maja helyszínek, mint Tikal és Antigua alkotta kulturális mozaikba."], ro: ["Leagă Lacul Izabal de Caraibe", "Canion adânc (Cañón del Río Dulce)", "Sanctuar pentru lamantini", "Popular printre navigatori", "Se află în Guatemala, o țară central-americană cu o moștenire maya pronunțată.", "Reflectă trăsăturile tipice ale regiunii sale, situată între podișul înalt, bazinul Petén și coasta Pacificului.", "Se integrează în mozaicul guatemalez format din vulcani, lacuri precum Atitlán și situri maya precum Tikal și Antigua."], en: ["Connects Lake Izabal and the Caribbean", "Deep gorge (Cañón del Río Dulce)", "Manatee sanctuary", "Popular with sailors", "Located in Guatemala, a Central American country with a strong Maya heritage.", "Reflects features typical of its region between the highlands, the Petén lowlands and the Pacific coast.", "Set within Guatemala's mosaic of volcanoes, lakes such as Atitlán and Maya sites like Tikal and Antigua."] }, image: "/poi-images/rio-dulce-guatemala-nature-v2.webp"},
  {
    id: "volcan-de-agua-nature-v2",
    type: "mountain",
    parent: "GT-SA",
    coords: [-90.743, 14.465],
    name: { de: "Volcán de Agua", hu: "Agua-vulkán", ro: "Vulcanul de Apă", en: "Volcán de Agua" },
    description: { de: "Ein markanter, symmetrischer Vulkan, der die Landschaft bei Antigua Guatemala dominiert.", hu: "Jellegzetes, szimmetrikus vulkán, amely Antigua Guatemala tájképét uralja.", ro: "Un vulcan proeminent și simetric care domină peisajul de lângă Antigua Guatemala.", en: "A prominent, symmetrical volcano that dominates the landscape near Antigua Guatemala." },
    facts: {
      de: ["Höhe: 3760 m", "Perfekt konische Form", "Dominante Erscheinung bei Antigua", "Letzter Ausbruch unbekannt"],
      hu: ["Magasság: 3760 m", "Tökéletesen kúpos alak", "Antigua fölé magasodik", "Utolsó kitörése ismeretlen"],
      ro: ["Înălțime: 3760 m", "Formă perfect conică", "Prezență dominantă lângă Antigua", "Ultima erupție necunoscută"],
      en: ["Elevation: 3760 m", "Perfectly conical shape", "Dominates the Antigua view", "Last eruption unknown"]
    },
    descriptionAdvanced: {
      hu: "A Volcán de Agua (Víz Vulkán) egy lenyűgöző, tökéletesen kúp alakú (stratovulkán) hegycsúcs, amely fenségesen magasodik Antigua Guatemala történelmi városa fölé (3 760 méter). A maják Hunapú néven ('a virágok helye') tisztelték. Neve (Víz Vulkán) egy tragikus történelmi eseményből fakad: 1541. szeptember 11-én egy hatalmas iszap- és kőlavina (lahar), amelyet valószínűleg egy felgyülemlett krátertó átszakadása okozott, lezúdult a hegyoldalon, és teljesen elpusztította a spanyolok második fővárosát, Ciudad Vieját (Almolonga völgye). Ez a katasztrófa ölte meg Beatriz de la Cueva kormányzónőt is, és kényszerítette a túlélőket a mai Antigua megalapítására. Ma a vulkán inaktív, lejtőit kávéültetvények, feljebb pedig ködös felhőerdők borítják. Földrajz K8 — inaktív stratovulkánok és lahar (iszapár) katasztrófák.",
      de: "Der Volcán de Agua, ein perfekter, gigantischer Stratovulkan, dominiert die Landschaft südlich von Antigua Guatemala. Obwohl er in historischer Zeit nicht eruptiv aktiv war, ging von ihm 1541 eine massive Zerstörung aus: Ein gewaltiger Erdrutsch (Lahar) aus Schlamm und Wasser, das sich im Krater gesammelt hatte, raste die Hänge hinab und zerstörte die damalige Hauptstadt Ciudad Vieja, wobei auch die erste Gouverneurin Amerikas, Beatriz de la Cueva, getötet wurde. Dieser Katastrophe verdankt der Vulkan seinen Namen 'Wasser-Vulkan'. Die Hänge des Vulkans sind heute extrem fruchtbar und werden bis in schwindelerregende Höhen intensiv für den Anbau von exzellentem Antigua-Kaffee und Gemüse genutzt. Ein Aufstieg auf den 3.760 Meter hohen Gipfel bietet an klaren Tagen einen unvergleichlichen Blick bis zur Pazifikküste und zu den benachbarten, rauchenden Vulkanen Fuego und Acatenango. Geografie K7 — Stratovulkane und Lahare."
    },
    factsAdvanced: {
      hu: ["Magassága 3 760 méter, szimmetrikus kúpja Antigua Guatemala ikonikus háttere.", "Az inaktív vulkánt a kaqchikel maják 'Hunapú'-nak hívták.", "1541-ben a kráterből kiömlő hatalmas víz- és sárlavina (lahar) elpusztította az akkori fővárost, Ciudad Vieját.", "Errol a vízi katasztrófáról (és nem lávakitörésrol) kapta a spanyol 'Víz Vulkán' nevet.", "A hegy alsóbb lejtőit az ország legjobb minőségű kávéültetvényei (pl. Finca Filadelfia) borítják.", "Meredek, erdős csúcsa népszerű a hegymászók körében, bár gyakran sűrű köd takarja be."],
      de: ["Der Vulkan verdankt seinen Namen einem massiven Schlamm- und Wasser-Erdrutsch (Lahar) im Jahr 1541.", "Der Volcán de Agua ist ein ruhender Stratovulkan mit einer Höhe von 3.760 Metern.", "Die Zerstörung von Ciudad Vieja durch diesen Lahar zwang die Spanier zur Gründung von Antigua.", "Die unteren Hänge des Vulkans sind eines der wertvollsten Kaffeeanbaugebiete der Welt.", "Im Krater (Crater) des Vulkans befindet sich ein kleiner, windgeschützter Fußballplatz.", "Der indigene Name des Vulkans in der Kaqchikel-Sprache lautet Hunapú."]
    },
    descriptionAdvanced: { de: "Der Volcán de Agua, ein perfekter, gigantischer Stratovulkan, dominiert die Landschaft südlich von Antigua Guatemala. Obwohl er in historischer Zeit nicht eruptiv aktiv war, ging von ihm 1541 eine massive Zerstörung aus: Ein gewaltiger Erdrutsch (Lahar) aus Schlamm und Wasser, das sich im Krater gesammelt hatte, raste die Hänge hinab und zerstörte die damalige Hauptstadt Ciudad Vieja, wobei auch die erste Gouverneurin Amerikas, Beatriz de la Cueva, getötet wurde. Dieser Katastrophe verdankt der Vulkan seinen Namen 'Wasser-Vulkan'. Die Hänge des Vulkans sind heute extrem fruchtbar und werden bis in schwindelerregende Höhen intensiv für den Anbau von exzellentem Antigua-Kaffee und Gemüse genutzt. Ein Aufstieg auf den 3.760 Meter hohen Gipfel bietet an klaren Tagen einen unvergleichlichen Blick bis zur Pazifikküste und zu den benachbarten, rauchenden Vulkanen Fuego und Acatenango. Geografie K7 — Stratovulkane und Lahare.", hu: "Agua-vulkán Guatemala egyik figyelemre méltó pontja, ahol a maja örökség, a vulkáni felföld és az ország sokszínű kultúrája kézzelfoghatóan találkozik. Jellegzetes, szimmetrikus vulkán, amely Antigua Guatemala tájképét uralja. Ugyanakkor Magasság: 3760 m. Emellett Tökéletesen kúpos alak. A környéken Antigua fölé magasodik. Jellemző továbbá Utolsó kitörése ismeretlen. Mindezekkel együtt Agua-vulkán jól illeszkedik Guatemala összképébe, és megmutatja, mennyire szorosan kapcsolódik egymáshoz a maja kultúra, a vulkanikus felföld, valamint a kávé, a cukornád és a banán termesztése.", ro: "Vulcanul de Apă este un punct remarcabil al Guatemalei, unde moștenirea maya, peisajul vulcanic și diversitatea culturală a țării se întâlnesc într-un mod expresiv. Un vulcan proeminent și simetric care domină peisajul de lângă Antigua Guatemala. În același timp Înălțime: 3760 m. Pe lângă acestea Formă perfect conică. În zonă Prezență dominantă lângă Antigua. De asemenea Ultima erupție necunoscută. Astfel, Vulcanul de Apă se încadrează firesc în imaginea de ansamblu a Guatemalei, arătând cât de strâns sunt legate cultura maya, peisajul vulcanic și cultivarea cafelei, a trestiei de zahăr și a bananelor.", en: "Volcán de Agua is a notable location in Guatemala where the rich Maya heritage, the volcanic highland landscape and the country's cultural diversity come together in a striking way. A prominent, symmetrical volcano that dominates the landscape near Antigua Guatemala. At the same time Elevation: 3760 m. In addition Perfectly conical shape. In the surrounding area Dominates the Antigua view. Another characteristic feature Last eruption unknown. In this way, Volcán de Agua fits naturally into the wider picture of Guatemala, showing how closely Maya culture, the volcanic highlands and the cultivation of coffee, sugar cane and bananas are intertwined." },
    factsAdvanced: { de: ["Der Vulkan verdankt seinen Namen einem massiven Schlamm- und Wasser-Erdrutsch (Lahar) im Jahr 1541.", "Der Volcán de Agua ist ein ruhender Stratovulkan mit einer Höhe von 3.760 Metern.", "Die Zerstörung von Ciudad Vieja durch diesen Lahar zwang die Spanier zur Gründung von Antigua.", "Die unteren Hänge des Vulkans sind eines der wertvollsten Kaffeeanbaugebiete der Welt.", "Im Krater (Crater) des Vulkans befindet sich ein kleiner, windgeschützter Fußballplatz.", "Der indigene Name des Vulkans in der Kaqchikel-Sprache lautet Hunapú."], hu: ["Magasság: 3760 m", "Tökéletesen kúpos alak", "Antigua fölé magasodik", "Utolsó kitörése ismeretlen", "Guatemalában, a maja örökségéről ismert közép-amerikai országban található.", "Tükrözi a felföld, a Petén-medence és a Csendes-óceáni partvidék közötti régiójára jellemző sajátosságokat.", "Beleilleszkedik Guatemala vulkánjai, az Atitlán-tó és az olyan maja helyszínek, mint Tikal és Antigua alkotta kulturális mozaikba."], ro: ["Înălțime: 3760 m", "Formă perfect conică", "Prezență dominantă lângă Antigua", "Ultima erupție necunoscută", "Se află în Guatemala, o țară central-americană cu o moștenire maya pronunțată.", "Reflectă trăsăturile tipice ale regiunii sale, situată între podișul înalt, bazinul Petén și coasta Pacificului.", "Se integrează în mozaicul guatemalez format din vulcani, lacuri precum Atitlán și situri maya precum Tikal și Antigua."], en: ["Elevation: 3760 m", "Perfectly conical shape", "Dominates the Antigua view", "Last eruption unknown", "Located in Guatemala, a Central American country with a strong Maya heritage.", "Reflects features typical of its region between the highlands, the Petén lowlands and the Pacific coast.", "Set within Guatemala's mosaic of volcanoes, lakes such as Atitlán and Maya sites like Tikal and Antigua."] }, image: "/poi-images/volcan-de-agua-nature-v2.webp"},
  {
    id: "rio-cahabon-nature-v2",
    type: "river",
    parent: "GT-AV",
    coords: [-89.816, 15.583],
    name: { de: "Río Cahabón", hu: "Cahabón-folyó", ro: "Râul Cahabón", en: "Cahabón River" },
    description: { de: "Ein Fluss in Alta Verapaz, berühmt für die Kaskaden von Semuc Champey und für Rafting.", hu: "Folyó Alta Verapazban, híres a Semuc Champey vízeséseiről és a vadvízi evezésről.", ro: "Un râu în Alta Verapaz, renumit pentru cascadele de la Semuc Champey și pentru rafting.", en: "A river in Alta Verapaz, famous for the cascades of Semuc Champey and for rafting." },
    facts: {
      de: ["Fließt unter Semuc Champey", "Beliebt für Wildwasser-Rafting", "Türkisfarbenes Wasser", "Entspringt in der Sierra de las Minas"],
      hu: ["A Semuc Champey alatt folyik", "Népszerű a vadvízi evezéshez", "Türkizkék víz", "A Sierra de las Minas-hegységben ered"],
      ro: ["Curge pe sub Semuc Champey", "Popular pentru rafting", "Apă de culoare turcoaz", "Izvorăște din Sierra de las Minas"],
      en: ["Flows under Semuc Champey", "Popular for white-water rafting", "Turquoise colored water", "Source in the Sierra de las Minas"]
    },
    descriptionAdvanced: {
      hu: "A Río Cahabón egy hatalmas sodrású, vad és tiszta vizű hegyi folyó, amely Alta Verapaz megye sűrű trópusi esőerdeit és karsztos (mészköves) hegyvonulatait szeli át. A folyó neve világszerte ismert a vadvízi evezősök (rafting) körében (főként III. és IV. osztályú zuhatagai miatt), és Guatemala ökoturizmusának egyik legfontosabb artériája. A Cahabón a leglátványosabb formáját a Semuc Champey-nél mutatja meg, ahol dühöngő víztömege egy 300 méteres természetes mészkőhíd alá bukik a föld alá, miközben a felszínen csendes türkizkék forrásmedencék alakultak ki. A folyó később beömlik a Polochic-folyóba, majd a Karib-tengerbe (Izabal-tó). Vize az utóbbi években éles társadalmi viták központjába is került a rajta épülő vízerőművek (hidroeléctricas) miatt, amelyek ellen a helyi q'eqchi' maja közösségek hevesen tiltakoznak. Földrajz K7 — karsztos búvópatakok és a vízenergia társadalmi hatásai.",
      de: "Der Río Cahabón ist das wilde, türkisfarbene Herzstück des Departamentos Alta Verapaz. Er entspringt im feuchten Bergnebelwald nahe Cobán und gräbt sich rasend schnell durch das steile Kalksteingebirge in Richtung des Izabal-Sees. Seine Stromschnellen, die in der Regenzeit (Klasse III und IV) extrem anspruchsvoll sind, machen ihn zum berühmtesten Ziel für Wildwasser-Rafting in ganz Zentralamerika. Geologisch gesehen ist der Fluss für ein Meisterwerk der Natur verantwortlich: Er formte das atemberaubende Naturdenkmal Semuc Champey, indem er sich unter einer massiven Kalksteinbrücke hindurchfräste, auf der sich ruhige Naturpools bilden. Leider steht der Flusslauf heute im Zentrum massiver politischer und ökologischer Konflikte, da in den letzten Jahren mehrere große Staudämme ('Renace') erbaut wurden, was zu Protesten der indigenen Q'eqchi'-Gemeinden führte, deren Wasserversorgung abgeschnitten wurde. Geografie K8 — Wasserkraft vs. Ökologie."
    },
    factsAdvanced: {
      hu: ["A vadvízi evezősök (rafting) körében Közép-Amerika egyik leghíresebb folyója.", "A Semuc Champey természeti csodájánál a folyó egy hatalmas mészkőhíd (barlang) alatt folyik át.", "A q'eqchi' maja falvak számára a mindennapi élet, halászat és tisztálkodás alapja.", "A medre mentén épülő modern vízerőművek súlyos ellenállást (és pereket) váltottak ki a helyiek részéről.", "Az esős évszakban vízhozama drasztikusan megnő, és színe csokoládébarnává válik az iszaptól.", "A folyó a Lanquín barlangrendszerhez is kapcsolódik Alta Verapaz karsztos hegyeiben."],
      de: ["Der Río Cahabón ist der wichtigste und wildeste Fluss der Verapaz-Region.", "Er durchfließt unterirdisch das berühmte Naturdenkmal Semuc Champey.", "Der Fluss bietet einige der besten und anspruchsvollsten Rafting-Routen in Mittelamerika.", "Ein massives Wasserkraftprojekt (Renace) leitet große Teile des Flusses in Rohre um.", "Der Konflikt um die Staudämme gipfelte in der umstrittenen Inhaftierung von Q'eqchi'-Führern.", "Die charakteristische türkise Farbe stammt aus den gelösten Kalkmineralien des Gebirges."]
    },
    descriptionAdvanced: { de: "Der Río Cahabón ist das wilde, türkisfarbene Herzstück des Departamentos Alta Verapaz. Er entspringt im feuchten Bergnebelwald nahe Cobán und gräbt sich rasend schnell durch das steile Kalksteingebirge in Richtung des Izabal-Sees. Seine Stromschnellen, die in der Regenzeit (Klasse III und IV) extrem anspruchsvoll sind, machen ihn zum berühmtesten Ziel für Wildwasser-Rafting in ganz Zentralamerika. Geologisch gesehen ist der Fluss für ein Meisterwerk der Natur verantwortlich: Er formte das atemberaubende Naturdenkmal Semuc Champey, indem er sich unter einer massiven Kalksteinbrücke hindurchfräste, auf der sich ruhige Naturpools bilden. Leider steht der Flusslauf heute im Zentrum massiver politischer und ökologischer Konflikte, da in den letzten Jahren mehrere große Staudämme ('Renace') erbaut wurden, was zu Protesten der indigenen Q'eqchi'-Gemeinden führte, deren Wasserversorgung abgeschnitten wurde. Geografie K8 — Wasserkraft vs. Ökologie.", hu: "Cahabón-folyó Guatemala egyik figyelemre méltó pontja, ahol a maja örökség, a vulkáni felföld és az ország sokszínű kultúrája kézzelfoghatóan találkozik. Folyó Alta Verapazban, híres a Semuc Champey vízeséseiről és a vadvízi evezésről. Ugyanakkor A Semuc Champey alatt folyik. Emellett Népszerű a vadvízi evezéshez. A környéken Türkizkék víz. Jellemző továbbá A Sierra de las Minas-hegységben ered. Mindezekkel együtt Cahabón-folyó jól illeszkedik Guatemala összképébe, és megmutatja, mennyire szorosan kapcsolódik egymáshoz a maja kultúra, a vulkanikus felföld, valamint a kávé, a cukornád és a banán termesztése.", ro: "Râul Cahabón este un punct remarcabil al Guatemalei, unde moștenirea maya, peisajul vulcanic și diversitatea culturală a țării se întâlnesc într-un mod expresiv. Un râu în Alta Verapaz, renumit pentru cascadele de la Semuc Champey și pentru rafting. În același timp Curge pe sub Semuc Champey. Pe lângă acestea Popular pentru rafting. În zonă Apă de culoare turcoaz. De asemenea Izvorăște din Sierra de las Minas. Astfel, Râul Cahabón se încadrează firesc în imaginea de ansamblu a Guatemalei, arătând cât de strâns sunt legate cultura maya, peisajul vulcanic și cultivarea cafelei, a trestiei de zahăr și a bananelor.", en: "Cahabón River is a notable location in Guatemala where the rich Maya heritage, the volcanic highland landscape and the country's cultural diversity come together in a striking way. A river in Alta Verapaz, famous for the cascades of Semuc Champey and for rafting. At the same time Flows under Semuc Champey. In addition Popular for white-water rafting. In the surrounding area Turquoise colored water. Another characteristic feature Source in the Sierra de las Minas. In this way, Cahabón River fits naturally into the wider picture of Guatemala, showing how closely Maya culture, the volcanic highlands and the cultivation of coffee, sugar cane and bananas are intertwined." },
    factsAdvanced: { de: ["Der Río Cahabón ist der wichtigste und wildeste Fluss der Verapaz-Region.", "Er durchfließt unterirdisch das berühmte Naturdenkmal Semuc Champey.", "Der Fluss bietet einige der besten und anspruchsvollsten Rafting-Routen in Mittelamerika.", "Ein massives Wasserkraftprojekt (Renace) leitet große Teile des Flusses in Rohre um.", "Der Konflikt um die Staudämme gipfelte in der umstrittenen Inhaftierung von Q'eqchi'-Führern.", "Die charakteristische türkise Farbe stammt aus den gelösten Kalkmineralien des Gebirges."], hu: ["A Semuc Champey alatt folyik", "Népszerű a vadvízi evezéshez", "Türkizkék víz", "A Sierra de las Minas-hegységben ered", "Guatemalában, a maja örökségéről ismert közép-amerikai országban található.", "Tükrözi a felföld, a Petén-medence és a Csendes-óceáni partvidék közötti régiójára jellemző sajátosságokat.", "Beleilleszkedik Guatemala vulkánjai, az Atitlán-tó és az olyan maja helyszínek, mint Tikal és Antigua alkotta kulturális mozaikba."], ro: ["Curge pe sub Semuc Champey", "Popular pentru rafting", "Apă de culoare turcoaz", "Izvorăște din Sierra de las Minas", "Se află în Guatemala, o țară central-americană cu o moștenire maya pronunțată.", "Reflectă trăsăturile tipice ale regiunii sale, situată între podișul înalt, bazinul Petén și coasta Pacificului.", "Se integrează în mozaicul guatemalez format din vulcani, lacuri precum Atitlán și situri maya precum Tikal și Antigua."], en: ["Flows under Semuc Champey", "Popular for white-water rafting", "Turquoise colored water", "Source in the Sierra de las Minas", "Located in Guatemala, a Central American country with a strong Maya heritage.", "Reflects features typical of its region between the highlands, the Petén lowlands and the Pacific coast.", "Set within Guatemala's mosaic of volcanoes, lakes such as Atitlán and Maya sites like Tikal and Antigua."] }, image: "/poi-images/rio-cahabon-nature-v2.webp"},
  {
    id: "laguna-lachua-nature-v2",
    type: "lake",
    parent: "GT-AV",
    coords: [-90.672, 15.91],
    name: { de: "Laguna Lachuá", hu: "Lachuá-lagúna", ro: "Laguna Lachuá", en: "Laguna Lachuá" },
    description: { de: "Ein fast perfekt kreisrunder, klarer See inmitten eines Nationalparks und Dschungels.", hu: "Majdnem tökéletesen kör alakú, tiszta vizű tó egy nemzeti park és dzsungel közepén.", ro: "Un lac carstic aproape perfect circular și limpede, în mijlocul unui parc național și al junglei.", en: "A nearly perfect circular, clear karst lake in the middle of a national park and jungle." },
    facts: {
      de: ["Nationalpark", "Kreisrunde Form", "Sehr klares Wasser", "Hohe Biodiversität"],
      hu: ["Nemzeti Park", "Kör alakú forma", "Nagyon tiszta víz", "Magas biológiai sokféleség"],
      ro: ["Parc Național", "Formă circulară", "Apă foarte limpede", "Biodiversitate ridicată"],
      en: ["National Park", "Circular shape", "Very clear water", "High biodiversity"]
    },
    descriptionAdvanced: {
      hu: "A Laguna Lachuá egy lenyűgöző, szinte tökéletesen kör alakú (cenote típusú) természetes tó Alta Verapaz megye északi részén, sűrű, síkvidéki trópusi esőerdővel (Eco-región Lachuá) körülvéve. A tó és a környező park egyedülálló, zárt ökoszisztémát alkot. A víz tiszta és enyhén kénes illatú (a q'eqchi' név is a 'büdös vízre' utal), ami miatt szúnyogok és moszkitók egyáltalán nem élnek a tó partján. Mivel a tó szigorúan védett nemzeti park (Ramsari vizesélőhely), horgászni tilos, és a helyi halak olyannyira nem félnek az embertől, hogy meg is csipkedik a vízben álló fürdőzőket. A tó körüli párás dzsungel otthont ad jaguároknak, bőgőmajmoknak és színes tukánoknak, míg maga a tó mélysége (több mint 200 méter a közepén) és eredete – hogy karsztos beomlás vagy ősi meteoritkráter – a mai napig izgatja a kutatók fantáziáját. Földrajz K8 — kör alakú karszttavak és zárt erdei ökoszisztémák.",
      de: "Versteckt im isolierten, tropischen Norden der Alta Verapaz liegt die Laguna Lachuá, ein absolut unberührtes Naturwunder. Der kreisrunde, tiefe See ist geologisch eine gewaltige Cenote (Karst-Einsturzdoline), die von undurchdringlichem, dichten Dschungel völlig umschlossen ist. Der See zeichnet sich durch seinen unangenehm schwefeligen Geruch aus – der Name 'Lachuá' bedeutet in Q'eqchi' passenderweise 'stinkendes Wasser'. Doch das Wasser selbst ist extrem klar, türkisfarben und voller neugieriger Fische. Da das Biotop strikt vor dem Holzeinschlag und Jägern geschützt ist, können Besucher hier Tapire, Jaguare und Heerscharen von Brüllaffen in ihrer natürlichen Umgebung antreffen. Um die Reinheit zu wahren, dürfen Besucher den See nur nach einer mehrstündigen Wanderung durch den Dschungel betreten; der Einsatz von Chemikalien wie Sonnencreme ist strikt verboten. Biologie K7 — Karst-Ökosysteme und strenge Schutzgebiete."
    },
    factsAdvanced: {
      hu: ["Tökéletes köralakú, cenote jellegű krátertó, a közepén meghaladja a 220 méteres mélységet.", "A víz nagyon magas kén- és kalciumtartalmú, ezért nincsenek szúnyogok a parton.", "A tó neve a q'eqchi' 'li chu há' (büdös víz) kifejezésből származik.", "A halak teljesen szelídek, és védett státuszuk miatt a tóban tilos bármilyen halászat.", "Ramsari egyezmény által védett vizesélőhely, amelyet sűrű trópusi esőerdő övez.", "Az ökoszisztéma fennmaradását veszélyezteti a környező területek agresszív erdőirtása (illegális farmok)."],
      de: ["Die Laguna Lachuá ist ein fast perfekt kreisrunder Karstsee (Cenote).", "Der Name Lachuá bedeutet in der indigenen Q'eqchi'-Sprache wörtlich 'stinkendes Wasser'.", "Das Wasser hat einen hohen Schwefelgehalt, ist aber sehr klar und badetauglich.", "Um das empfindliche Ökosystem zu schützen, ist der See nur zu Fuß erreichbar (4 km Wanderung).", "Der Nationalpark (Biotopo) ist einer der besterhaltenen Regenwälder Guatemalas.", "Sonnencremes und Shampoos sind im Park verboten, um Wasserverunreinigungen zu verhindern."]
    },
    descriptionAdvanced: { de: "Versteckt im isolierten, tropischen Norden der Alta Verapaz liegt die Laguna Lachuá, ein absolut unberührtes Naturwunder. Der kreisrunde, tiefe See ist geologisch eine gewaltige Cenote (Karst-Einsturzdoline), die von undurchdringlichem, dichten Dschungel völlig umschlossen ist. Der See zeichnet sich durch seinen unangenehm schwefeligen Geruch aus – der Name 'Lachuá' bedeutet in Q'eqchi' passenderweise 'stinkendes Wasser'. Doch das Wasser selbst ist extrem klar, türkisfarben und voller neugieriger Fische. Da das Biotop strikt vor dem Holzeinschlag und Jägern geschützt ist, können Besucher hier Tapire, Jaguare und Heerscharen von Brüllaffen in ihrer natürlichen Umgebung antreffen. Um die Reinheit zu wahren, dürfen Besucher den See nur nach einer mehrstündigen Wanderung durch den Dschungel betreten; der Einsatz von Chemikalien wie Sonnencreme ist strikt verboten. Biologie K7 — Karst-Ökosysteme und strenge Schutzgebiete.", hu: "Lachuá-lagúna Guatemala egyik figyelemre méltó pontja, ahol a maja örökség, a vulkáni felföld és az ország sokszínű kultúrája kézzelfoghatóan találkozik. Majdnem tökéletesen kör alakú, tiszta vizű tó egy nemzeti park és dzsungel közepén. Ugyanakkor Nemzeti Park. Emellett Kör alakú forma. A környéken Nagyon tiszta víz. Jellemző továbbá Magas biológiai sokféleség. Mindezekkel együtt Lachuá-lagúna jól illeszkedik Guatemala összképébe, és megmutatja, mennyire szorosan kapcsolódik egymáshoz a maja kultúra, a vulkanikus felföld, valamint a kávé, a cukornád és a banán termesztése.", ro: "Laguna Lachuá este un punct remarcabil al Guatemalei, unde moștenirea maya, peisajul vulcanic și diversitatea culturală a țării se întâlnesc într-un mod expresiv. Un lac carstic aproape perfect circular și limpede, în mijlocul unui parc național și al junglei. În același timp Parc Național. Pe lângă acestea Formă circulară. În zonă Apă foarte limpede. De asemenea Biodiversitate ridicată. Astfel, Laguna Lachuá se încadrează firesc în imaginea de ansamblu a Guatemalei, arătând cât de strâns sunt legate cultura maya, peisajul vulcanic și cultivarea cafelei, a trestiei de zahăr și a bananelor.", en: "Laguna Lachuá is a notable location in Guatemala where the rich Maya heritage, the volcanic highland landscape and the country's cultural diversity come together in a striking way. A nearly perfect circular, clear karst lake in the middle of a national park and jungle. At the same time National Park. In addition Circular shape. In the surrounding area Very clear water. Another characteristic feature High biodiversity. In this way, Laguna Lachuá fits naturally into the wider picture of Guatemala, showing how closely Maya culture, the volcanic highlands and the cultivation of coffee, sugar cane and bananas are intertwined." },
    factsAdvanced: { de: ["Die Laguna Lachuá ist ein fast perfekt kreisrunder Karstsee (Cenote).", "Der Name Lachuá bedeutet in der indigenen Q'eqchi'-Sprache wörtlich 'stinkendes Wasser'.", "Das Wasser hat einen hohen Schwefelgehalt, ist aber sehr klar und badetauglich.", "Um das empfindliche Ökosystem zu schützen, ist der See nur zu Fuß erreichbar (4 km Wanderung).", "Der Nationalpark (Biotopo) ist einer der besterhaltenen Regenwälder Guatemalas.", "Sonnencremes und Shampoos sind im Park verboten, um Wasserverunreinigungen zu verhindern."], hu: ["Nemzeti Park", "Kör alakú forma", "Nagyon tiszta víz", "Magas biológiai sokféleség", "Guatemalában, a maja örökségéről ismert közép-amerikai országban található.", "Tükrözi a felföld, a Petén-medence és a Csendes-óceáni partvidék közötti régiójára jellemző sajátosságokat.", "Beleilleszkedik Guatemala vulkánjai, az Atitlán-tó és az olyan maja helyszínek, mint Tikal és Antigua alkotta kulturális mozaikba."], ro: ["Parc Național", "Formă circulară", "Apă foarte limpede", "Biodiversitate ridicată", "Se află în Guatemala, o țară central-americană cu o moștenire maya pronunțată.", "Reflectă trăsăturile tipice ale regiunii sale, situată între podișul înalt, bazinul Petén și coasta Pacificului.", "Se integrează în mozaicul guatemalez format din vulcani, lacuri precum Atitlán și situri maya precum Tikal și Antigua."], en: ["National Park", "Circular shape", "Very clear water", "High biodiversity", "Located in Guatemala, a Central American country with a strong Maya heritage.", "Reflects features typical of its region between the highlands, the Petén lowlands and the Pacific coast.", "Set within Guatemala's mosaic of volcanoes, lakes such as Atitlán and Maya sites like Tikal and Antigua."] }, image: "/poi-images/laguna-lachua-nature-v2.webp"},
  {
    id: "montanas-mayas-nature-v2",
    type: "mountain",
    parent: "GT-PE",
    coords: [-89.25, 16.5],
    name: { de: "Maya-Gebirge", hu: "Maja-hegység", ro: "Munții Maya", en: "Maya Mountains" },
    description: { de: "Ein Gebirgszug, der sich von Belize bis in den Osten Guatemalas erstreckt und reich an unberührter Natur ist.", hu: "Hegylánc, amely Belize-től Kelet-Guatemaláig terjed, és érintetlen természeti értékekben gazdag.", ro: "Un lanț muntos care se întinde din Belize până în estul Guatemalei, bogat în natură neatinsă.", en: "A mountain range extending from Belize into eastern Guatemala, rich in pristine nature." },
    facts: {
      de: ["Grenzüberschreitendes Gebirge", "Geringe Bevölkerungsdichte", "Wichtige Wasserscheide", "Enthält viele Höhlen"],
      hu: ["Határokon átnyúló hegység", "Alacsony népsűrűség", "Fontos vízválasztó", "Sok barlangot rejt"],
      ro: ["Lanț muntos transfrontalier", "Densitate redusă a populației", "Diviziune hidrografică importantă", "Conține multe peșteri"],
      en: ["Cross-border mountain range", "Low population density", "Important watershed", "Contains many caves"]
    },
    descriptionAdvanced: {
      hu: "A Maja-hegység (Montañas Mayas vagy Sierra Maya) egy alacsony, ám rendkívül zord, sűrű dzsungellel borított hegylánc, amely Kelet-Peténből (Guatemala) nyúlik át Dél-Belizébe. A guatemalai oldalon a hegység keleti, elszigetelt része (például Poptún és Dolores közelében) hatalmas, megközelíthetetlen karsztfennsíkokból és mély barlangrendszerekből (mint a híres Naj Tunich) áll, amiket ritka fenyőerdők ('pinares') és trópusi őserdő borít. Ez a régió szolgáltatott a klasszikus maja civilizáció számára olyan luxuscikkeket, mint a gránit (őrlőkövekhez), a hematit és a pirit, amelyek hiányoztak az alföldi mészkőrétegekből. Ma a hegyvidék a guatemalai fakitermelés, a csempészútvonalak és a guatemalai-belize-i határvita legkonfliktusosabb földrajzi területe. Földrajz K7 — karsztos trópusi hegységek és határon átnyúló ökoszisztémák.",
      de: "Die Maya-Berge (Montañas Mayas) sind ein extrem raues, dicht bewaldetes und dünn besiedeltes Gebirgsmassiv, das den Südosten des Petén und Teile des Nachbarlandes Belize dominiert. Im Gegensatz zu den vulkanischen Kordilleren des Südens besteht diese Bergkette aus Millionen Jahre altem Quarzit und Kalkstein und gehört zu den ältesten geologischen Formationen Mittelamerikas. Der isolierte Dschungel der Maya-Berge beheimatet einige der letzten intakten Ökosysteme für stark bedrohte Tiere wie den Jaguar, den Harpyien-Adler und den Tapir. In den Tälern verbergen sich unzählige unerforschte Maya-Ruinen. Wegen der extremen Unzugänglichkeit gibt es hier kaum Straßen, stattdessen wird das Gebiet oft illegal von Plünderern von Edelhölzern (wie Mahagoni) und Goldsuchern betreten. Umweltschützer kämpfen an vorderster Front, um dieses unbezahlbare Biosphärenreservat vor dem Kollaps zu retten. Geografie K8 — Uralte Gebirgsformationen."
    },
    factsAdvanced: {
      hu: ["Ez a hegylánc az egyetlen jelentős (magaslati) kiemelkedés a hatalmas peténi-yucatáni síkságon.", "Geológiailag Közép-Amerika egyik legősibb, gránitot, vulkáni kőzetet és mészkövet is tartalmazó hegye.", "A klasszikus maják számára a hegység fontos nyersanyagforrás volt (gránit metatékhoz, pirit tükrökhöz).", "A hegy gyomra gigantikus barlangrendszereket (pl. Chiquibul, Naj Tunich) rejt.", "A guatemalai és belize-i határ egy jelentős része ezen a sűrű dzsungel-hegygerincen fut keresztül.", "Keleti (belize-i) oldala a magas csapadék miatt esőerdő, míg a guatemalai oldalán fenyőerdők is megélnek."],
      de: ["Die Maya-Berge gehören geologisch zu den ältesten Gesteinsformationen Zentralamerikas.", "Das Massiv erstreckt sich über den Osten des Petén und bildet eine natürliche Grenze zu Belize.", "Im Gegensatz zu Süd-Guatemala gibt es in dieser Bergkette keine Vulkane.", "Das Gebiet ist ein absolutes Kern-Schutzgebiet für den mittelamerikanischen Jaguar.", "Tiefe, unzugängliche Kalksteinhöhlensysteme (wie die von Chiquibul) durchziehen das Gestein.", "Illegale Goldwäscher und Holzfäller ('Madereros') bedrohen die Naturschutzgebiete massiv."]
    },
    descriptionAdvanced: { de: "Die Maya-Berge (Montañas Mayas) sind ein extrem raues, dicht bewaldetes und dünn besiedeltes Gebirgsmassiv, das den Südosten des Petén und Teile des Nachbarlandes Belize dominiert. Im Gegensatz zu den vulkanischen Kordilleren des Südens besteht diese Bergkette aus Millionen Jahre altem Quarzit und Kalkstein und gehört zu den ältesten geologischen Formationen Mittelamerikas. Der isolierte Dschungel der Maya-Berge beheimatet einige der letzten intakten Ökosysteme für stark bedrohte Tiere wie den Jaguar, den Harpyien-Adler und den Tapir. In den Tälern verbergen sich unzählige unerforschte Maya-Ruinen. Wegen der extremen Unzugänglichkeit gibt es hier kaum Straßen, stattdessen wird das Gebiet oft illegal von Plünderern von Edelhölzern (wie Mahagoni) und Goldsuchern betreten. Umweltschützer kämpfen an vorderster Front, um dieses unbezahlbare Biosphärenreservat vor dem Kollaps zu retten. Geografie K8 — Uralte Gebirgsformationen.", hu: "Maja-hegység Guatemala egyik figyelemre méltó pontja, ahol a maja örökség, a vulkáni felföld és az ország sokszínű kultúrája kézzelfoghatóan találkozik. Hegylánc, amely Belize-től Kelet-Guatemaláig terjed, és érintetlen természeti értékekben gazdag. Ugyanakkor Határokon átnyúló hegység. Emellett Alacsony népsűrűség. A környéken Fontos vízválasztó. Jellemző továbbá Sok barlangot rejt. Mindezekkel együtt Maja-hegység jól illeszkedik Guatemala összképébe, és megmutatja, mennyire szorosan kapcsolódik egymáshoz a maja kultúra, a vulkanikus felföld, valamint a kávé, a cukornád és a banán termesztése.", ro: "Munții Maya este un punct remarcabil al Guatemalei, unde moștenirea maya, peisajul vulcanic și diversitatea culturală a țării se întâlnesc într-un mod expresiv. Un lanț muntos care se întinde din Belize până în estul Guatemalei, bogat în natură neatinsă. În același timp Lanț muntos transfrontalier. Pe lângă acestea Densitate redusă a populației. În zonă Diviziune hidrografică importantă. De asemenea Conține multe peșteri. Astfel, Munții Maya se încadrează firesc în imaginea de ansamblu a Guatemalei, arătând cât de strâns sunt legate cultura maya, peisajul vulcanic și cultivarea cafelei, a trestiei de zahăr și a bananelor.", en: "Maya Mountains is a notable location in Guatemala where the rich Maya heritage, the volcanic highland landscape and the country's cultural diversity come together in a striking way. A mountain range extending from Belize into eastern Guatemala, rich in pristine nature. At the same time Cross-border mountain range. In addition Low population density. In the surrounding area Important watershed. Another characteristic feature Contains many caves. In this way, Maya Mountains fits naturally into the wider picture of Guatemala, showing how closely Maya culture, the volcanic highlands and the cultivation of coffee, sugar cane and bananas are intertwined." },
    factsAdvanced: { de: ["Die Maya-Berge gehören geologisch zu den ältesten Gesteinsformationen Zentralamerikas.", "Das Massiv erstreckt sich über den Osten des Petén und bildet eine natürliche Grenze zu Belize.", "Im Gegensatz zu Süd-Guatemala gibt es in dieser Bergkette keine Vulkane.", "Das Gebiet ist ein absolutes Kern-Schutzgebiet für den mittelamerikanischen Jaguar.", "Tiefe, unzugängliche Kalksteinhöhlensysteme (wie die von Chiquibul) durchziehen das Gestein.", "Illegale Goldwäscher und Holzfäller ('Madereros') bedrohen die Naturschutzgebiete massiv."], hu: ["Határokon átnyúló hegység", "Alacsony népsűrűség", "Fontos vízválasztó", "Sok barlangot rejt", "Guatemalában, a maja örökségéről ismert közép-amerikai országban található.", "Tükrözi a felföld, a Petén-medence és a Csendes-óceáni partvidék közötti régiójára jellemző sajátosságokat.", "Beleilleszkedik Guatemala vulkánjai, az Atitlán-tó és az olyan maja helyszínek, mint Tikal és Antigua alkotta kulturális mozaikba."], ro: ["Lanț muntos transfrontalier", "Densitate redusă a populației", "Diviziune hidrografică importantă", "Conține multe peșteri", "Se află în Guatemala, o țară central-americană cu o moștenire maya pronunțată.", "Reflectă trăsăturile tipice ale regiunii sale, situată între podișul înalt, bazinul Petén și coasta Pacificului.", "Se integrează în mozaicul guatemalez format din vulcani, lacuri precum Atitlán și situri maya precum Tikal și Antigua."], en: ["Cross-border mountain range", "Low population density", "Important watershed", "Contains many caves", "Located in Guatemala, a Central American country with a strong Maya heritage.", "Reflects features typical of its region between the highlands, the Petén lowlands and the Pacific coast.", "Set within Guatemala's mosaic of volcanoes, lakes such as Atitlán and Maya sites like Tikal and Antigua."] }, image: "/poi-images/montanas-mayas-nature-v2.webp"},
  {
    id: "biotopo-del-quetzal-nature-v2",
    type: "forest",
    parent: "GT-BV",
    coords: [-90.208, 15.215],
    name: { de: "Biotopo del Quetzal", hu: "Kvézál Biotóp", ro: "Biotopul Quetzalului", en: "Quetzal Biotope" },
    description: { de: "Ein geschütztes Nebelwaldreservat, das dem Schutz des Nationalvogels, des Quetzals, gewidmet ist.", hu: "Védett köderdő-rezervátum, amelyet a nemzeti madár, a kvézál védelmére hoztak létre.", ro: "O rezervație protejată de pădure noroasă dedicată protecției păsării naționale, quetzalul.", en: "A protected cloud forest reserve dedicated to the conservation of the national bird, the Quetzal." },
    facts: {
      de: ["Schutzgebiet für den Quetzal", "Nebelwald-Ökosystem", "Wasserfälle und Wanderwege", "Reich an Epiphyten"],
      hu: ["Védett terület a kvézál számára", "Köderdő ökoszisztéma", "Vízesések és túraútvonalak", "Epifitonokban gazdag"],
      ro: ["Arie protejată pentru quetzal", "Ecosistem de pădure noroasă", "Cascade și trasee de drumeții", "Bogat în epifite"],
      en: ["Protected area for the Quetzal", "Cloud forest ecosystem", "Waterfalls and hiking trails", "Rich in epiphytes"]
    },
    descriptionAdvanced: {
      hu: "A Biotopo del Quetzal (hivatalosan Biotopo Universitario Mario Dary Rivera) Baja Verapaz megye sűrű hegyein (Purulhá mellett) egy több mint 1000 hektáros rezervátum, amelyet kifejezetten Guatemala szent nemzeti madara, az élénk smaragdzöld és vörös tollazatú Resplendent Quetzal védelmére alapítottak 1976-ban. A rezervátum egy tipikus, érintetlen 'köderdő' vagy felhőerdő (bosque nuboso), amely 1500–2300 méteres tengerszint feletti magasságban helyezkedik el. Ezen a klímán a levegő páratartalma szinte mindig 100%-os, az állandó ködszitálás (chipi-chipi) pedig buja növényzetet: mohával borított, 30-40 méter magas fákat, óriási páfrányokat és epifitonokat (broméliák, orchideák) eredményez. A quetzal fennmaradása szorosan kötődik az itt élő 'aguacatillo' fa apró terméséhez. A park bejárása során a fákról csöpögő víz állandó eső illúzióját kelti a túrázóknak. Földrajz K6 — a köderdők ökoszisztémája (epifitonok) és az ornitológia.",
      de: "Das Biotopo del Quetzal (offiziell Biotopo Mario Dary Rivera) in der Baja Verapaz ist das wichtigste Schutzgebiet für den Nationalvogel Guatemalas, den majestätischen Quetzal. Dieses dichte, extrem feuchte Nebelwaldreservat liegt an den steilen Hängen entlang der Autobahn nach Cobán. Der Wald ist überzogen mit Bromelien, Orchideen und Riesenfarnen, die wie Schwämme die ständige Feuchtigkeit aus der Luft saugen. Der Quetzal ist für sein Überleben extrem abhängig von diesem intakten, wilden Primärwald, da er seine Nester in morschen Baumstümpfen baut und sich von den Früchten des Aguacatillo-Baums ernährt. Für Ornithologen und Naturliebhaber ist das Reservat ein Mekka, auch wenn der stark bedrohte Quetzal aufgrund seiner Scheu oft nur sehr schwer in den dichten, nebelverhangenen Wipfeln zu entdecken ist. Biologie K8 — Nebelwälder und Nationalvögel."
    },
    factsAdvanced: {
      hu: ["A felhőerdő ökoszisztémáját védi, ahol a fák ágait teljesen beborítják a mohák, páfrányok és broméliák.", "Az alapító Mario Dary Rivera (akiről a parkot is elnevezték) célja a quetzal életterének, az 'aguacatillo' fának a megmentése volt.", "Az átlagos páratartalom 100% közeli, amit a karibi szelek hoznak és hűlnek le a hegyen (orografikus csapadék).", "A quetzal (Pharomachrus mocinno) mellett a rezervátum pumáknak, tapíroknak és bőgőmajmoknak is otthont ad.", "A madár megpillantására a legjobb időszak a fészkelési szezon (március-június) kora hajnalban.", "A rezervátum a guatemalai egyetem (USAC) kezelésében és biológiai felügyelete alatt áll."],
      de: ["Das Schutzgebiet wurde 1976 speziell zum Erhalt des vom Aussterben bedrohten Quetzals gegründet.", "Der Quetzal ernährt sich in diesem Wald fast ausschließlich von kleinen wilden Avocados (Aguacatillos).", "Der Nebelwald im Biotopo zeichnet sich durch fast 100 % Luftfeuchtigkeit aus.", "Der Park ist nach dem Naturschützer und Akademiker Mario Dary Rivera benannt.", "Zahlreiche Wasserfälle und extrem dichte Vegetation prägen die Wanderwege des Parks.", "Der Quetzal galt bereits bei den alten Maya als heilig und symbolisiert die Freiheit."]
    },
    descriptionAdvanced: { de: "Das Biotopo del Quetzal (offiziell Biotopo Mario Dary Rivera) in der Baja Verapaz ist das wichtigste Schutzgebiet für den Nationalvogel Guatemalas, den majestätischen Quetzal. Dieses dichte, extrem feuchte Nebelwaldreservat liegt an den steilen Hängen entlang der Autobahn nach Cobán. Der Wald ist überzogen mit Bromelien, Orchideen und Riesenfarnen, die wie Schwämme die ständige Feuchtigkeit aus der Luft saugen. Der Quetzal ist für sein Überleben extrem abhängig von diesem intakten, wilden Primärwald, da er seine Nester in morschen Baumstümpfen baut und sich von den Früchten des Aguacatillo-Baums ernährt. Für Ornithologen und Naturliebhaber ist das Reservat ein Mekka, auch wenn der stark bedrohte Quetzal aufgrund seiner Scheu oft nur sehr schwer in den dichten, nebelverhangenen Wipfeln zu entdecken ist. Biologie K8 — Nebelwälder und Nationalvögel.", hu: "Kvézál Biotóp Guatemala egyik figyelemre méltó pontja, ahol a maja örökség, a vulkáni felföld és az ország sokszínű kultúrája kézzelfoghatóan találkozik. Védett köderdő-rezervátum, amelyet a nemzeti madár, a kvézál védelmére hoztak létre. Ugyanakkor Védett terület a kvézál számára. Emellett Köderdő ökoszisztéma. A környéken Vízesések és túraútvonalak. Jellemző továbbá Epifitonokban gazdag. Mindezekkel együtt Kvézál Biotóp jól illeszkedik Guatemala összképébe, és megmutatja, mennyire szorosan kapcsolódik egymáshoz a maja kultúra, a vulkanikus felföld, valamint a kávé, a cukornád és a banán termesztése.", ro: "Biotopul Quetzalului este un punct remarcabil al Guatemalei, unde moștenirea maya, peisajul vulcanic și diversitatea culturală a țării se întâlnesc într-un mod expresiv. O rezervație protejată de pădure noroasă dedicată protecției păsării naționale, quetzalul. În același timp Arie protejată pentru quetzal. Pe lângă acestea Ecosistem de pădure noroasă. În zonă Cascade și trasee de drumeții. De asemenea Bogat în epifite. Astfel, Biotopul Quetzalului se încadrează firesc în imaginea de ansamblu a Guatemalei, arătând cât de strâns sunt legate cultura maya, peisajul vulcanic și cultivarea cafelei, a trestiei de zahăr și a bananelor.", en: "Quetzal Biotope is a notable location in Guatemala where the rich Maya heritage, the volcanic highland landscape and the country's cultural diversity come together in a striking way. A protected cloud forest reserve dedicated to the conservation of the national bird, the Quetzal. At the same time Protected area for the Quetzal. In addition Cloud forest ecosystem. In the surrounding area Waterfalls and hiking trails. Another characteristic feature Rich in epiphytes. In this way, Quetzal Biotope fits naturally into the wider picture of Guatemala, showing how closely Maya culture, the volcanic highlands and the cultivation of coffee, sugar cane and bananas are intertwined." },
    factsAdvanced: { de: ["Das Schutzgebiet wurde 1976 speziell zum Erhalt des vom Aussterben bedrohten Quetzals gegründet.", "Der Quetzal ernährt sich in diesem Wald fast ausschließlich von kleinen wilden Avocados (Aguacatillos).", "Der Nebelwald im Biotopo zeichnet sich durch fast 100 % Luftfeuchtigkeit aus.", "Der Park ist nach dem Naturschützer und Akademiker Mario Dary Rivera benannt.", "Zahlreiche Wasserfälle und extrem dichte Vegetation prägen die Wanderwege des Parks.", "Der Quetzal galt bereits bei den alten Maya als heilig und symbolisiert die Freiheit."], hu: ["Védett terület a kvézál számára", "Köderdő ökoszisztéma", "Vízesések és túraútvonalak", "Epifitonokban gazdag", "Guatemalában, a maja örökségéről ismert közép-amerikai országban található.", "Tükrözi a felföld, a Petén-medence és a Csendes-óceáni partvidék közötti régiójára jellemző sajátosságokat.", "Beleilleszkedik Guatemala vulkánjai, az Atitlán-tó és az olyan maja helyszínek, mint Tikal és Antigua alkotta kulturális mozaikba."], ro: ["Arie protejată pentru quetzal", "Ecosistem de pădure noroasă", "Cascade și trasee de drumeții", "Bogat în epifite", "Se află în Guatemala, o țară central-americană cu o moștenire maya pronunțată.", "Reflectă trăsăturile tipice ale regiunii sale, situată între podișul înalt, bazinul Petén și coasta Pacificului.", "Se integrează în mozaicul guatemalez format din vulcani, lacuri precum Atitlán și situri maya precum Tikal și Antigua."], en: ["Protected area for the Quetzal", "Cloud forest ecosystem", "Waterfalls and hiking trails", "Rich in epiphytes", "Located in Guatemala, a Central American country with a strong Maya heritage.", "Reflects features typical of its region between the highlands, the Petén lowlands and the Pacific coast.", "Set within Guatemala's mosaic of volcanoes, lakes such as Atitlán and Maya sites like Tikal and Antigua."] }, image: "/poi-images/biotopo-del-quetzal-nature-v2.webp"},
  {
    id: "rio-la-pasion-nature-v2",
    type: "river",
    parent: "GT-PE",
    coords: [-90.25, 16.5],
    name: { de: "Río de la Pasión", hu: "La Pasión-folyó", ro: "Râul Pasión", en: "Pasión River" },
    description: { de: "Ein wichtiger Fluss im Petén, der als Verkehrsweg zu vielen Maya-Stätten wie Ceibal und Aguateca dient.", hu: "Fontos folyó Peténben, amely közlekedési útvonalként szolgál számos maja lelőhelyhez, mint Ceibal és Aguateca.", ro: "Un râu important în Petén, care servește drept cale de transport către multe situri mayașe, cum ar fi Ceibal și Aguateca.", en: "An important river in Petén, serving as a transport route to many Maya sites like Ceibal and Aguateca." },
    facts: {
      de: ["Wichtiger Wasserweg im Petén", "Verbindet archäologische Stätten", "Mündet in den Usumacinta", "Lebensraum für Krokodile"],
      hu: ["Fontos vízi út Peténben", "Régészeti lelőhelyeket köt össze", "Az Usumacintába torkollik", "Krokodilok élőhelye"],
      ro: ["Cale navigabilă importantă în Petén", "Leagă situri arheologice", "Se varsă în Usumacinta", "Habitat pentru crocodili"],
      en: ["Important waterway in Petén", "Connects archaeological sites", "Flows into the Usumacinta", "Habitat for crocodiles"]
    },
    descriptionAdvanced: {
      hu: "A Río La Pasión a guatemalai Alta Verapaz hegyeiből eredő, majd a hatalmas északi Petén-alföldön (Sayaxché városán át) kanyargó, lassan hömpölygő, barna vizű trópusi folyó. A Pásión kulcsfontosságú földrajzi és történelmi artéria volt: a klasszikus maja civilizáció (Ceibal, Dos Pilas, Cancuén) ezen a 'vízi autópályán' keresztül szállította a fegyvereket és a luxuscikkeket. Később a spanyol és európai favágók (monterías) használták a drága mahagónirönkök leúsztatására. A folyó a mexikói határhoz közeledve egyesül a Salinas-folyóval, létrehozva a masszív Usumacinta-folyót. Bár a folyami ökoszisztéma gazdag halakban, teknősökben és Morelet-krokodilokban, a 2015-ös évben a La Pasión nemzetközi botrány helyszíne lett: a közeli afrikai pálmaolaj-ültetvények (Repsába cég) mérgező vegyszerkibocsátása miatt több millió tonna hal pusztult el a folyóban ('ecocidio'), megfojtva a helyi közösségek halászati megélhetését. Földrajz K8 — folyami ökoszisztémák és az agroipari vízszennyezés.",
      de: "Der Río La Pasión ist das gewaltige, schlammbraune Adernnetz des südlichen Petén. Er schlängelt sich gemächlich und in weiten Kurven durch den flachen, feuchtheißen Tiefland-Dschungel, bis er sich schließlich mit dem Río Salinas zum Usumacinta vereinigt. Da viele Straßen in dieser abgelegenen Region noch immer unbefestigt sind, ist der Fluss die wichtigste Transportroute. In der Stadt Sayaxché muss sämtlicher Fahrzeugverkehr, vom Lkw bis zum Touristenbus, mit Pontonfähren den extrem breiten Fluss überqueren, da es keine Brücken gibt. Entlang seiner Ufer befinden sich einige der bedeutendsten klassischen Maya-Ruinen wie Ceibal, Cancuén und Dos Pilas, die alle strategisch erbaut wurden, um den lukrativen Kanu-Handel auf dem Río La Pasión zu kontrollieren. Krokodile und Flussschildkröten sind hier allgegenwärtig. Geografie K7 — Tropische Tieflandflüsse."
    },
    factsAdvanced: {
      hu: ["A Pásión a Petén megye déli részének legfontosabb vízgyűjtője, lassú, alföldi sodrással kanyarog (meanderek).", "A Salinas folyóval egyesülve (az Altar de Sacrificios romoknál) alkotják meg a hatalmas Usumacinta folyót.", "A maja klasszikus korban (Kr.u. 300-900) Közép-Amerika legforgalmasabb és leggazdagabb folyami kereskedelmi útja volt.", "A 19. és 20. században a trópusi fák (főleg a mahagóni és cédrus) kitermelésének és úsztatásának központja.", "2015-ben a folyón történt Guatemala történetének egyik legnagyobb ökológiai katasztrófája egy pálmaolaj-gyár szivárgása miatt.", "Sayaxché városánál ma is csak egy sodronyköteles komppal (ferry) lehet átkelni a folyón járművekkel."],
      de: ["Der Río La Pasión fließt ausschließlich im flachen, stark bewaldeten Departamento Petén.", "Er ist eine der wichtigsten Verkehrsadern und wird am Ort Sayaxché durch Fähren überquert.", "Zahlreiche große klassische Maya-Städte (Ceibal, Aguateca) nutzten ihn als Handelsroute.", "Die Strömung ist meist sehr gemächlich, was das Gewässer ideal für die Flussschifffahrt macht.", "Die Farbe des Flusses ist oft extrem braun (schlammig) aufgrund von Erosion durch Abholzung.", "Im Jahr 2015 erlitt der Fluss eine ökologische Katastrophe durch Chemikalien aus einer Palmöl-Fabrik."]
    },
    descriptionAdvanced: { de: "Der Río La Pasión ist das gewaltige, schlammbraune Adernnetz des südlichen Petén. Er schlängelt sich gemächlich und in weiten Kurven durch den flachen, feuchtheißen Tiefland-Dschungel, bis er sich schließlich mit dem Río Salinas zum Usumacinta vereinigt. Da viele Straßen in dieser abgelegenen Region noch immer unbefestigt sind, ist der Fluss die wichtigste Transportroute. In der Stadt Sayaxché muss sämtlicher Fahrzeugverkehr, vom Lkw bis zum Touristenbus, mit Pontonfähren den extrem breiten Fluss überqueren, da es keine Brücken gibt. Entlang seiner Ufer befinden sich einige der bedeutendsten klassischen Maya-Ruinen wie Ceibal, Cancuén und Dos Pilas, die alle strategisch erbaut wurden, um den lukrativen Kanu-Handel auf dem Río La Pasión zu kontrollieren. Krokodile und Flussschildkröten sind hier allgegenwärtig. Geografie K7 — Tropische Tieflandflüsse.", hu: "La Pasión-folyó Guatemala egyik figyelemre méltó pontja, ahol a maja örökség, a vulkáni felföld és az ország sokszínű kultúrája kézzelfoghatóan találkozik. Fontos folyó Peténben, amely közlekedési útvonalként szolgál számos maja lelőhelyhez, mint Ceibal és Aguateca. Ugyanakkor Fontos vízi út Peténben. Emellett Régészeti lelőhelyeket köt össze. A környéken Az Usumacintába torkollik. Jellemző továbbá Krokodilok élőhelye. Mindezekkel együtt La Pasión-folyó jól illeszkedik Guatemala összképébe, és megmutatja, mennyire szorosan kapcsolódik egymáshoz a maja kultúra, a vulkanikus felföld, valamint a kávé, a cukornád és a banán termesztése.", ro: "Râul Pasión este un punct remarcabil al Guatemalei, unde moștenirea maya, peisajul vulcanic și diversitatea culturală a țării se întâlnesc într-un mod expresiv. Un râu important în Petén, care servește drept cale de transport către multe situri mayașe, cum ar fi Ceibal și Aguateca. În același timp Cale navigabilă importantă în Petén. Pe lângă acestea Leagă situri arheologice. În zonă Se varsă în Usumacinta. De asemenea Habitat pentru crocodili. Astfel, Râul Pasión se încadrează firesc în imaginea de ansamblu a Guatemalei, arătând cât de strâns sunt legate cultura maya, peisajul vulcanic și cultivarea cafelei, a trestiei de zahăr și a bananelor.", en: "Pasión River is a notable location in Guatemala where the rich Maya heritage, the volcanic highland landscape and the country's cultural diversity come together in a striking way. An important river in Petén, serving as a transport route to many Maya sites like Ceibal and Aguateca. At the same time Important waterway in Petén. In addition Connects archaeological sites. In the surrounding area Flows into the Usumacinta. Another characteristic feature Habitat for crocodiles. In this way, Pasión River fits naturally into the wider picture of Guatemala, showing how closely Maya culture, the volcanic highlands and the cultivation of coffee, sugar cane and bananas are intertwined." },
    factsAdvanced: { de: ["Der Río La Pasión fließt ausschließlich im flachen, stark bewaldeten Departamento Petén.", "Er ist eine der wichtigsten Verkehrsadern und wird am Ort Sayaxché durch Fähren überquert.", "Zahlreiche große klassische Maya-Städte (Ceibal, Aguateca) nutzten ihn als Handelsroute.", "Die Strömung ist meist sehr gemächlich, was das Gewässer ideal für die Flussschifffahrt macht.", "Die Farbe des Flusses ist oft extrem braun (schlammig) aufgrund von Erosion durch Abholzung.", "Im Jahr 2015 erlitt der Fluss eine ökologische Katastrophe durch Chemikalien aus einer Palmöl-Fabrik."], hu: ["Fontos vízi út Peténben", "Régészeti lelőhelyeket köt össze", "Az Usumacintába torkollik", "Krokodilok élőhelye", "Guatemalában, a maja örökségéről ismert közép-amerikai országban található.", "Tükrözi a felföld, a Petén-medence és a Csendes-óceáni partvidék közötti régiójára jellemző sajátosságokat.", "Beleilleszkedik Guatemala vulkánjai, az Atitlán-tó és az olyan maja helyszínek, mint Tikal és Antigua alkotta kulturális mozaikba."], ro: ["Cale navigabilă importantă în Petén", "Leagă situri arheologice", "Se varsă în Usumacinta", "Habitat pentru crocodili", "Se află în Guatemala, o țară central-americană cu o moștenire maya pronunțată.", "Reflectă trăsăturile tipice ale regiunii sale, situată între podișul înalt, bazinul Petén și coasta Pacificului.", "Se integrează în mozaicul guatemalez format din vulcani, lacuri precum Atitlán și situri maya precum Tikal și Antigua."], en: ["Important waterway in Petén", "Connects archaeological sites", "Flows into the Usumacinta", "Habitat for crocodiles", "Located in Guatemala, a Central American country with a strong Maya heritage.", "Reflects features typical of its region between the highlands, the Petén lowlands and the Pacific coast.", "Set within Guatemala's mosaic of volcanoes, lakes such as Atitlán and Maya sites like Tikal and Antigua."] }, image: "/poi-images/rio-la-pasion-nature-v2.webp"},
  {
    id: "sipacate-naranjo-national-park-nature-v2",
    type: "forest",
    parent: "GT-ES",
    coords: [-91.083, 13.917],
    name: { de: "Nationalpark Sipacate-Naranjo", hu: "Sipacate-Naranjo Nemzeti Park", ro: "Parcul Național Sipacate-Naranjo", en: "Sipacate-Naranjo National Park" },
    description: { de: "Ein Küstenschutzgebiet mit Mangrovenwäldern, wichtig für die Meeresschildkröten-Nistplätze.", hu: "Part menti védett terület mangrovéerdőkkel, fontos a tengeri teknősök fészkelőhelyei számára.", ro: "O arie protejată de coastă cu păduri de mangrove, importantă pentru locurile de cuibărit ale țestoaselor marine.", en: "A coastal protected area with mangrove forests, important for sea turtle nesting sites." },
    facts: {
      de: ["Mangrovenwälder", "Nistplätze für Meeresschildkröten", "Küstenschutz", "Reiche Vogelwelt"],
      hu: ["Mangroveerdők", "Tengeri teknősök fészkelőhelyei", "Partvédelem", "Gazdag madárvilág"],
      ro: ["Păduri de mangrove", "Locuri de cuibărit pentru țestoasele marine", "Protecția coastei", "Avifaună bogată"],
      en: ["Mangrove forests", "Nesting sites for sea turtles", "Coastal protection", "Rich birdlife"]
    },
    descriptionAdvanced: {
      hu: "A Parque Nacional Sipacate-Naranjo (Escuintla megye) a guatemalai csendes-óceáni partvidék utolsó, érintetlen mangrove-paradicsoma. A közel 2 000 hektáros, védett terület lagúnákból, mangroveerdőkből és a nyílt óceán fekete vulkáni homokos strandjaiból (Poza del Nance) áll. A terület a madarak (pelikánok, gémek, kormoránok) vándorlásának (Pacific Flyway) kulcsfontosságú téli menedéke. A park biológiai jelentősége felbecsülhetetlen, mivel ez az egész csendes-óceáni medence egyik legaktívabb tengeriteknős-fészkelőhelye (parlama és baule teknősök). A tengeri hullámzás és az iszapos, sósvízi mangrovelabirintus (amely a garnélarákok bölcsője) között a helyi halászok (lancheros) és ökoturisták osztoznak. A park folyamatos fenyegetettségben él a terjeszkedő cukornádültetvények, a fakitermelés és a klímaváltozás (tengerszint-emelkedés) miatt. Földrajz K7 — mangrove ökoszisztémák, torkolatvidékek és a biodiverzitás.",
      de: "Der Nationalpark Sipacate-Naranjo ist ein gewaltiges, ökologisch hochsensibles Mangrovengebiet an der zentralen Pazifikküste (Escuintla). Dieses Labyrinth aus Brackwasserkanälen und dichten, auf Stelzenwurzeln wachsenden Mangrovenwäldern ist eine der wichtigsten 'Kinderstuben' der marinen Tierwelt in Guatemala. Unzählige Arten von Fischen, Krebstieren und Garnelen finden hier Schutz vor Raubfischen. Das Gebiet ist auch ein wichtiges Überwinterungsziel für Zehntausende von Zugvögeln aus Nordamerika. Für Menschen, die abseits der großen Agrarbetriebe leben, bilden diese Mangroven durch traditionellen Fischfang und Salzgewinnung die wichtigste Lebensgrundlage. Gleichzeitig sind die Strände vor den Mangroven, insbesondere in 'El Paredón', aufgrund der massiven, konstanten Wellen zum absoluten Hotspot für internationale Surfer geworden. Biologie K7 — Das Ökosystem Mangroven."
    },
    factsAdvanced: {
      hu: ["A part menti mangrove mocsarak 4 mangrove fajból (vörös, fehér, fekete és 'botoncillo') épülnek fel.", "A tenger és a szárazföld sós és édesvizének keveredési zónája (estuárium).", "Több mint 90 féle vándor- és rezidens trópusi madárfaj fontos fészkelő és piheno helye.", "A fekete homokos tengerparton (Poza del Nance) az év bizonyos szakaszaiban zöld és fattyúteknősök (parlamas) százai raknak tojást.", "A sűrű mangrove gyökérzete létfontosságú az óceáni halak és garnélarákok ivadékainak túléléséhez.", "Az ipari mezőgazdaság (főleg a cukornád) növényvédőszerei és a víz elterelése állandó ökológiai fenyegetést jelentenek a parkra."],
      de: ["Der Nationalpark Sipacate-Naranjo schützt eines der größten Mangrovengebiete Guatemalas.", "Das Mangroven-Labyrinth fungiert als biologische Kinderstube für Fische und Garnelen.", "Die Region ist ein entscheidendes Schutzgebiet für zehntausende Zugvögel aus den USA.", "Die Strände der Gegend (wie El Paredón) sind weltbekannte Ziele für Surfer.", "Die Mangrovenwälder schützen die Küstenlinie vor schweren Stürmen und Flutwellen.", "Bedroht wird das Gebiet oft durch illegale Abholzung der Mangrovenbäume als Feuerholz."]
    },
    descriptionAdvanced: { de: "Der Nationalpark Sipacate-Naranjo ist ein gewaltiges, ökologisch hochsensibles Mangrovengebiet an der zentralen Pazifikküste (Escuintla). Dieses Labyrinth aus Brackwasserkanälen und dichten, auf Stelzenwurzeln wachsenden Mangrovenwäldern ist eine der wichtigsten 'Kinderstuben' der marinen Tierwelt in Guatemala. Unzählige Arten von Fischen, Krebstieren und Garnelen finden hier Schutz vor Raubfischen. Das Gebiet ist auch ein wichtiges Überwinterungsziel für Zehntausende von Zugvögeln aus Nordamerika. Für Menschen, die abseits der großen Agrarbetriebe leben, bilden diese Mangroven durch traditionellen Fischfang und Salzgewinnung die wichtigste Lebensgrundlage. Gleichzeitig sind die Strände vor den Mangroven, insbesondere in 'El Paredón', aufgrund der massiven, konstanten Wellen zum absoluten Hotspot für internationale Surfer geworden. Biologie K7 — Das Ökosystem Mangroven.", hu: "Sipacate-Naranjo Nemzeti Park Guatemala egyik figyelemre méltó pontja, ahol a maja örökség, a vulkáni felföld és az ország sokszínű kultúrája kézzelfoghatóan találkozik. Part menti védett terület mangrovéerdőkkel, fontos a tengeri teknősök fészkelőhelyei számára. Ugyanakkor Mangroveerdők. Emellett Tengeri teknősök fészkelőhelyei. A környéken Partvédelem. Jellemző továbbá Gazdag madárvilág. Mindezekkel együtt Sipacate-Naranjo Nemzeti Park jól illeszkedik Guatemala összképébe, és megmutatja, mennyire szorosan kapcsolódik egymáshoz a maja kultúra, a vulkanikus felföld, valamint a kávé, a cukornád és a banán termesztése.", ro: "Parcul Național Sipacate-Naranjo este un punct remarcabil al Guatemalei, unde moștenirea maya, peisajul vulcanic și diversitatea culturală a țării se întâlnesc într-un mod expresiv. O arie protejată de coastă cu păduri de mangrove, importantă pentru locurile de cuibărit ale țestoaselor marine. În același timp Păduri de mangrove. Pe lângă acestea Locuri de cuibărit pentru țestoasele marine. În zonă Protecția coastei. De asemenea Avifaună bogată. Astfel, Parcul Național Sipacate-Naranjo se încadrează firesc în imaginea de ansamblu a Guatemalei, arătând cât de strâns sunt legate cultura maya, peisajul vulcanic și cultivarea cafelei, a trestiei de zahăr și a bananelor.", en: "Sipacate-Naranjo National Park is a notable location in Guatemala where the rich Maya heritage, the volcanic highland landscape and the country's cultural diversity come together in a striking way. A coastal protected area with mangrove forests, important for sea turtle nesting sites. At the same time Mangrove forests. In addition Nesting sites for sea turtles. In the surrounding area Coastal protection. Another characteristic feature Rich birdlife. In this way, Sipacate-Naranjo National Park fits naturally into the wider picture of Guatemala, showing how closely Maya culture, the volcanic highlands and the cultivation of coffee, sugar cane and bananas are intertwined." },
    factsAdvanced: { de: ["Der Nationalpark Sipacate-Naranjo schützt eines der größten Mangrovengebiete Guatemalas.", "Das Mangroven-Labyrinth fungiert als biologische Kinderstube für Fische und Garnelen.", "Die Region ist ein entscheidendes Schutzgebiet für zehntausende Zugvögel aus den USA.", "Die Strände der Gegend (wie El Paredón) sind weltbekannte Ziele für Surfer.", "Die Mangrovenwälder schützen die Küstenlinie vor schweren Stürmen und Flutwellen.", "Bedroht wird das Gebiet oft durch illegale Abholzung der Mangrovenbäume als Feuerholz."], hu: ["Mangroveerdők", "Tengeri teknősök fészkelőhelyei", "Partvédelem", "Gazdag madárvilág", "Guatemalában, a maja örökségéről ismert közép-amerikai országban található.", "Tükrözi a felföld, a Petén-medence és a Csendes-óceáni partvidék közötti régiójára jellemző sajátosságokat.", "Beleilleszkedik Guatemala vulkánjai, az Atitlán-tó és az olyan maja helyszínek, mint Tikal és Antigua alkotta kulturális mozaikba."], ro: ["Păduri de mangrove", "Locuri de cuibărit pentru țestoasele marine", "Protecția coastei", "Avifaună bogată", "Se află în Guatemala, o țară central-americană cu o moștenire maya pronunțată.", "Reflectă trăsăturile tipice ale regiunii sale, situată între podișul înalt, bazinul Petén și coasta Pacificului.", "Se integrează în mozaicul guatemalez format din vulcani, lacuri precum Atitlán și situri maya precum Tikal și Antigua."], en: ["Mangrove forests", "Nesting sites for sea turtles", "Coastal protection", "Rich birdlife", "Located in Guatemala, a Central American country with a strong Maya heritage.", "Reflects features typical of its region between the highlands, the Petén lowlands and the Pacific coast.", "Set within Guatemala's mosaic of volcanoes, lakes such as Atitlán and Maya sites like Tikal and Antigua."] }, image: "/poi-images/sipacate-naranjo-national-park-nature-v2.webp"},
  {
    id: "laguna-brava-yolnabaj-nature-v2",
    type: "lake",
    parent: "GT-HU",
    coords: [-91.6, 16.15],
    name: { de: "Laguna Brava (Yolnabaj)", hu: "Laguna Brava (Yolnabaj)", ro: "Laguna Brava (Yolnabaj)", en: "Laguna Brava (Yolnabaj)" },
    description: { de: "Ein abgelegener, malerischer See nahe der mexikanischen Grenze, bekannt für sein türkisfarbenes Wasser.", hu: "Elzárt, festői tó a mexikói határ közelében, türkizkék vizéről ismert.", ro: "Un lac pitoresc și izolat lângă granița cu Mexic, cunoscut pentru apa sa turcoaz.", en: "A remote, picturesque lake near the Mexican border, known for its turquoise waters." },
    facts: {
      de: ["Türkisfarbenes Wasser", "Nahe der mexikanischen Grenze", "Karstsee mit Cenoten", "Schwer zugänglich"],
      hu: ["Türkizkék víz", "Közel a mexikói határhoz", "Karszttó cenotékkal", "Nehezen megközelíthető"],
      ro: ["Apă de culoare turcoaz", "Aproape de granița cu Mexic", "Lac carstic cu cenote", "Greu accesibil"],
      en: ["Turquoise water", "Near the Mexican border", "Karst lake with cenotes", "Difficult to access"]
    },
    descriptionAdvanced: {
      hu: "A Laguna Brava, vagy helyi, chuj maja nevén a Yolnabaj, Guatemala talán leginkább elszigetelt, misztikus szépségű hegyi tava, amely Huehuetenango megye messzi nyugati határvidékén, a Cuchumatanes-hegység és a mexikói (Chiapas) határ ölelésében rejtőzik. A tó 1140 méter tengerszint feletti magasságban, sűrű karsztos trópusi erdőkkel övezve fekszik. A víz elképesztő türkiz és mélykék színekben pompázik, és a mészben gazdag (karsztos) földalatti források, patakok (mint a Río Pojóm) táplálják. Nevét ('Vad Lagúna') onnan kapta, hogy az erős hegyi szelek gyakran veszélyes, felkorbácsolt hullámokat vetnek a felületén. A tavat sokáig csak a helyi indiánok ismerték, de ma már a legkalandvágyóbb ökoturisták (akik hajlandók órákig 4x4-es dzsipekkel rázkódni a sárban) is látogatják a rejtett vízesései és a híres 'cenoték' (beszakadt víznyelők) miatt. Földrajz K8 — nehezen megközelíthető karszttavak és határmenti természeti csodák.",
      de: "Die Laguna Brava, deren indigener Chuj-Name eigentlich 'Yolnabaj' lautet, ist ein spektakulärer Bergsee, versteckt an der Grenze zu Mexiko im äußersten Nordwesten des Departamentos Huehuetenango. Eingebettet in ein tiefes Tal des zerklüfteten Cuchumatanes-Gebirges, wird der See von steilen, dichten Kiefernwäldern umrahmt. Das extrem kalte, kristallklare Wasser schimmert je nach Sonneneinstrahlung intensiv türkis bis tiefblau. Seinen spanischen Namen 'Laguna Brava' (Der wütende See) erhielt das Gewässer, weil starke Bergwinde oft urplötzlich peitschende Wellen auf der Oberfläche erzeugen. Wegen der miserablen Straßen und der extremen Isolation der Region ist die Laguna Brava bis heute ein unberührtes Geheimnis geblieben. Die lokalen indigenen Gemeinden, die den Tourismus streng verwalten, setzen kleine Ruderboote ein, um Besucher über den See zu verborgenen Wasserfällen und Cenotes zu bringen. Geografie K8 — Alpine Bergseen."
    },
    factsAdvanced: {
      hu: ["A tó a mexikói határ közvetlen közelében fekszik, a 'Lagos de Montebello' (Chiapas) vízrendszerének guatemalai folytatása.", "Chuj maja nyelven 'Yolnabaj', a 'Brava' (Vad) nevet a szeles időben kialakuló veszélyes hullámai miatt kapta.", "A tó vizének türkizkék, olykor zöldes árnyalatát a talaj magas mészkő- (kálcium-karbonát) tartalma adja.", "Tengerszint feletti magassága 1 140 méter, klímája hűvös, gyakran nagyon párás és ködös.", "A tó déli részén hatalmas, cenote típusú víznyelők (mint az 'El Cimarrón') találhatók vízesésekkel.", "Csak extrém, saras földutakon, négykerék-meghajtású járművekkel (vagy hosszú gyalogtúrával) közelíthető meg Nentón községből."],
      de: ["Die Laguna Brava (Yolnabaj) liegt extrem isoliert im Cuchumatanes-Gebirge nahe Mexiko.", "Die Temperatur des tiefblauen Wassers liegt oft nur wenige Grad über dem Gefrierpunkt.", "Starke, plötzliche Winde erzeugen hohe Wellen, was dem See seinen Namen 'Wütender See' gab.", "Der See wird ausschließlich von den lokalen indigenen Gemeinden verwaltet und geschützt.", "Der Zugang erfordert extrem fähige Allradfahrzeuge (4x4) über gefährliche Bergpisten.", "Am Ufer gibt es keine Hotels, sondern nur einfaches Camping unter dem klaren Sternenhimmel."]
    },
    descriptionAdvanced: { de: "Die Laguna Brava, deren indigener Chuj-Name eigentlich 'Yolnabaj' lautet, ist ein spektakulärer Bergsee, versteckt an der Grenze zu Mexiko im äußersten Nordwesten des Departamentos Huehuetenango. Eingebettet in ein tiefes Tal des zerklüfteten Cuchumatanes-Gebirges, wird der See von steilen, dichten Kiefernwäldern umrahmt. Das extrem kalte, kristallklare Wasser schimmert je nach Sonneneinstrahlung intensiv türkis bis tiefblau. Seinen spanischen Namen 'Laguna Brava' (Der wütende See) erhielt das Gewässer, weil starke Bergwinde oft urplötzlich peitschende Wellen auf der Oberfläche erzeugen. Wegen der miserablen Straßen und der extremen Isolation der Region ist die Laguna Brava bis heute ein unberührtes Geheimnis geblieben. Die lokalen indigenen Gemeinden, die den Tourismus streng verwalten, setzen kleine Ruderboote ein, um Besucher über den See zu verborgenen Wasserfällen und Cenotes zu bringen. Geografie K8 — Alpine Bergseen.", hu: "Laguna Brava (Yolnabaj) Guatemala egyik figyelemre méltó pontja, ahol a maja örökség, a vulkáni felföld és az ország sokszínű kultúrája kézzelfoghatóan találkozik. Elzárt, festői tó a mexikói határ közelében, türkizkék vizéről ismert. Ugyanakkor Türkizkék víz. Emellett Közel a mexikói határhoz. A környéken Karszttó cenotékkal. Jellemző továbbá Nehezen megközelíthető. Mindezekkel együtt Laguna Brava (Yolnabaj) jól illeszkedik Guatemala összképébe, és megmutatja, mennyire szorosan kapcsolódik egymáshoz a maja kultúra, a vulkanikus felföld, valamint a kávé, a cukornád és a banán termesztése.", ro: "Laguna Brava (Yolnabaj) este un punct remarcabil al Guatemalei, unde moștenirea maya, peisajul vulcanic și diversitatea culturală a țării se întâlnesc într-un mod expresiv. Un lac pitoresc și izolat lângă granița cu Mexic, cunoscut pentru apa sa turcoaz. În același timp Apă de culoare turcoaz. Pe lângă acestea Aproape de granița cu Mexic. În zonă Lac carstic cu cenote. De asemenea Greu accesibil. Astfel, Laguna Brava (Yolnabaj) se încadrează firesc în imaginea de ansamblu a Guatemalei, arătând cât de strâns sunt legate cultura maya, peisajul vulcanic și cultivarea cafelei, a trestiei de zahăr și a bananelor.", en: "Laguna Brava (Yolnabaj) is a notable location in Guatemala where the rich Maya heritage, the volcanic highland landscape and the country's cultural diversity come together in a striking way. A remote, picturesque lake near the Mexican border, known for its turquoise waters. At the same time Turquoise water. In addition Near the Mexican border. In the surrounding area Karst lake with cenotes. Another characteristic feature Difficult to access. In this way, Laguna Brava (Yolnabaj) fits naturally into the wider picture of Guatemala, showing how closely Maya culture, the volcanic highlands and the cultivation of coffee, sugar cane and bananas are intertwined." },
    factsAdvanced: { de: ["Die Laguna Brava (Yolnabaj) liegt extrem isoliert im Cuchumatanes-Gebirge nahe Mexiko.", "Die Temperatur des tiefblauen Wassers liegt oft nur wenige Grad über dem Gefrierpunkt.", "Starke, plötzliche Winde erzeugen hohe Wellen, was dem See seinen Namen 'Wütender See' gab.", "Der See wird ausschließlich von den lokalen indigenen Gemeinden verwaltet und geschützt.", "Der Zugang erfordert extrem fähige Allradfahrzeuge (4x4) über gefährliche Bergpisten.", "Am Ufer gibt es keine Hotels, sondern nur einfaches Camping unter dem klaren Sternenhimmel."], hu: ["Türkizkék víz", "Közel a mexikói határhoz", "Karszttó cenotékkal", "Nehezen megközelíthető", "Guatemalában, a maja örökségéről ismert közép-amerikai országban található.", "Tükrözi a felföld, a Petén-medence és a Csendes-óceáni partvidék közötti régiójára jellemző sajátosságokat.", "Beleilleszkedik Guatemala vulkánjai, az Atitlán-tó és az olyan maja helyszínek, mint Tikal és Antigua alkotta kulturális mozaikba."], ro: ["Apă de culoare turcoaz", "Aproape de granița cu Mexic", "Lac carstic cu cenote", "Greu accesibil", "Se află în Guatemala, o țară central-americană cu o moștenire maya pronunțată.", "Reflectă trăsăturile tipice ale regiunii sale, situată între podișul înalt, bazinul Petén și coasta Pacificului.", "Se integrează în mozaicul guatemalez format din vulcani, lacuri precum Atitlán și situri maya precum Tikal și Antigua."], en: ["Turquoise water", "Near the Mexican border", "Karst lake with cenotes", "Difficult to access", "Located in Guatemala, a Central American country with a strong Maya heritage.", "Reflects features typical of its region between the highlands, the Petén lowlands and the Pacific coast.", "Set within Guatemala's mosaic of volcanoes, lakes such as Atitlán and Maya sites like Tikal and Antigua."] }, image: "/poi-images/laguna-brava-yolnabaj-nature-v2.webp"},
  {
    id: "volcan-chingo-nature-v2",
    type: "mountain",
    parent: "GT-JU",
    coords: [-89.728, 14.12],
    name: { de: "Volcán Chingo", hu: "Chingo-vulkán", ro: "Vulcanul Chingo", en: "Chingo Volcano" },
    description: { de: "Ein Vulkan, dessen Gipfel genau auf der Grenze zwischen Guatemala und El Salvador liegt.", hu: "Vulkán, amelynek csúcsa pontosan Guatemala és El Salvador határán fekszik.", ro: "Un vulcan al cărui vârf se află exact la granița dintre Guatemala și El Salvador.", en: "A volcano whose summit lies exactly on the border between Guatemala and El Salvador." },
    facts: {
      de: ["Gipfel auf der Staatsgrenze", "Teil der zentralamerikanischen Vulkankette", "Relativ einfacher Aufstieg", "Schlafender Vulkan"],
      hu: ["Csúcsa az államhatáron van", "A közép-amerikai vulkánlánc része", "Viszonylag könnyű megmászni", "Alvó vulkán"],
      ro: ["Vârf pe granița de stat", "Parte a lanțului vulcanic central-american", "Urcare relativ ușoară", "Vulcan adormit"],
      en: ["Summit is on the national border", "Part of the Central American Volcanic Arc", "Relatively easy climb", "Dormant volcano"]
    },
    descriptionAdvanced: {
      hu: "A Volcán Chingo egy gyönyörű, teljesen szimmetrikus, inaktív stratovulkán a guatemalai Jutiapa és a salvadori Santa Ana megye pontos határvonalán. A 1775 méter magas csúcs magát a geopolitikai határt ('mojón') jelöli a két ország között. Jutiapa megye forró, lapos szavannái (a Száraz Folyosó) közül kiemelkedő Chingo vulkánt mindkét ország lakói a sajátjuknak tekintik. Kialudt kráterében, amely már teljesen fűvel és fákkal benőtt, egy széles, lapos 'völgy' található, mely népszerű célpont a vulkántúrázók és a táborozók körében. Bár a vulkán békésen alszik a történelem előtti idők óta, tövéből ma is lávamezők (malpaís) és hőforrások bújnak elő a salvadori oldalon, emlékeztetve a táj heves vulkáni eredetére. A csúcsról tiszta időben az El Salvador-i Coatepeque-tó és a guatemalai síkságok is beláthatók. Földrajz K7 — határképző stratovulkánok és száraz-trópusi domborzat.",
      de: "Der Volcán Chingo ist ein nahezu perfekt geformter, konischer Schichtvulkan, der eine absolute geografische Besonderheit aufweist: Sein Gipfel markiert exakt die internationale Grenze zwischen Guatemala (Departamento Jutiapa) und El Salvador. Mit einer moderaten Höhe von rund 1.775 Metern dominiert er die ansonsten hügelige, heiße und semiaride Landschaft des östlichen Trockenkorridors. Ein Aufstieg zum Gipfel ist relativ einfach und wird oft von Wandergruppen durchgeführt. Oben angekommen, findet man in dem kleinen, grasbewachsenen Krater das offizielle Grenzmonument, das die beiden Nationen trennt. Der Vulkan ist nicht mehr aktiv, und seine sanften, bewaldeten Hänge werden intensiv für den Anbau von Kaffee und für die Viehzucht genutzt, die die Wirtschaft beiderseits der Grenze prägt. Geografie K7 — Grenzvulkane."
    },
    factsAdvanced: {
      hu: ["A vulkán csúcsa alkotja Guatemala (Jutiapa) és El Salvador hivatalos geopolitikai határát.", "Magassága 1 775 méter, ami a környező forró, alacsony (Oriente) síkságokból drámaian emelkedik ki.", "Teljesen inaktív stratovulkán, a történelem során nem jegyeztek fel kitörést róla.", "Krátere sekély, tágas és füves, tökéletes helyszín sátorozáshoz a túrázóknak.", "A guatemalai Jutiapa megye (La Cuna del Sol) egyik legismertebb vizuális szimbóluma.", "A hegy lábánál kiterjedt 'malpaís' (ősi, sziklás lávamezők) és elszórt kávéültetvények találhatók."],
      de: ["Der Gipfel des Volcán Chingo bildet die exakte Grenze zwischen Guatemala und El Salvador.", "Der Vulkan hat die perfekte Form eines Kegels (Estratovolcán) und ist nicht aktiv.", "Im kleinen Krater auf 1.775 Metern Höhe steht das offizielle Grenzmarkierungsmonument.", "Ein Aufstieg ist von der Ortschaft Zapotitlán (Guatemala) in wenigen Stunden machbar.", "Die Hänge sind dicht mit Eichen- und Kiefernwäldern sowie Kaffeefincas bewachsen.", "Das umliegende Klima ist das drückend heiße, trockene Klima des guatemaltekischen Ostens."]
    },
    descriptionAdvanced: { de: "Der Volcán Chingo ist ein nahezu perfekt geformter, konischer Schichtvulkan, der eine absolute geografische Besonderheit aufweist: Sein Gipfel markiert exakt die internationale Grenze zwischen Guatemala (Departamento Jutiapa) und El Salvador. Mit einer moderaten Höhe von rund 1.775 Metern dominiert er die ansonsten hügelige, heiße und semiaride Landschaft des östlichen Trockenkorridors. Ein Aufstieg zum Gipfel ist relativ einfach und wird oft von Wandergruppen durchgeführt. Oben angekommen, findet man in dem kleinen, grasbewachsenen Krater das offizielle Grenzmonument, das die beiden Nationen trennt. Der Vulkan ist nicht mehr aktiv, und seine sanften, bewaldeten Hänge werden intensiv für den Anbau von Kaffee und für die Viehzucht genutzt, die die Wirtschaft beiderseits der Grenze prägt. Geografie K7 — Grenzvulkane.", hu: "Chingo-vulkán Guatemala egyik figyelemre méltó pontja, ahol a maja örökség, a vulkáni felföld és az ország sokszínű kultúrája kézzelfoghatóan találkozik. Vulkán, amelynek csúcsa pontosan Guatemala és El Salvador határán fekszik. Ugyanakkor Csúcsa az államhatáron van. Emellett A közép-amerikai vulkánlánc része. A környéken Viszonylag könnyű megmászni. Jellemző továbbá Alvó vulkán. Mindezekkel együtt Chingo-vulkán jól illeszkedik Guatemala összképébe, és megmutatja, mennyire szorosan kapcsolódik egymáshoz a maja kultúra, a vulkanikus felföld, valamint a kávé, a cukornád és a banán termesztése.", ro: "Vulcanul Chingo este un punct remarcabil al Guatemalei, unde moștenirea maya, peisajul vulcanic și diversitatea culturală a țării se întâlnesc într-un mod expresiv. Un vulcan al cărui vârf se află exact la granița dintre Guatemala și El Salvador. În același timp Vârf pe granița de stat. Pe lângă acestea Parte a lanțului vulcanic central-american. În zonă Urcare relativ ușoară. De asemenea Vulcan adormit. Astfel, Vulcanul Chingo se încadrează firesc în imaginea de ansamblu a Guatemalei, arătând cât de strâns sunt legate cultura maya, peisajul vulcanic și cultivarea cafelei, a trestiei de zahăr și a bananelor.", en: "Chingo Volcano is a notable location in Guatemala where the rich Maya heritage, the volcanic highland landscape and the country's cultural diversity come together in a striking way. A volcano whose summit lies exactly on the border between Guatemala and El Salvador. At the same time Summit is on the national border. In addition Part of the Central American Volcanic Arc. In the surrounding area Relatively easy climb. Another characteristic feature Dormant volcano. In this way, Chingo Volcano fits naturally into the wider picture of Guatemala, showing how closely Maya culture, the volcanic highlands and the cultivation of coffee, sugar cane and bananas are intertwined." },
    factsAdvanced: { de: ["Der Gipfel des Volcán Chingo bildet die exakte Grenze zwischen Guatemala und El Salvador.", "Der Vulkan hat die perfekte Form eines Kegels (Estratovolcán) und ist nicht aktiv.", "Im kleinen Krater auf 1.775 Metern Höhe steht das offizielle Grenzmarkierungsmonument.", "Ein Aufstieg ist von der Ortschaft Zapotitlán (Guatemala) in wenigen Stunden machbar.", "Die Hänge sind dicht mit Eichen- und Kiefernwäldern sowie Kaffeefincas bewachsen.", "Das umliegende Klima ist das drückend heiße, trockene Klima des guatemaltekischen Ostens."], hu: ["Csúcsa az államhatáron van", "A közép-amerikai vulkánlánc része", "Viszonylag könnyű megmászni", "Alvó vulkán", "Guatemalában, a maja örökségéről ismert közép-amerikai országban található.", "Tükrözi a felföld, a Petén-medence és a Csendes-óceáni partvidék közötti régiójára jellemző sajátosságokat.", "Beleilleszkedik Guatemala vulkánjai, az Atitlán-tó és az olyan maja helyszínek, mint Tikal és Antigua alkotta kulturális mozaikba."], ro: ["Vârf pe granița de stat", "Parte a lanțului vulcanic central-american", "Urcare relativ ușoară", "Vulcan adormit", "Se află în Guatemala, o țară central-americană cu o moștenire maya pronunțată.", "Reflectă trăsăturile tipice ale regiunii sale, situată între podișul înalt, bazinul Petén și coasta Pacificului.", "Se integrează în mozaicul guatemalez format din vulcani, lacuri precum Atitlán și situri maya precum Tikal și Antigua."], en: ["Summit is on the national border", "Part of the Central American Volcanic Arc", "Relatively easy climb", "Dormant volcano", "Located in Guatemala, a Central American country with a strong Maya heritage.", "Reflects features typical of its region between the highlands, the Petén lowlands and the Pacific coast.", "Set within Guatemala's mosaic of volcanoes, lakes such as Atitlán and Maya sites like Tikal and Antigua."] }, image: "/poi-images/volcan-chingo-nature-v2.webp"},
  {
    id: "caribbean-sea-coast-nature-v2",
    type: "sea",
    parent: "GT-IZ",
    coords: [-88.65, 15.8],
    name: { de: "Karibikküste", hu: "Karib-tengerpart", ro: "Coasta Caraibelor", en: "Caribbean Coast" },
    description: { de: "Guatemalas kurzer, aber vielfältiger Küstenabschnitt am Karibischen Meer.", hu: "Guatemala rövid, de változatos tengerparti szakasza a Karib-tengernél.", ro: "Secțiunea de coastă scurtă, dar diversă, a Guatemalei la Marea Caraibilor.", en: "Guatemala's short but diverse coastal section on the Caribbean Sea." },
    facts: {
      de: ["Einziger Zugang zum Atlantik", "Heimat der Garifuna-Kultur", "Hafenstädte Puerto Barrios und Livingston", "Tropisches Klima"],
      hu: ["Egyetlen hozzáférés az Atlanti-óceánhoz", "A garifuna kultúra otthona", "Puerto Barrios és Livingston kikötővárosok", "Trópusi éghajlat"],
      ro: ["Singurul acces la Atlantic", "Casa culturii Garifuna", "Orașele portuare Puerto Barrios și Livingston", "Climă tropicală"],
      en: ["Only access to the Atlantic", "Home of the Garifuna culture", "Port towns of Puerto Barrios and Livingston", "Tropical climate"]
    },
    descriptionAdvanced: {
      hu: "Guatemala karib-tengeri partvidéke (Izabal megye, az Amatique-öböl környékén) drasztikusan különbözik az ország sötét homokos, nyílt és haragos csendes-óceáni partjaitól. A karibi part (Puerto Barrios, Livingston, Punta de Manabique) rövid, alig 148 km hosszú, de biológiailag a leggazdagabb tengerparti ökoszisztéma Guatemalában. Az öblöt pálmafás, fehér vagy aranyszínű homokos strandok, sűrű mangroveerdők, kiterjedt tengerifű-mezők (pastos marinos) és kis kiterjedésű, ám gazdag korallzátonyok (Arrecifes de la Corona) jellemzik. A Karib-tenger itt csendes, meleg és sekély. Ezt a lenyűgöző partvidéket a garífuna (afro-karibi) és q'eqchi' maja kultúrák teszik egyedivé, akiknek élete szorosan összefonódik a tengeri halászattal (barrakuda, rák) és a kókuszdión alapuló hagyományos gasztronómiával. Földrajz K6 — a Karib-tengeri ökoszisztémák és az öblök dinamikája.",
      de: "Die guatemaltekische Karibikküste, gelegen im Departamento Izabal, ist kurz (nur etwa 148 Kilometer), aber ökologisch und kulturell von massiver Bedeutung. Sie erstreckt sich von der honduranischen Grenze bei Puerto Barrios, um die geschützte Bucht von Amatique, bis hin zur Belize-Grenze am Fluss Sarstún. Im Gegensatz zu den vulkanischen schwarzen Stränden am Pazifik, bietet die Karibikküste stellenweise weiße Sandstrände (wie Playa Blanca in Livingston) und kristallklares Wasser. Diese Küste ist das Epizentrum der afrokaribischen Garífuna-Kultur und die Heimat der einzigen nennenswerten Korallenriffe Guatemalas, insbesondere vor der geschützten Halbinsel Punta de Manabique. Die Küste dient als wichtigster Ausfuhrweg in den Atlantik, ist jedoch ironischerweise extrem vom Plastikmüll bedroht, den der Río Motagua vom Landesinneren direkt in die Bucht von Omoa spült. Ökologie K8 — Karibische Küstensysteme und Verschmutzung."
    },
    factsAdvanced: {
      hu: ["Guatemala karib-tengeri partvidéke csupán kb. 148 kilométer hosszú Izabal megyében.", "A tengerpart zöme védett a nyílt óceántól, így az Amatique-öböl vize csendes, meleg és viszonylag sekély.", "Élőhelye a veszélyeztetett karibi manátuszoknak (tengeri tehenek) a gazdag tengerifű-mezőknek köszönhetően.", "A part mentén található a kis kiterjedésű, de biológiailag diverz guatemalai korallzátony (Arrecifes Punta de Manabique).", "A karibi part fehér vagy világos homokos, ellentétben a csendes-óceáni partok fekete vulkáni homokjával.", "A partszakasz főként csak hajóval (lanchas) közelíthető meg Puerto Barriosból (pl. Livingston irányába)."],
      de: ["Guatemala hat eine sehr kurze Küstenlinie zur Karibik von nur knapp 148 Kilometern.", "Die wichtigste geologische Formation ist die riesige, seichte Bucht von Amatique.", "Vor der Küste (Punta de Manabique) liegen die einzigen nennenswerten Korallenriffe des Landes.", "Die Stadt Livingston ist die einzige Hafenstadt mit reinem Karibik-Flair und Garífuna-Kultur.", "Hier befinden sich die beiden wichtigsten atlantischen Exporthäfen: Puerto Barrios und Santo Tomás.", "Plastikmüll, der vom Río Motagua ins Meer gespült wird, bedroht massiv die Riffe und Strände."]
    },
    descriptionAdvanced: { de: "Die guatemaltekische Karibikküste, gelegen im Departamento Izabal, ist kurz (nur etwa 148 Kilometer), aber ökologisch und kulturell von massiver Bedeutung. Sie erstreckt sich von der honduranischen Grenze bei Puerto Barrios, um die geschützte Bucht von Amatique, bis hin zur Belize-Grenze am Fluss Sarstún. Im Gegensatz zu den vulkanischen schwarzen Stränden am Pazifik, bietet die Karibikküste stellenweise weiße Sandstrände (wie Playa Blanca in Livingston) und kristallklares Wasser. Diese Küste ist das Epizentrum der afrokaribischen Garífuna-Kultur und die Heimat der einzigen nennenswerten Korallenriffe Guatemalas, insbesondere vor der geschützten Halbinsel Punta de Manabique. Die Küste dient als wichtigster Ausfuhrweg in den Atlantik, ist jedoch ironischerweise extrem vom Plastikmüll bedroht, den der Río Motagua vom Landesinneren direkt in die Bucht von Omoa spült. Ökologie K8 — Karibische Küstensysteme und Verschmutzung.", hu: "Karib-tengerpart Guatemala egyik figyelemre méltó pontja, ahol a maja örökség, a vulkáni felföld és az ország sokszínű kultúrája kézzelfoghatóan találkozik. Guatemala rövid, de változatos tengerparti szakasza a Karib-tengernél. Ugyanakkor Egyetlen hozzáférés az Atlanti-óceánhoz. Emellett A garifuna kultúra otthona. A környéken Puerto Barrios és Livingston kikötővárosok. Jellemző továbbá Trópusi éghajlat. Mindezekkel együtt Karib-tengerpart jól illeszkedik Guatemala összképébe, és megmutatja, mennyire szorosan kapcsolódik egymáshoz a maja kultúra, a vulkanikus felföld, valamint a kávé, a cukornád és a banán termesztése.", ro: "Coasta Caraibelor este un punct remarcabil al Guatemalei, unde moștenirea maya, peisajul vulcanic și diversitatea culturală a țării se întâlnesc într-un mod expresiv. Secțiunea de coastă scurtă, dar diversă, a Guatemalei la Marea Caraibilor. În același timp Singurul acces la Atlantic. Pe lângă acestea Casa culturii Garifuna. În zonă Orașele portuare Puerto Barrios și Livingston. De asemenea Climă tropicală. Astfel, Coasta Caraibelor se încadrează firesc în imaginea de ansamblu a Guatemalei, arătând cât de strâns sunt legate cultura maya, peisajul vulcanic și cultivarea cafelei, a trestiei de zahăr și a bananelor.", en: "Caribbean Coast is a notable location in Guatemala where the rich Maya heritage, the volcanic highland landscape and the country's cultural diversity come together in a striking way. Guatemala's short but diverse coastal section on the Caribbean Sea. At the same time Only access to the Atlantic. In addition Home of the Garifuna culture. In the surrounding area Port towns of Puerto Barrios and Livingston. Another characteristic feature Tropical climate. In this way, Caribbean Coast fits naturally into the wider picture of Guatemala, showing how closely Maya culture, the volcanic highlands and the cultivation of coffee, sugar cane and bananas are intertwined." },
    factsAdvanced: { de: ["Guatemala hat eine sehr kurze Küstenlinie zur Karibik von nur knapp 148 Kilometern.", "Die wichtigste geologische Formation ist die riesige, seichte Bucht von Amatique.", "Vor der Küste (Punta de Manabique) liegen die einzigen nennenswerten Korallenriffe des Landes.", "Die Stadt Livingston ist die einzige Hafenstadt mit reinem Karibik-Flair und Garífuna-Kultur.", "Hier befinden sich die beiden wichtigsten atlantischen Exporthäfen: Puerto Barrios und Santo Tomás.", "Plastikmüll, der vom Río Motagua ins Meer gespült wird, bedroht massiv die Riffe und Strände."], hu: ["Egyetlen hozzáférés az Atlanti-óceánhoz", "A garifuna kultúra otthona", "Puerto Barrios és Livingston kikötővárosok", "Trópusi éghajlat", "Guatemalában, a maja örökségéről ismert közép-amerikai országban található.", "Tükrözi a felföld, a Petén-medence és a Csendes-óceáni partvidék közötti régiójára jellemző sajátosságokat.", "Beleilleszkedik Guatemala vulkánjai, az Atitlán-tó és az olyan maja helyszínek, mint Tikal és Antigua alkotta kulturális mozaikba."], ro: ["Singurul acces la Atlantic", "Casa culturii Garifuna", "Orașele portuare Puerto Barrios și Livingston", "Climă tropicală", "Se află în Guatemala, o țară central-americană cu o moștenire maya pronunțată.", "Reflectă trăsăturile tipice ale regiunii sale, situată între podișul înalt, bazinul Petén și coasta Pacificului.", "Se integrează în mozaicul guatemalez format din vulcani, lacuri precum Atitlán și situri maya precum Tikal și Antigua."], en: ["Only access to the Atlantic", "Home of the Garifuna culture", "Port towns of Puerto Barrios and Livingston", "Tropical climate", "Located in Guatemala, a Central American country with a strong Maya heritage.", "Reflects features typical of its region between the highlands, the Petén lowlands and the Pacific coast.", "Set within Guatemala's mosaic of volcanoes, lakes such as Atitlán and Maya sites like Tikal and Antigua."] }, image: "/poi-images/caribbean-sea-coast-nature-v2.webp"},
  {
    id: "pacific-coast-guatemala-nature-v2",
    type: "sea",
    parent: "GT-ES",
    coords: [-91.5, 13.85],
    name: { de: "Pazifikküste", hu: "Csendes-óceáni partvidék", ro: "Coasta Pacificului", en: "Pacific Coast" },
    description: { de: "Die lange Pazifikküste Guatemalas mit schwarzen Sandstränden und starken Wellen.", hu: "Guatemala hosszú csendes-óceáni partvidéke fekete homokos strandokkal és erős hullámokkal.", ro: "Coasta lungă a Pacificului din Guatemala, cu plaje de nisip negru și valuri puternice.", en: "The long Pacific coast of Guatemala, with black sand beaches and strong waves." },
    facts: {
      de: ["Schwarze Vulkansandstrände", "Wichtig für Fischerei und Salzgewinnung", "Starke Brandung", "Hafen von Puerto Quetzal"],
      hu: ["Fekete vulkáni homokos strandok", "Fontos a halászat és a sókitermelés szempontjából", "Erős hullámzás", "Puerto Quetzal kikötője"],
      ro: ["Plaje de nisip vulcanic negru", "Important pentru pescuit și extracția sării", "Valuri puternice", "Portul Puerto Quetzal"],
      en: ["Black volcanic sand beaches", "Important for fishing and salt production", "Strong surf", "Port of Puerto Quetzal"]
    },
    descriptionAdvanced: {
      hu: "Guatemala csendes-óceáni partvidéke (La Costa Sur) egy közel 250 kilométer hosszú, egyenes és drámai vonal, amely a mexikói határtól (San Marcos) az El Salvador-i határig (Jutiapa) húzódik. Ezt a partot szinte teljes egészében fekete, vulkáni hamuból álló, vasban gazdag finom homok borítja, amelyet a belső Altiplano hatalmas vulkánjaiból az esők és folyók hordtak le évmilliók alatt. A Csendes-óceán ('Océano Pacífico') itt nevével ellentétben vad és veszélyes: nincsenek védett öblök vagy szigetek, a nyílt óceáni áramlatok hatalmas hullámokat ('olas') és hírhedten erős visszahúzó áramlatokat ('alfaques') generálnak, így a partvidék a szörfösök (pl. El Paredón) paradicsoma, de komoly veszélyt jelent a gyakorlatlan fürdőzőkre. A part mentén hatalmas mangrove-mocsarak és torkolatrendszerek (Canal de Chiquimulilla) védik a szárazföldet az óceán pusztító erejétől. Földrajz K7 — vulkáni homokos tengerpartok és óceáni áramlatok.",
      de: "Die Pazifikküste Guatemalas erstreckt sich über 250 Kilometer geradlinig von der mexikanischen bis zur salvadorianischen Grenze. Sie zeichnet sich durch endlose, offene Strände aus extrem feinem, kohlrabenschwarzem Vulkansand aus, der durch die Erosion der Vulkankette im Landesinneren dorthin getragen wird. Diese Küste ist wild, brandungsreich und gefährlich zum Schwimmen, was sie jedoch paradoxerweise (besonders Orte wie El Paredón) zu einem echten Paradies für internationale Surfer gemacht hat. Hinter den Stränden verläuft oft ein komplexes System aus Mangrovensümpfen und Lagunen (wie der Canal de Chiquimulilla), das als natürlicher Puffer dient und seltene Krokodile und Reiher beherbergt. Wirtschaftlich ist die Region durch kleine Fischereidörfer und riesige Salinen geprägt, die das Meersalz traditionell in großen Becken durch Sonnenwärme verdunsten lassen. Geografie K7 — Vulkanische Küstenlandschaften."
    },
    factsAdvanced: {
      hu: ["A guatemalai csendes-óceáni part szinte 100%-ban vasban gazdag, fekete vulkáni homokból áll.", "A partvonal több mint 250 km hosszú, szinte teljesen egyenes, öblök és természetes kikötők nélkül.", "A nyílt óceáni hullámzás ('resaca') eta miatt rendkívül eros a visszahúzó áramlat (alfaques), ami sok vízi balesetet okoz.", "Világszerte egyre népszerűbb a hullámlovasok (szörfösök) körében (pl. El Paredón, Sipacate strandjai).", "A tengerpart mögött hosszan elnyúló lagúna- és mangroverendszer, a Canal de Chiquimulilla húzódik.", "Ezen a partvidéken (pl. Monterrico) tízezrével fészkelnek az olajzöld és a hatalmas kérgesteknősök."],
      de: ["Die Strände am Pazifik bestehen fast ausschließlich aus eisenhaltigem, schwarzem Vulkansand.", "Der Sand wird in der tropischen Mittagssonne so heiß, dass man nicht barfuß darauf laufen kann.", "Surferorte wie El Paredón sind aufgrund der perfekten pazifischen Wellen (Swells) weltberühmt.", "Die Pazifikküste ist berüchtigt für extrem starke, oft tödliche Unterströmungen (Alfaques).", "Ein großes, paralleles Mangrovensystem trennt das offene Meer oft vom Landesinneren.", "Riesige Salinen in der Region extrahieren Meersalz durch natürliche Verdunstung."]
    },
    descriptionAdvanced: { de: "Die Pazifikküste Guatemalas erstreckt sich über 250 Kilometer geradlinig von der mexikanischen bis zur salvadorianischen Grenze. Sie zeichnet sich durch endlose, offene Strände aus extrem feinem, kohlrabenschwarzem Vulkansand aus, der durch die Erosion der Vulkankette im Landesinneren dorthin getragen wird. Diese Küste ist wild, brandungsreich und gefährlich zum Schwimmen, was sie jedoch paradoxerweise (besonders Orte wie El Paredón) zu einem echten Paradies für internationale Surfer gemacht hat. Hinter den Stränden verläuft oft ein komplexes System aus Mangrovensümpfen und Lagunen (wie der Canal de Chiquimulilla), das als natürlicher Puffer dient und seltene Krokodile und Reiher beherbergt. Wirtschaftlich ist die Region durch kleine Fischereidörfer und riesige Salinen geprägt, die das Meersalz traditionell in großen Becken durch Sonnenwärme verdunsten lassen. Geografie K7 — Vulkanische Küstenlandschaften.", hu: "Csendes-óceáni partvidék Guatemala egyik figyelemre méltó pontja, ahol a maja örökség, a vulkáni felföld és az ország sokszínű kultúrája kézzelfoghatóan találkozik. Guatemala hosszú csendes-óceáni partvidéke fekete homokos strandokkal és erős hullámokkal. Ugyanakkor Fekete vulkáni homokos strandok. Emellett Fontos a halászat és a sókitermelés szempontjából. A környéken Erős hullámzás. Jellemző továbbá Puerto Quetzal kikötője. Mindezekkel együtt Csendes-óceáni partvidék jól illeszkedik Guatemala összképébe, és megmutatja, mennyire szorosan kapcsolódik egymáshoz a maja kultúra, a vulkanikus felföld, valamint a kávé, a cukornád és a banán termesztése.", ro: "Coasta Pacificului este un punct remarcabil al Guatemalei, unde moștenirea maya, peisajul vulcanic și diversitatea culturală a țării se întâlnesc într-un mod expresiv. Coasta lungă a Pacificului din Guatemala, cu plaje de nisip negru și valuri puternice. În același timp Plaje de nisip vulcanic negru. Pe lângă acestea Important pentru pescuit și extracția sării. În zonă Valuri puternice. De asemenea Portul Puerto Quetzal. Astfel, Coasta Pacificului se încadrează firesc în imaginea de ansamblu a Guatemalei, arătând cât de strâns sunt legate cultura maya, peisajul vulcanic și cultivarea cafelei, a trestiei de zahăr și a bananelor.", en: "Pacific Coast is a notable location in Guatemala where the rich Maya heritage, the volcanic highland landscape and the country's cultural diversity come together in a striking way. The long Pacific coast of Guatemala, with black sand beaches and strong waves. At the same time Black volcanic sand beaches. In addition Important for fishing and salt production. In the surrounding area Strong surf. Another characteristic feature Port of Puerto Quetzal. In this way, Pacific Coast fits naturally into the wider picture of Guatemala, showing how closely Maya culture, the volcanic highlands and the cultivation of coffee, sugar cane and bananas are intertwined." },
    factsAdvanced: { de: ["Die Strände am Pazifik bestehen fast ausschließlich aus eisenhaltigem, schwarzem Vulkansand.", "Der Sand wird in der tropischen Mittagssonne so heiß, dass man nicht barfuß darauf laufen kann.", "Surferorte wie El Paredón sind aufgrund der perfekten pazifischen Wellen (Swells) weltberühmt.", "Die Pazifikküste ist berüchtigt für extrem starke, oft tödliche Unterströmungen (Alfaques).", "Ein großes, paralleles Mangrovensystem trennt das offene Meer oft vom Landesinneren.", "Riesige Salinen in der Region extrahieren Meersalz durch natürliche Verdunstung."], hu: ["Fekete vulkáni homokos strandok", "Fontos a halászat és a sókitermelés szempontjából", "Erős hullámzás", "Puerto Quetzal kikötője", "Guatemalában, a maja örökségéről ismert közép-amerikai országban található.", "Tükrözi a felföld, a Petén-medence és a Csendes-óceáni partvidék közötti régiójára jellemző sajátosságokat.", "Beleilleszkedik Guatemala vulkánjai, az Atitlán-tó és az olyan maja helyszínek, mint Tikal és Antigua alkotta kulturális mozaikba."], ro: ["Plaje de nisip vulcanic negru", "Important pentru pescuit și extracția sării", "Valuri puternice", "Portul Puerto Quetzal", "Se află în Guatemala, o țară central-americană cu o moștenire maya pronunțată.", "Reflectă trăsăturile tipice ale regiunii sale, situată între podișul înalt, bazinul Petén și coasta Pacificului.", "Se integrează în mozaicul guatemalez format din vulcani, lacuri precum Atitlán și situri maya precum Tikal și Antigua."], en: ["Black volcanic sand beaches", "Important for fishing and salt production", "Strong surf", "Port of Puerto Quetzal", "Located in Guatemala, a Central American country with a strong Maya heritage.", "Reflects features typical of its region between the highlands, the Petén lowlands and the Pacific coast.", "Set within Guatemala's mosaic of volcanoes, lakes such as Atitlán and Maya sites like Tikal and Antigua."] }, image: "/poi-images/pacific-coast-guatemala-nature-v2.webp"},
  {
    id: "ceibal-forest-reserve-nature-v2",
    type: "forest",
    parent: "GT-PE",
    coords: [-90.057, 16.516],
    name: { de: "Waldreservat Ceibal", hu: "Ceibal Erdőrezervátum", ro: "Rezervația forestieră Ceibal", en: "Ceibal Forest Reserve" },
    description: { de: "Das Waldgebiet um die archäologische Stätte Ceibal, reich an Ceiba-Bäumen.", hu: "A Ceibal régészeti lelőhely körüli erdőterület, amely gazdag ceiba fákban.", ro: "Zona împădurită din jurul sitului arheologic Ceibal, bogată în copaci Ceiba.", en: "The forest area surrounding the Ceibal archaeological site, rich in ceiba trees." },
    facts: {
      de: ["Schützt die Maya-Stätte Ceibal", "Hohe Ceiba-Bäume (Nationalbaum)", "Tropischer Regenwald", "An den Ufern des Río de la Pasión"],
      hu: ["Védi a Ceibal maja lelőhelyet", "Magas ceiba fák (nemzeti fa)", "Trópusi esőerdő", "A La Pasión-folyó partján"],
      ro: ["Protejează situl mayaș Ceibal", "Copaci Ceiba înalți (copacul național)", "Pădure tropicală umedă", "Pe malurile râului Pasión"],
      en: ["Protects the Ceibal Maya site", "Tall Ceiba trees (national tree)", "Tropical rainforest", "On the banks of the Pasión River"]
    },
    descriptionAdvanced: {
      hu: "A Ceibal (vagy Seibal) Régészeti Parkot övező trópusi erdőrezervátum (Reserva Cultural y Natural Ceibal) Petén megyében a Río La Pasión meredek mészkőpartjain terül el. A rezervátum nemcsak az egyedülálló klasszikus maja romok és sztélék megőrzését szolgálja, hanem a guatemalai dzsungel utolsó érintetlen szigeteinek egyike a gyorsan terjeszkedő pálmaolaj-ültetvények tengerében. Az erdőt olyan óriási fák uralják, mint a mahagóni (caoba), a guatemalai nemzeti fa, a hatalmas gyökerekkel kapaszkodó Ceiba, és a cédrus (cedro). Az érintetlen lombsátor kiváló menedéket nyújt a bőgőmajmoknak (saraguatos) – akiknek üvöltése kísértetiesen visszhangzik a kősztélék között –, valamint a tukánoknak és jaguároknak. A park csak hosszú folyami csónakúttal, vagy nehéz terepen közelíthető meg Sayaxchéből. Földrajz K7 — folyóparti esőerdők és a trópusi keményfák védelme.",
      de: "Tief im Dschungel des Departamentos Petén, verborgen an den Ufern des Río La Pasión, liegt das Waldreservat und die archäologische Stätte Ceibal (oder Seibal). Ceibal war eine der größten Städte der Maya in der klassischen Periode und erlebte eine ungewöhnliche Blütezeit im späten 9. Jahrhundert, als viele andere Maya-Städte bereits im mysteriösen Zusammenbruch (dem sogenannten 'Kollaps') begriffen waren. Der dichte Wald schützt nicht nur die exquisiten, extrem detaillierten Stelen (Steinsäulen), die Herrscher mit fremdartigen (mexikanischen) Gesichtszügen zeigen, sondern ist auch ein wichtiges biologisches Refugium. Gewaltige Ceiba-Bäume (der Nationalbaum) und alte Mahagoni-Wälder bieten Lebensraum für laute Brüllaffen-Familien, Tukane und Pumas. Das Reservat verbindet so den Schutz prähispanischer Kunst mit der Bewahrung des Regenwald-Ökosystems entlang der Flussroute. Biologie K8 — Regenwald-Reservate."
    },
    factsAdvanced: {
      hu: ["A rezervátum a Pásión-folyó (Río La Pasión) kanyarulatában egy mészkő magaslaton terül el.", "Az erdőt a nevét adó gigantikus Ceiba (kapok) fák (a maják világfája) uralják.", "Jelentős menedék a bőgőmajmok (monos aulladores) és a pókmajmok (monos araña) számára.", "A rezervátum szigetszerűen maradt fenn a környék erőszakos erdőirtásai (pálmaolaj) ellenére.", "Az esőerdő sűrű lombozata és fojtófügéi (matapalos) szorosan körbefonják az itteni maja romokat.", "A trópusi esőerdő és a történelmi örökség ('patrimonio mixto') együttes és integrált védelmét szolgálja."],
      de: ["Das Ceibal-Reservat schützt sowohl eine wichtige Maya-Stätte als auch den umliegenden Primärwald.", "Es liegt am Ufer des Río La Pasión und ist am besten per Boot von Sayaxché zu erreichen.", "Der Name stammt von den gigantischen, heiligen Ceiba-Bäumen, die in der Region wachsen.", "Ceibal erlebte seinen historischen Höhepunkt, als andere Maya-Städte bereits kollabierten (ca. 850 n. Chr.).", "Der dichte Dschungel hier ist ein erstklassiger Ort zur Beobachtung von wilden Brüllaffen.", "Das Gebiet kämpft ständig gegen illegale Eindringlinge, die Edelhölzer stehlen wollen."]
    },
    descriptionAdvanced: { de: "Tief im Dschungel des Departamentos Petén, verborgen an den Ufern des Río La Pasión, liegt das Waldreservat und die archäologische Stätte Ceibal (oder Seibal). Ceibal war eine der größten Städte der Maya in der klassischen Periode und erlebte eine ungewöhnliche Blütezeit im späten 9. Jahrhundert, als viele andere Maya-Städte bereits im mysteriösen Zusammenbruch (dem sogenannten 'Kollaps') begriffen waren. Der dichte Wald schützt nicht nur die exquisiten, extrem detaillierten Stelen (Steinsäulen), die Herrscher mit fremdartigen (mexikanischen) Gesichtszügen zeigen, sondern ist auch ein wichtiges biologisches Refugium. Gewaltige Ceiba-Bäume (der Nationalbaum) und alte Mahagoni-Wälder bieten Lebensraum für laute Brüllaffen-Familien, Tukane und Pumas. Das Reservat verbindet so den Schutz prähispanischer Kunst mit der Bewahrung des Regenwald-Ökosystems entlang der Flussroute. Biologie K8 — Regenwald-Reservate.", hu: "Ceibal Erdőrezervátum Guatemala egyik figyelemre méltó pontja, ahol a maja örökség, a vulkáni felföld és az ország sokszínű kultúrája kézzelfoghatóan találkozik. A Ceibal régészeti lelőhely körüli erdőterület, amely gazdag ceiba fákban. Ugyanakkor Védi a Ceibal maja lelőhelyet. Emellett Magas ceiba fák (nemzeti fa). A környéken Trópusi esőerdő. Jellemző továbbá A La Pasión-folyó partján. Mindezekkel együtt Ceibal Erdőrezervátum jól illeszkedik Guatemala összképébe, és megmutatja, mennyire szorosan kapcsolódik egymáshoz a maja kultúra, a vulkanikus felföld, valamint a kávé, a cukornád és a banán termesztése.", ro: "Rezervația forestieră Ceibal este un punct remarcabil al Guatemalei, unde moștenirea maya, peisajul vulcanic și diversitatea culturală a țării se întâlnesc într-un mod expresiv. Zona împădurită din jurul sitului arheologic Ceibal, bogată în copaci Ceiba. În același timp Protejează situl mayaș Ceibal. Pe lângă acestea Copaci Ceiba înalți (copacul național). În zonă Pădure tropicală umedă. De asemenea Pe malurile râului Pasión. Astfel, Rezervația forestieră Ceibal se încadrează firesc în imaginea de ansamblu a Guatemalei, arătând cât de strâns sunt legate cultura maya, peisajul vulcanic și cultivarea cafelei, a trestiei de zahăr și a bananelor.", en: "Ceibal Forest Reserve is a notable location in Guatemala where the rich Maya heritage, the volcanic highland landscape and the country's cultural diversity come together in a striking way. The forest area surrounding the Ceibal archaeological site, rich in ceiba trees. At the same time Protects the Ceibal Maya site. In addition Tall Ceiba trees (national tree). In the surrounding area Tropical rainforest. Another characteristic feature On the banks of the Pasión River. In this way, Ceibal Forest Reserve fits naturally into the wider picture of Guatemala, showing how closely Maya culture, the volcanic highlands and the cultivation of coffee, sugar cane and bananas are intertwined." },
    factsAdvanced: { de: ["Das Ceibal-Reservat schützt sowohl eine wichtige Maya-Stätte als auch den umliegenden Primärwald.", "Es liegt am Ufer des Río La Pasión und ist am besten per Boot von Sayaxché zu erreichen.", "Der Name stammt von den gigantischen, heiligen Ceiba-Bäumen, die in der Region wachsen.", "Ceibal erlebte seinen historischen Höhepunkt, als andere Maya-Städte bereits kollabierten (ca. 850 n. Chr.).", "Der dichte Dschungel hier ist ein erstklassiger Ort zur Beobachtung von wilden Brüllaffen.", "Das Gebiet kämpft ständig gegen illegale Eindringlinge, die Edelhölzer stehlen wollen."], hu: ["Védi a Ceibal maja lelőhelyet", "Magas ceiba fák (nemzeti fa)", "Trópusi esőerdő", "A La Pasión-folyó partján", "Guatemalában, a maja örökségéről ismert közép-amerikai országban található.", "Tükrözi a felföld, a Petén-medence és a Csendes-óceáni partvidék közötti régiójára jellemző sajátosságokat.", "Beleilleszkedik Guatemala vulkánjai, az Atitlán-tó és az olyan maja helyszínek, mint Tikal és Antigua alkotta kulturális mozaikba."], ro: ["Protejează situl mayaș Ceibal", "Copaci Ceiba înalți (copacul național)", "Pădure tropicală umedă", "Pe malurile râului Pasión", "Se află în Guatemala, o țară central-americană cu o moștenire maya pronunțată.", "Reflectă trăsăturile tipice ale regiunii sale, situată între podișul înalt, bazinul Petén și coasta Pacificului.", "Se integrează în mozaicul guatemalez format din vulcani, lacuri precum Atitlán și situri maya precum Tikal și Antigua."], en: ["Protects the Ceibal Maya site", "Tall Ceiba trees (national tree)", "Tropical rainforest", "On the banks of the Pasión River", "Located in Guatemala, a Central American country with a strong Maya heritage.", "Reflects features typical of its region between the highlands, the Petén lowlands and the Pacific coast.", "Set within Guatemala's mosaic of volcanoes, lakes such as Atitlán and Maya sites like Tikal and Antigua."] }, image: "/poi-images/ceibal-forest-reserve-nature-v2.webp"},
  {
    id: "laguna-de-ayarza-nature-v2",
    type: "lake",
    parent: "GT-SR",
    coords: [-90.13, 14.42],
    name: { de: "Laguna de Ayarza", hu: "Ayarza-lagúna", ro: "Laguna de Ayarza", en: "Laguna de Ayarza" },
    description: { de: "Ein tiefblauer Kratersee, der in einer Zwillingscaldera vulkanischen Ursprungs liegt.", hu: "Mélykék krátertó, amely egy vulkanikus eredetű ikerkalderában fekszik.", ro: "Un lac de crater de un albastru intens, situat într-o calderă dublă de origine vulcanică.", en: "A deep blue crater lake located in a twin caldera of volcanic origin." },
    facts: {
      de: ["Vulkanische Caldera", "Sehr tief (bis zu 230m)", "Klares, blaues Wasser", "Wenig touristisch erschlossen"],
      hu: ["Vulkáni kaldera", "Nagyon mély (akár 230 m)", "Tiszta, kék víz", "Kevéssé turisztikai célpont"],
      ro: ["Calderă vulcanică", "Foarte adânc (până la 230m)", "Apă limpede, albastră", "Puțin dezvoltat turistic"],
      en: ["Volcanic caldera", "Very deep (up to 230m)", "Clear, blue water", "Not very touristy"]
    },
    descriptionAdvanced: {
      hu: "A Laguna de Ayarza (Ayarza-tó) egy ikerkráter-tó, amely Santa Rosa megye hegyei között, Casillas és San Rafael Las Flores községek határán bújik meg. A tó vulkanikus eredetű, körülbelül 20 000 évvel ezelőtt alakult ki egy hatalmas, két kamrás vulkáni robbanás nyomán. Tengerszint feletti magassága 1400 méter körüli, így a víz hűvös, tiszta és mély (akár 230 méter is lehet). A tavat szinte függőleges sziklafalak veszik körül, amelyeken csak gyalogösvényeken vagy négykerék-meghajtású járművekkel lehet leereszkedni. A helyi legenda szerint a tónak nincs feneke, és a víz alatt egy ősi elsüllyedt falu fekszik. Ma a Laguna de Ayarza népszerű a sporthorgászok, búvárok és a nyugalomra vágyó kalandturisták körében, mivel elszigeteltsége miatt mentes a tömegturizmustól. Földrajz K8 — vulkáni krátertavak (kalderák) és hidrogeológia.",
      de: "Die Laguna de Ayarza in den Bergen des Departamentos Santa Rosa ist ein geologisches Mysterium und eines der tiefsten Gewässer Mittelamerikas. Geformt wie eine gigantische 8, besteht der See aus zwei zusammengewachsenen Vulkankratern (Doppel-Caldera), die vor Tausenden von Jahren bei einer extrem gewaltigen Eruption entstanden sind. Das Wasser ist tief, unheimlich dunkelblau und sehr kalt, da der See auf einer Höhe von fast 1.400 Metern liegt. Lange Zeit mieden die Einheimischen den See, da Legenden behaupten, er sei bodenlos oder werde von großen Schlangenungeheuern bewohnt. Wegen der enormen Tiefe (schätzungsweise über 200 Meter) und der steilen, felsigen Ufer gibt es hier kaum konventionellen Tourismus, sondern der See wird oft für technisches Tauchen und geologische Forschungen genutzt. Kaffeeanbau prägt die Hänge rund um das Gewässer. Geografie K8 — Doppel-Calderen."
    },
    factsAdvanced: {
      hu: ["A tó vulkáni kaldera, amely két egybeolvadt kráterből (iker-kráter) jött létre kb. 20 000 éve.", "Santa Rosa megyében fekszik, 1 410 méteres tengerszint feletti magasságban.", "Rendkívül mély, a mérések szerint a mélysége eléri a 230 métert (egyesek szerint a 250 métert is).", "Meredek sziklafalak veszik körül, így megközelítése (leereszkedés a vízhez) nehézkes.", "Népszerű a búvárok körében, akik a tiszta vízben és a meredek mélyben edzenek.", "A helyi legendák egy feneketlen tóról és egy víz alatti ősi városról (vagy szörnyről) szólnak."],
      de: ["Die Laguna de Ayarza ist eine Doppel-Caldera, entstanden aus dem Einsturz zweier Vulkankrater.", "Mit einer geschätzten Tiefe von weit über 200 Metern ist es einer der tiefsten Seen Zentralamerikas.", "Das Wasser hat aufgrund der extremen Tiefe eine unnatürlich dunkelblaue Farbe.", "Der See liegt in Santa Rosa, einer Region, die sonst für Hitze und Landwirtschaft bekannt ist.", "Steile Felswände fallen an vielen Stellen hunderte Meter tief fast senkrecht ins Wasser ab.", "Lokale Mythen behaupten, dass der See bodenlos sei und eine versunkene Stadt verberge."]
    },
    descriptionAdvanced: { de: "Die Laguna de Ayarza in den Bergen des Departamentos Santa Rosa ist ein geologisches Mysterium und eines der tiefsten Gewässer Mittelamerikas. Geformt wie eine gigantische 8, besteht der See aus zwei zusammengewachsenen Vulkankratern (Doppel-Caldera), die vor Tausenden von Jahren bei einer extrem gewaltigen Eruption entstanden sind. Das Wasser ist tief, unheimlich dunkelblau und sehr kalt, da der See auf einer Höhe von fast 1.400 Metern liegt. Lange Zeit mieden die Einheimischen den See, da Legenden behaupten, er sei bodenlos oder werde von großen Schlangenungeheuern bewohnt. Wegen der enormen Tiefe (schätzungsweise über 200 Meter) und der steilen, felsigen Ufer gibt es hier kaum konventionellen Tourismus, sondern der See wird oft für technisches Tauchen und geologische Forschungen genutzt. Kaffeeanbau prägt die Hänge rund um das Gewässer. Geografie K8 — Doppel-Calderen.", hu: "Ayarza-lagúna Guatemala egyik figyelemre méltó pontja, ahol a maja örökség, a vulkáni felföld és az ország sokszínű kultúrája kézzelfoghatóan találkozik. Mélykék krátertó, amely egy vulkanikus eredetű ikerkalderában fekszik. Ugyanakkor Vulkáni kaldera. Emellett Nagyon mély (akár 230 m). A környéken Tiszta, kék víz. Jellemző továbbá Kevéssé turisztikai célpont. Mindezekkel együtt Ayarza-lagúna jól illeszkedik Guatemala összképébe, és megmutatja, mennyire szorosan kapcsolódik egymáshoz a maja kultúra, a vulkanikus felföld, valamint a kávé, a cukornád és a banán termesztése.", ro: "Laguna de Ayarza este un punct remarcabil al Guatemalei, unde moștenirea maya, peisajul vulcanic și diversitatea culturală a țării se întâlnesc într-un mod expresiv. Un lac de crater de un albastru intens, situat într-o calderă dublă de origine vulcanică. În același timp Calderă vulcanică. Pe lângă acestea Foarte adânc (până la 230m). În zonă Apă limpede, albastră. De asemenea Puțin dezvoltat turistic. Astfel, Laguna de Ayarza se încadrează firesc în imaginea de ansamblu a Guatemalei, arătând cât de strâns sunt legate cultura maya, peisajul vulcanic și cultivarea cafelei, a trestiei de zahăr și a bananelor.", en: "Laguna de Ayarza is a notable location in Guatemala where the rich Maya heritage, the volcanic highland landscape and the country's cultural diversity come together in a striking way. A deep blue crater lake located in a twin caldera of volcanic origin. At the same time Volcanic caldera. In addition Very deep (up to 230m). In the surrounding area Clear, blue water. Another characteristic feature Not very touristy. In this way, Laguna de Ayarza fits naturally into the wider picture of Guatemala, showing how closely Maya culture, the volcanic highlands and the cultivation of coffee, sugar cane and bananas are intertwined." },
    factsAdvanced: { de: ["Die Laguna de Ayarza ist eine Doppel-Caldera, entstanden aus dem Einsturz zweier Vulkankrater.", "Mit einer geschätzten Tiefe von weit über 200 Metern ist es einer der tiefsten Seen Zentralamerikas.", "Das Wasser hat aufgrund der extremen Tiefe eine unnatürlich dunkelblaue Farbe.", "Der See liegt in Santa Rosa, einer Region, die sonst für Hitze und Landwirtschaft bekannt ist.", "Steile Felswände fallen an vielen Stellen hunderte Meter tief fast senkrecht ins Wasser ab.", "Lokale Mythen behaupten, dass der See bodenlos sei und eine versunkene Stadt verberge."], hu: ["Vulkáni kaldera", "Nagyon mély (akár 230 m)", "Tiszta, kék víz", "Kevéssé turisztikai célpont", "Guatemalában, a maja örökségéről ismert közép-amerikai országban található.", "Tükrözi a felföld, a Petén-medence és a Csendes-óceáni partvidék közötti régiójára jellemző sajátosságokat.", "Beleilleszkedik Guatemala vulkánjai, az Atitlán-tó és az olyan maja helyszínek, mint Tikal és Antigua alkotta kulturális mozaikba."], ro: ["Calderă vulcanică", "Foarte adânc (până la 230m)", "Apă limpede, albastră", "Puțin dezvoltat turistic", "Se află în Guatemala, o țară central-americană cu o moștenire maya pronunțată.", "Reflectă trăsăturile tipice ale regiunii sale, situată între podișul înalt, bazinul Petén și coasta Pacificului.", "Se integrează în mozaicul guatemalez format din vulcani, lacuri precum Atitlán și situri maya precum Tikal și Antigua."], en: ["Volcanic caldera", "Very deep (up to 230m)", "Clear, blue water", "Not very touristy", "Located in Guatemala, a Central American country with a strong Maya heritage.", "Reflects features typical of its region between the highlands, the Petén lowlands and the Pacific coast.", "Set within Guatemala's mosaic of volcanoes, lakes such as Atitlán and Maya sites like Tikal and Antigua."] }, image: "/poi-images/laguna-de-ayarza-nature-v2.webp"},
  {
    id: "rio-polochic-delta-nature-v2",
    type: "river",
    parent: "GT-IZ",
    coords: [-89.35, 15.46],
    name: { de: "Polochic-Flussdelta", hu: "Polochic-folyó deltája", ro: "Delta râului Polochic", en: "Polochic River Delta" },
    description: { de: "Ein wichtiges Feuchtgebiet und Delta, wo der Polochic-Fluss in den Izabal-See mündet.", hu: "Fontos vizes élőhely és delta, ahol a Polochic-folyó az Izabal-tóba torkollik.", ro: "O zonă umedă și o deltă importantă, unde râul Polochic se varsă în Lacul Izabal.", en: "An important wetland and delta where the Polochic River flows into Lake Izabal." },
    facts: {
      de: ["Mündet in den Izabalsee", "Wichtiges Feuchtgebiet", "Lebensraum für Wasservögel", "Alluviale Ebenen"],
      hu: ["Az Izabal-tóba torkollik", "Fontos vizes élőhely", "Vízi madarak élőhelye", "Ártéri síkságok"],
      ro: ["Se varsă în Lacul Izabal", "Zonă umedă importantă", "Habitat pentru păsări acvatice", "Câmpii aluvionare"],
      en: ["Flows into Lake Izabal", "Important wetland area", "Habitat for waterbirds", "Alluvial plains"]
    },
    descriptionAdvanced: {
      hu: "A Polochic-folyó deltája (Bocas del Polochic) Guatemala egyik legnagyobb és legfontosabb trópusi vizesélőhelye, amely az ország keleti részén (Izabal megye) található, ott, ahol a folyó beömlik a hatalmas Izabal-tóba. A delta több mint 20 000 hektáron elterülő rezervátum (Refugio de Vida Silvestre), amely szövevényes mocsarakból, lagúnákból, nádasokból és elárasztott pálmaerdőkből áll. Ez az érintetlen terület a nyugati félteke vándormadarainak kritikus fontosságú menedéke, télen gyakran tízmilliószámra lepik el a vízimadarak (pl. kormoránok, gémek). A mocsaras dzsungelben élnek az egyre ritkább tapírok, a bőgőmajmok és a manátuszok (tengeri tehenek). A terület megközelítése csak lanchával (motorcsónakkal) lehetséges El Estor kikötőjéből. Földrajz K7 — mocsári delták és vándormadár-útvonalak.",
      de: "Das Delta des Río Polochic ('Bocas del Polochic') im Izabal-See ist das wichtigste geschützte Sumpfgebiet (Humedal) in ganz Guatemala. Wenn der mächtige Fluss nach seinem Weg aus dem Hochland hier in den See mündet, verlangsamt er sich massiv und verzweigt sich in ein endloses Labyrinth aus Kanälen, Sümpfen und Schilffeldern. Dieses riesige Feuchtgebiet wirkt wie eine natürliche Niere, die den Schmutz und die Sedimente aus dem Fluss filtert, bevor das Wasser den See erreicht. Die biologische Vielfalt ist schlichtweg überwältigend: Hier brüten tausende von schneeweißen Reihern, Kormoranen und tropischen Enten. Es ist auch das wichtigste Refugium für Brüllaffen und die extrem gefährdeten Manatis (Seekühe). Die einzige Bedrohung für das Reservat ist die stetige Expansion der gewaltigen afrikanischen Ölpalmenplantagen im angrenzenden Tal, die Wasser entnehmen und das Land entwässern. Biologie K7 — Flussdeltas und Filterökosysteme."
    },
    factsAdvanced: {
      hu: ["A Polochic-folyó az Izabal-tóba érkezve egy kiterjedt mocsaras deltát (Bocas del Polochic) hoz létre.", "Közép-Amerika egyik legfontosabb vizesélőhelye (Ramsari terület) több mint 20 000 hektáron.", "A rezervátum évente több millió észak-amerikai vándormadár (aves migratorias) számára nyújt téli menedéket.", "A sűrű, iszapos mocsárvidék otthont ad Közép-Amerika legnagyobb emlősének, a tapírnak (danta).", "A vízi labirintusban számos manátusz (tengeri tehén) él, akik a sekély, növényekben gazdag vizeket kedvelik.", "Közút nem vezet a rezervátumba, kizárólag El Estor városából csónakkal közelíthető meg."],
      de: ["Das Bocas del Polochic ist das wichtigste und größte geschützte Feuchtgebiet Guatemalas.", "Das Mündungsdelta fungiert als natürlicher Filter für das Wasser, bevor es in den Izabal-See fließt.", "Das Gebiet besteht aus überfluteten Sumpfwäldern, Wasserhyazinthen und dichten Mangroven.", "Das Reservat ist eine der letzten sicheren Zufluchtsstätten für Manatis und Brüllaffen.", "Im Winter migrieren zehntausende Vögel aus den USA und Kanada hierher.", "Der Vormarsch der riesigen Palmölindustrie im Westen bedroht massiv die Wasserbilanz des Deltas."]
    },
    descriptionAdvanced: { de: "Das Delta des Río Polochic ('Bocas del Polochic') im Izabal-See ist das wichtigste geschützte Sumpfgebiet (Humedal) in ganz Guatemala. Wenn der mächtige Fluss nach seinem Weg aus dem Hochland hier in den See mündet, verlangsamt er sich massiv und verzweigt sich in ein endloses Labyrinth aus Kanälen, Sümpfen und Schilffeldern. Dieses riesige Feuchtgebiet wirkt wie eine natürliche Niere, die den Schmutz und die Sedimente aus dem Fluss filtert, bevor das Wasser den See erreicht. Die biologische Vielfalt ist schlichtweg überwältigend: Hier brüten tausende von schneeweißen Reihern, Kormoranen und tropischen Enten. Es ist auch das wichtigste Refugium für Brüllaffen und die extrem gefährdeten Manatis (Seekühe). Die einzige Bedrohung für das Reservat ist die stetige Expansion der gewaltigen afrikanischen Ölpalmenplantagen im angrenzenden Tal, die Wasser entnehmen und das Land entwässern. Biologie K7 — Flussdeltas und Filterökosysteme.", hu: "Polochic-folyó deltája Guatemala egyik figyelemre méltó pontja, ahol a maja örökség, a vulkáni felföld és az ország sokszínű kultúrája kézzelfoghatóan találkozik. Fontos vizes élőhely és delta, ahol a Polochic-folyó az Izabal-tóba torkollik. Ugyanakkor Az Izabal-tóba torkollik. Emellett Fontos vizes élőhely. A környéken Vízi madarak élőhelye. Jellemző továbbá Ártéri síkságok. Mindezekkel együtt Polochic-folyó deltája jól illeszkedik Guatemala összképébe, és megmutatja, mennyire szorosan kapcsolódik egymáshoz a maja kultúra, a vulkanikus felföld, valamint a kávé, a cukornád és a banán termesztése.", ro: "Delta râului Polochic este un punct remarcabil al Guatemalei, unde moștenirea maya, peisajul vulcanic și diversitatea culturală a țării se întâlnesc într-un mod expresiv. O zonă umedă și o deltă importantă, unde râul Polochic se varsă în Lacul Izabal. În același timp Se varsă în Lacul Izabal. Pe lângă acestea Zonă umedă importantă. În zonă Habitat pentru păsări acvatice. De asemenea Câmpii aluvionare. Astfel, Delta râului Polochic se încadrează firesc în imaginea de ansamblu a Guatemalei, arătând cât de strâns sunt legate cultura maya, peisajul vulcanic și cultivarea cafelei, a trestiei de zahăr și a bananelor.", en: "Polochic River Delta is a notable location in Guatemala where the rich Maya heritage, the volcanic highland landscape and the country's cultural diversity come together in a striking way. An important wetland and delta where the Polochic River flows into Lake Izabal. At the same time Flows into Lake Izabal. In addition Important wetland area. In the surrounding area Habitat for waterbirds. Another characteristic feature Alluvial plains. In this way, Polochic River Delta fits naturally into the wider picture of Guatemala, showing how closely Maya culture, the volcanic highlands and the cultivation of coffee, sugar cane and bananas are intertwined." },
    factsAdvanced: { de: ["Das Bocas del Polochic ist das wichtigste und größte geschützte Feuchtgebiet Guatemalas.", "Das Mündungsdelta fungiert als natürlicher Filter für das Wasser, bevor es in den Izabal-See fließt.", "Das Gebiet besteht aus überfluteten Sumpfwäldern, Wasserhyazinthen und dichten Mangroven.", "Das Reservat ist eine der letzten sicheren Zufluchtsstätten für Manatis und Brüllaffen.", "Im Winter migrieren zehntausende Vögel aus den USA und Kanada hierher.", "Der Vormarsch der riesigen Palmölindustrie im Westen bedroht massiv die Wasserbilanz des Deltas."], hu: ["Az Izabal-tóba torkollik", "Fontos vizes élőhely", "Vízi madarak élőhelye", "Ártéri síkságok", "Guatemalában, a maja örökségéről ismert közép-amerikai országban található.", "Tükrözi a felföld, a Petén-medence és a Csendes-óceáni partvidék közötti régiójára jellemző sajátosságokat.", "Beleilleszkedik Guatemala vulkánjai, az Atitlán-tó és az olyan maja helyszínek, mint Tikal és Antigua alkotta kulturális mozaikba."], ro: ["Se varsă în Lacul Izabal", "Zonă umedă importantă", "Habitat pentru păsări acvatice", "Câmpii aluvionare", "Se află în Guatemala, o țară central-americană cu o moștenire maya pronunțată.", "Reflectă trăsăturile tipice ale regiunii sale, situată între podișul înalt, bazinul Petén și coasta Pacificului.", "Se integrează în mozaicul guatemalez format din vulcani, lacuri precum Atitlán și situri maya precum Tikal și Antigua."], en: ["Flows into Lake Izabal", "Important wetland area", "Habitat for waterbirds", "Alluvial plains", "Located in Guatemala, a Central American country with a strong Maya heritage.", "Reflects features typical of its region between the highlands, the Petén lowlands and the Pacific coast.", "Set within Guatemala's mosaic of volcanoes, lakes such as Atitlán and Maya sites like Tikal and Antigua."] }, image: "/poi-images/rio-polochic-delta-nature-v2.webp"},
  {
    id: "cerro-miramundo-nature-v2",
    type: "mountain",
    parent: "GT-JA",
    coords: [-89.95, 14.75],
    name: { de: "Cerro Miramundo", hu: "Cerro Miramundo", ro: "Cerro Miramundo", en: "Cerro Miramundo" },
    description: { de: "Ein Berg im Departement Jalapa, Teil des zentralen Hochlandes von Guatemala.", hu: "Hegy Jalapa megyében, Guatemala központi felföldjének része.", ro: "Un munte în departamentul Jalapa, parte a zonelor înalte centrale ale Guatemalei.", en: "A mountain in the Jalapa department, part of the central highlands of Guatemala." },
    facts: {
      de: ["Teil des Hochlandes", "Gemischter Kiefern-Eichen-Wald", "Wichtige Wasserquelle", "Landwirtschaft an den Hängen"],
      hu: ["A felföld része", "Vegyes fenyő-tölgy erdő", "Fontos vízforrás", "Mezőgazdaság a lejtőkön"],
      ro: ["Parte a zonelor înalte", "Pădure mixtă de pini și stejari", "Sursă importantă de apă", "Agricultură pe versanți"],
      en: ["Part of the highlands", "Mixed pine-oak forest", "Important water source", "Agriculture on the slopes"]
    },
    descriptionAdvanced: {
      hu: "A Cerro Miramundo (Miramundo-hegy) egy festői kilátópont és védett erdőterület Jalapa és Zacapa megyék határvidékén, közel a híres Pino Dulce ökoparkhoz. Neve, a 'Világnéző' nem véletlen: a 2500 méter körüli hegytetőről tiszta időben hihetetlen, 360 fokos panoráma nyílik Guatemala keleti felére, beleértve a Jutiapai síkságokat, a Chingo vulkánt, sőt egészen El Salvador határáig ellátni. A hegycsúcs klímája a magaslat miatt fagyos és ködös, sűrű tölgy- és fenyőerdők (bosques de pino-encino) borítják, amelyek éles kontrasztban állnak az alatta elterülő 'Corredor Seco' (Száraz Folyosó) perzselő sivatagi völgyeivel. Miramundo ma egyre kedveltebb hegymászó és kempingező hely, ahová a fővárosiak menekülnek a hőség elől. Földrajz K6 — magashegyi kilátók és klimatikus kontrasztok.",
      de: "Der Cerro Miramundo ist ein markanter, steiler Berg, der oft in dichten Nebel gehüllt ist und im Departamento Zacapa die Grenze zur feuchteren Region um Jalapa bildet. Obwohl er nicht extrem hoch ist (knapp über 2.000 Meter), trägt er nicht umsonst den Namen 'Miramundo' (Schau die Welt an): An klaren Tagen bietet er einen absolut fesselnden, weiten Blick über das tiefe, knochentrockene Tal des Motagua-Flusses bis hin nach El Salvador. Oben auf dem Cerro Miramundo existiert ein eigenes Mikroklima. Während unten Wüste und Kakteen dominieren, stehen hier auf dem oft kühlen Berggipfel dichte, bemooste Eichen- und Kiefernwälder. Dieser krasse klimatische Kontrast ermöglicht auf der Rückseite des Berges den Anbau von exzellentem Kaffee und Kardamom. Der Berg ist für Naturliebhaber ein fantastisches Beispiel für die extremen Höhen-Klimazonen in Zentralamerika. Geografie K7 — Klimatische Kontraste und Mikroklimata."
    },
    factsAdvanced: {
      hu: ["A Jalapa hegyvidéki peremén található csúcsról egyedülálló, több megyét átfogó kilátás nyílik az Oriente régióra.", "Tengerszint feletti magassága 2 500 méter feletti, a hegytető éghajlata kifejezetten hűvös, éjjel gyakran fagyos.", "A hegyet sűrű fenyő- és tölgyerdők ('pinares' és 'encinares') borítják, amelyek védett ökoszisztémát alkotnak.", "Drámai kontrasztot képez a lábánál elterülő Zacapa megyei száraz, kaktuszos völgyekkel.", "Egyre népszerűbb ökoturisztikai és kemping célpont (gyakran összekötik a Pino Dulce park látogatásával).", "Az utolsó kilométerek a csúcs felé csak 4x4-es jármüvekkel vagy kihívást jelentő túrával tehetők meg."],
      de: ["Der Cerro Miramundo bietet einen der weitesten Panoramablicke über den Osten Guatemalas.", "Sein Name 'Miramundo' (Schau auf die Welt) leitet sich von dieser strategischen Aussicht ab.", "Während das Tal unten eine Trockenwüste ist, herrscht am Gipfel oft kühles Nebelwaldklima.", "Auf dem Berg gibt es riesige Kaffee- und Kardamom-Fincas, geschützt durch Eichenwälder.", "Die Straße zum Gipfel ist extrem steil, kurvig und wird oft von schwerem Nebel geplagt.", "Der Berg markiert eine scharfe geologische und klimatische Trennlinie zwischen Zacapa und Jalapa."]
    },
    descriptionAdvanced: { de: "Der Cerro Miramundo ist ein markanter, steiler Berg, der oft in dichten Nebel gehüllt ist und im Departamento Zacapa die Grenze zur feuchteren Region um Jalapa bildet. Obwohl er nicht extrem hoch ist (knapp über 2.000 Meter), trägt er nicht umsonst den Namen 'Miramundo' (Schau die Welt an): An klaren Tagen bietet er einen absolut fesselnden, weiten Blick über das tiefe, knochentrockene Tal des Motagua-Flusses bis hin nach El Salvador. Oben auf dem Cerro Miramundo existiert ein eigenes Mikroklima. Während unten Wüste und Kakteen dominieren, stehen hier auf dem oft kühlen Berggipfel dichte, bemooste Eichen- und Kiefernwälder. Dieser krasse klimatische Kontrast ermöglicht auf der Rückseite des Berges den Anbau von exzellentem Kaffee und Kardamom. Der Berg ist für Naturliebhaber ein fantastisches Beispiel für die extremen Höhen-Klimazonen in Zentralamerika. Geografie K7 — Klimatische Kontraste und Mikroklimata.", hu: "Cerro Miramundo Guatemala egyik figyelemre méltó pontja, ahol a maja örökség, a vulkáni felföld és az ország sokszínű kultúrája kézzelfoghatóan találkozik. Hegy Jalapa megyében, Guatemala központi felföldjének része. Ugyanakkor A felföld része. Emellett Vegyes fenyő-tölgy erdő. A környéken Fontos vízforrás. Jellemző továbbá Mezőgazdaság a lejtőkön. Mindezekkel együtt Cerro Miramundo jól illeszkedik Guatemala összképébe, és megmutatja, mennyire szorosan kapcsolódik egymáshoz a maja kultúra, a vulkanikus felföld, valamint a kávé, a cukornád és a banán termesztése.", ro: "Cerro Miramundo este un punct remarcabil al Guatemalei, unde moștenirea maya, peisajul vulcanic și diversitatea culturală a țării se întâlnesc într-un mod expresiv. Un munte în departamentul Jalapa, parte a zonelor înalte centrale ale Guatemalei. În același timp Parte a zonelor înalte. Pe lângă acestea Pădure mixtă de pini și stejari. În zonă Sursă importantă de apă. De asemenea Agricultură pe versanți. Astfel, Cerro Miramundo se încadrează firesc în imaginea de ansamblu a Guatemalei, arătând cât de strâns sunt legate cultura maya, peisajul vulcanic și cultivarea cafelei, a trestiei de zahăr și a bananelor.", en: "Cerro Miramundo is a notable location in Guatemala where the rich Maya heritage, the volcanic highland landscape and the country's cultural diversity come together in a striking way. A mountain in the Jalapa department, part of the central highlands of Guatemala. At the same time Part of the highlands. In addition Mixed pine-oak forest. In the surrounding area Important water source. Another characteristic feature Agriculture on the slopes. In this way, Cerro Miramundo fits naturally into the wider picture of Guatemala, showing how closely Maya culture, the volcanic highlands and the cultivation of coffee, sugar cane and bananas are intertwined." },
    factsAdvanced: { de: ["Der Cerro Miramundo bietet einen der weitesten Panoramablicke über den Osten Guatemalas.", "Sein Name 'Miramundo' (Schau auf die Welt) leitet sich von dieser strategischen Aussicht ab.", "Während das Tal unten eine Trockenwüste ist, herrscht am Gipfel oft kühles Nebelwaldklima.", "Auf dem Berg gibt es riesige Kaffee- und Kardamom-Fincas, geschützt durch Eichenwälder.", "Die Straße zum Gipfel ist extrem steil, kurvig und wird oft von schwerem Nebel geplagt.", "Der Berg markiert eine scharfe geologische und klimatische Trennlinie zwischen Zacapa und Jalapa."], hu: ["A felföld része", "Vegyes fenyő-tölgy erdő", "Fontos vízforrás", "Mezőgazdaság a lejtőkön", "Guatemalában, a maja örökségéről ismert közép-amerikai országban található.", "Tükrözi a felföld, a Petén-medence és a Csendes-óceáni partvidék közötti régiójára jellemző sajátosságokat.", "Beleilleszkedik Guatemala vulkánjai, az Atitlán-tó és az olyan maja helyszínek, mint Tikal és Antigua alkotta kulturális mozaikba."], ro: ["Parte a zonelor înalte", "Pădure mixtă de pini și stejari", "Sursă importantă de apă", "Agricultură pe versanți", "Se află în Guatemala, o țară central-americană cu o moștenire maya pronunțată.", "Reflectă trăsăturile tipice ale regiunii sale, situată între podișul înalt, bazinul Petén și coasta Pacificului.", "Se integrează în mozaicul guatemalez format din vulcani, lacuri precum Atitlán și situri maya precum Tikal și Antigua."], en: ["Part of the highlands", "Mixed pine-oak forest", "Important water source", "Agriculture on the slopes", "Located in Guatemala, a Central American country with a strong Maya heritage.", "Reflects features typical of its region between the highlands, the Petén lowlands and the Pacific coast.", "Set within Guatemala's mosaic of volcanoes, lakes such as Atitlán and Maya sites like Tikal and Antigua."] }, image: "/poi-images/cerro-miramundo-nature-v2.webp"},
  {
    id: "isla-de-flores-nature-v2",
    type: "island",
    parent: "GT-PE",
    coords: [-89.891, 16.929],
    name: { de: "Insel Flores", hu: "Flores-sziget", ro: "Insula Flores", en: "Flores Island" },
    description: { de: "Eine Insel im Petén-Itzá-See, auf der sich die historische Stadt Flores befindet.", hu: "Sziget a Petén Itzá-tóban, amelyen a történelmi Flores város található.", ro: "O insulă în Lacul Petén Itzá care găzduiește orașul istoric Flores.", en: "An island in Lake Petén Itzá which is home to the historic town of Flores." },
    facts: {
      de: ["Insel im Petén-Itzá-See", "Historisches Zentrum", "Mit einem Damm verbunden", "Touristenattraktion"],
      hu: ["Sziget a Petén Itzá-tóban", "Történelmi központ", "Gáttal összekötve", "Turisztikai látványosság"],
      ro: ["Insulă în Lacul Petén Itzá", "Centru istoric", "Legată printr-un dig", "Atracție turistică"],
      en: ["Island in Lake Petén Itzá", "Historic center", "Connected by a causeway", "Tourist attraction"]
    },
    descriptionAdvanced: {
      hu: "A festői Isla de Flores a Petén Itzá-tó déli medencéjéből emelkedik ki, és Petén megye turisztikai, valamint – a szárazföldi Santa Elenával közösen – közigazgatási központja is egyben. A sziget eredetileg az utolsó független maja királyság, a Tayasal nevű itza főváros helyszíne volt, amíg a spanyolok 1697-ben el nem pusztították. Ma a sziget egy sűrűn beépített, gyarmati hangulatú kis ékszerdoboz: szűk, macskaköves utcácskák, piros cserepes tetők és pasztellszínűre (rózsaszín, sárga, kék) festett, trópusi növényekkel befuttatott házak jellemzik. A szigetet egy 500 méter hosszú, mesterséges gát (terraplén) köti össze a szárazfölddel. Flores nemcsak lenyűgöző tóparti naplementéiről és éttermeiről ismert, hanem ez a Tikal maja romvárosába tartó nemzetközi hátizsákos turisták első számú bázisa is. Földrajz K6 — szigeti települések és a turizmus logisztikája.",
      de: "Die Isla de Flores ist ein postkartenperfektes, extrem dicht bebautes Eiland mitten im Petén-Itzá-See und die charmante Hauptstadt des Dschungel-Departamentos Petén. Die kleine, tropische Insel ist über einen künstlichen Damm mit dem Festland (Santa Elena) verbunden. Früher war dieser Ort als Tayasal bekannt, die letzte unabhängige Festung der Itzá-Maya, die sich bis 1697 der spanischen Eroberung widersetzte. Heute besticht die Insel durch ein Labyrinth aus engen Kopfsteinpflasterstraßen, pastellfarben bemalten Kolonialhäusern mit roten Ziegeldächern und unzähligen kleinen Hotels und Rooftop-Bars. Aufgrund ihrer Schönheit und der idyllischen Seepromenade (Malecón) ist Flores das absolute touristische Epizentrum und der perfekte Ausgangspunkt für Expeditionen zu den Ruinen von Tikal, Yaxhá oder für Bootsfahrten in den Sonnenuntergang auf dem See. Geografie K8 — Inselstädte und Tourismuszentren."
    },
    factsAdvanced: {
      hu: ["A sziget a Petén Itzá-tó vizében fekszik, és egy mesterséges gát köti össze a szárazföldi Santa Elenával.", "A 17. század végéig az utolsó ellenálló maja királyság (Tayasal) központja volt.", "Macskaköves utcái és színes (pasztell) gyarmati stílusú házai miatt a 'Guatemalai Velence' becenevet is ráaggatták.", "A Tikal Nemzeti Parkba és más peténi maja romokhoz tartó turisták ('mochileros') fo logisztikai központja.", "A szigetet gyakran sújtja a tó vizének ciklikus emelkedése, ami elárasztja a parti sétányokat (malecón).", "Nincs igazi strandja, de a látogatók a fából épült mólókról (muelles) ugrálnak a tó tiszta, meleg vizébe."],
      de: ["Flores ist die administrativ wichtigste Stadt im gesamten Dschungel-Departamento Petén.", "Die Inselstadt ist durch einen Damm mit den kommerziellen Festland-Städten verbunden.", "Historisch befand sich auf der Insel die letzte Maya-Hauptstadt Tayasal.", "Die kreisrunde Insel kann man zu Fuß an der Uferpromenade in knapp 20 Minuten umrunden.", "Die pastellfarbene Architektur und der Seeblick machen sie zum Touristenmagneten.", "Während der Regenzeit steigt der See oft an und überflutet den äußeren Ring der Promenade."]
    },
    descriptionAdvanced: { de: "Die Isla de Flores ist ein postkartenperfektes, extrem dicht bebautes Eiland mitten im Petén-Itzá-See und die charmante Hauptstadt des Dschungel-Departamentos Petén. Die kleine, tropische Insel ist über einen künstlichen Damm mit dem Festland (Santa Elena) verbunden. Früher war dieser Ort als Tayasal bekannt, die letzte unabhängige Festung der Itzá-Maya, die sich bis 1697 der spanischen Eroberung widersetzte. Heute besticht die Insel durch ein Labyrinth aus engen Kopfsteinpflasterstraßen, pastellfarben bemalten Kolonialhäusern mit roten Ziegeldächern und unzähligen kleinen Hotels und Rooftop-Bars. Aufgrund ihrer Schönheit und der idyllischen Seepromenade (Malecón) ist Flores das absolute touristische Epizentrum und der perfekte Ausgangspunkt für Expeditionen zu den Ruinen von Tikal, Yaxhá oder für Bootsfahrten in den Sonnenuntergang auf dem See. Geografie K8 — Inselstädte und Tourismuszentren.", hu: "Flores-sziget Guatemala egyik figyelemre méltó pontja, ahol a maja örökség, a vulkáni felföld és az ország sokszínű kultúrája kézzelfoghatóan találkozik. Sziget a Petén Itzá-tóban, amelyen a történelmi Flores város található. Ugyanakkor Sziget a Petén Itzá-tóban. Emellett Történelmi központ. A környéken Gáttal összekötve. Jellemző továbbá Turisztikai látványosság. Mindezekkel együtt Flores-sziget jól illeszkedik Guatemala összképébe, és megmutatja, mennyire szorosan kapcsolódik egymáshoz a maja kultúra, a vulkanikus felföld, valamint a kávé, a cukornád és a banán termesztése.", ro: "Insula Flores este un punct remarcabil al Guatemalei, unde moștenirea maya, peisajul vulcanic și diversitatea culturală a țării se întâlnesc într-un mod expresiv. O insulă în Lacul Petén Itzá care găzduiește orașul istoric Flores. În același timp Insulă în Lacul Petén Itzá. Pe lângă acestea Centru istoric. În zonă Legată printr-un dig. De asemenea Atracție turistică. Astfel, Insula Flores se încadrează firesc în imaginea de ansamblu a Guatemalei, arătând cât de strâns sunt legate cultura maya, peisajul vulcanic și cultivarea cafelei, a trestiei de zahăr și a bananelor.", en: "Flores Island is a notable location in Guatemala where the rich Maya heritage, the volcanic highland landscape and the country's cultural diversity come together in a striking way. An island in Lake Petén Itzá which is home to the historic town of Flores. At the same time Island in Lake Petén Itzá. In addition Historic center. In the surrounding area Connected by a causeway. Another characteristic feature Tourist attraction. In this way, Flores Island fits naturally into the wider picture of Guatemala, showing how closely Maya culture, the volcanic highlands and the cultivation of coffee, sugar cane and bananas are intertwined." },
    factsAdvanced: { de: ["Flores ist die administrativ wichtigste Stadt im gesamten Dschungel-Departamento Petén.", "Die Inselstadt ist durch einen Damm mit den kommerziellen Festland-Städten verbunden.", "Historisch befand sich auf der Insel die letzte Maya-Hauptstadt Tayasal.", "Die kreisrunde Insel kann man zu Fuß an der Uferpromenade in knapp 20 Minuten umrunden.", "Die pastellfarbene Architektur und der Seeblick machen sie zum Touristenmagneten.", "Während der Regenzeit steigt der See oft an und überflutet den äußeren Ring der Promenade."], hu: ["Sziget a Petén Itzá-tóban", "Történelmi központ", "Gáttal összekötve", "Turisztikai látványosság", "Guatemalában, a maja örökségéről ismert közép-amerikai országban található.", "Tükrözi a felföld, a Petén-medence és a Csendes-óceáni partvidék közötti régiójára jellemző sajátosságokat.", "Beleilleszkedik Guatemala vulkánjai, az Atitlán-tó és az olyan maja helyszínek, mint Tikal és Antigua alkotta kulturális mozaikba."], ro: ["Insulă în Lacul Petén Itzá", "Centru istoric", "Legată printr-un dig", "Atracție turistică", "Se află în Guatemala, o țară central-americană cu o moștenire maya pronunțată.", "Reflectă trăsăturile tipice ale regiunii sale, situată între podișul înalt, bazinul Petén și coasta Pacificului.", "Se integrează în mozaicul guatemalez format din vulcani, lacuri precum Atitlán și situri maya precum Tikal și Antigua."], en: ["Island in Lake Petén Itzá", "Historic center", "Connected by a causeway", "Tourist attraction", "Located in Guatemala, a Central American country with a strong Maya heritage.", "Reflects features typical of its region between the highlands, the Petén lowlands and the Pacific coast.", "Set within Guatemala's mosaic of volcanoes, lakes such as Atitlán and Maya sites like Tikal and Antigua."] }, image: "/poi-images/isla-de-flores-nature-v2.webp"},
  {
    id: "rio-chixoy-negro-nature-v2",
    type: "river",
    parent: "GT-QC",
    coords: [-90.8, 15.85],
    name: { de: "Río Chixoy oder Negro", hu: "Chixoy vagy Negro-folyó", ro: "Râul Chixoy sau Negro", en: "Chixoy or Negro River" },
    description: { de: "Ein großer Fluss, der durch das Hochland fließt und für den Chixoy-Staudamm bekannt ist.", hu: "Nagy folyó, amely áthalad a felföldön, és a Chixoy-gátról ismert.", ro: "Un râu mare care curge prin zonele înalte, cunoscut pentru barajul Chixoy.", en: "A large river flowing through the highlands, known for the Chixoy hydroelectric dam." },
    facts: {
      de: ["Wichtiger Nebenfluss des Usumacinta", "Chixoy-Wasserkraftwerk", "Tiefe Schluchten", "Herausforderndes Wildwasser"],
      hu: ["Az Usumacinta fontos mellékfolyója", "Chixoy vízerőmű", "Mély szurdokok", "Kihívást jelentő vadvíz"],
      ro: ["Afluent important al Usumacintei", "Hidrocentrala Chixoy", "Canioane adânci", "Ape repezi provocatoare"],
      en: ["Major tributary of the Usumacinta", "Chixoy hydroelectric dam", "Deep canyons", "Challenging whitewater"]
    },
    descriptionAdvanced: {
      hu: "A Río Chixoy (amely a felsőbb hegyi szakaszain Río Negro, vagy 'Fekete-folyó' néven ismert) Guatemala egyik leghosszabb és legfontosabb folyórendszere. A Huehuetenango magasföldjein eredő folyó átszeli Quiché és Alta Verapaz megyéket, lenyűgöző, kanyargós kanyonokat vésve a Cuchumatanes-hegység oldalába, majd észak felé, a mexikói határon a Río Usumacintába torkollik. A Chixoy-folyó drámai és sötét történelmet is hordoz: völgyében épült meg az 1980-as évek elején a Chixoy-gát (Közép-Amerika egyik legnagyobb vízerőműve). A gát építése és a völgy elárasztása erőszakos, katonai kitelepítésekkel és tömegmészárlásokkal (mint a hírhedt Río Negro-i mészárlás) járt a helyi achí maja lakosság körében. Ma a gát mögötti hatalmas mesterséges tó (Embalse de Chixoy) csendes, lenyűgöző hegyi táj. Földrajz K8 — folyószabályozás, gátépítés és emberi jogi konfliktusok.",
      de: "Der Río Chixoy (im Oberlauf Río Negro genannt) ist der wichtigste Gebirgsfluss Guatemalas. Er entspringt hoch in den Bergen des Quiché und schneidet eine extrem tiefe, dramatische Schlucht ('Cañón des Chixoy') in das Relief, bevor er die Grenze zu Alta Verapaz bildet und später nach Norden in den Usumacinta fließt. Wegen seines enormen Gefälles und seiner massiven Wassermengen wurde in den 1980er Jahren ein gigantischer Staudamm errichtet (Hidroeléctrica Chixoy), der durch die Erschaffung eines riesigen, künstlichen Sees den Flusslauf für immer veränderte. Bevor das Tal überflutet wurde, war es Heimat hunderter isolierter Achi-Maya, was zu tragischen, massenhaften Vertreibungen führte. Weiter flussabwärts, jenseits des Staudamms, ist der Chixoy oft ruhiger und durchquert tiefe, schwüle Dschungelgebiete, wo er intensiv für Landwirtschaft und Bootsverkehr genutzt wird. Geografie K7 — Staudamm-Infrastruktur und Flusstäler."
    },
    factsAdvanced: {
      hu: ["A Río Chixoy a guatemalai magasföldeken (Río Negro néven) ered és az Usumacinta egyik fő táplálója.", "A folyón épült fel a Chixoy Vízerőmű, amely Guatemala áramellátásának (hidroeléctrica) jelentős részét biztosítja.", "A folyóvölgy elárasztása miatt több maja achí falut töröltek el (ami tömeges erőszakkal is járt 1982-ben).", "A folyó medre a magasföldeken meredek, sötét vizű, gyakran fenyőerdőkkel (pinares) övezett kanyonokat alkot.", "Vize az esős évszakban haragos barnára és feketére színeződik a hordaléktól.", "Quiché és Alta Verapaz megyék közötti természetes határt is képez egy hosszú szakaszon."],
      de: ["Der Chixoy entspringt im kühlen Hochland und fließt später in das heiße Tiefland des Usumacinta.", "Im Oberlauf heißt der Fluss auch Río Negro ('Schwarzer Fluss').", "Der Fluss wurde in den 80er Jahren gestaut, um das größte Kraftwerk des Landes anzutreiben.", "Das Staudamm-Projekt veränderte das Ökosystem der tiefen Flussschlucht radikal.", "Im Unterlauf markiert der Chixoy die Grenze zwischen Quiché und Alta Verapaz.", "Die Talsenke des Chixoy war Schauplatz schwerster Menschenrechtsverletzungen während des Bürgerkriegs."]
    },
    descriptionAdvanced: { de: "Der Río Chixoy (im Oberlauf Río Negro genannt) ist der wichtigste Gebirgsfluss Guatemalas. Er entspringt hoch in den Bergen des Quiché und schneidet eine extrem tiefe, dramatische Schlucht ('Cañón des Chixoy') in das Relief, bevor er die Grenze zu Alta Verapaz bildet und später nach Norden in den Usumacinta fließt. Wegen seines enormen Gefälles und seiner massiven Wassermengen wurde in den 1980er Jahren ein gigantischer Staudamm errichtet (Hidroeléctrica Chixoy), der durch die Erschaffung eines riesigen, künstlichen Sees den Flusslauf für immer veränderte. Bevor das Tal überflutet wurde, war es Heimat hunderter isolierter Achi-Maya, was zu tragischen, massenhaften Vertreibungen führte. Weiter flussabwärts, jenseits des Staudamms, ist der Chixoy oft ruhiger und durchquert tiefe, schwüle Dschungelgebiete, wo er intensiv für Landwirtschaft und Bootsverkehr genutzt wird. Geografie K7 — Staudamm-Infrastruktur und Flusstäler.", hu: "Chixoy vagy Negro-folyó Guatemala egyik figyelemre méltó pontja, ahol a maja örökség, a vulkáni felföld és az ország sokszínű kultúrája kézzelfoghatóan találkozik. Nagy folyó, amely áthalad a felföldön, és a Chixoy-gátról ismert. Ugyanakkor Az Usumacinta fontos mellékfolyója. Emellett Chixoy vízerőmű. A környéken Mély szurdokok. Jellemző továbbá Kihívást jelentő vadvíz. Mindezekkel együtt Chixoy vagy Negro-folyó jól illeszkedik Guatemala összképébe, és megmutatja, mennyire szorosan kapcsolódik egymáshoz a maja kultúra, a vulkanikus felföld, valamint a kávé, a cukornád és a banán termesztése.", ro: "Râul Chixoy sau Negro este un punct remarcabil al Guatemalei, unde moștenirea maya, peisajul vulcanic și diversitatea culturală a țării se întâlnesc într-un mod expresiv. Un râu mare care curge prin zonele înalte, cunoscut pentru barajul Chixoy. În același timp Afluent important al Usumacintei. Pe lângă acestea Hidrocentrala Chixoy. În zonă Canioane adânci. De asemenea Ape repezi provocatoare. Astfel, Râul Chixoy sau Negro se încadrează firesc în imaginea de ansamblu a Guatemalei, arătând cât de strâns sunt legate cultura maya, peisajul vulcanic și cultivarea cafelei, a trestiei de zahăr și a bananelor.", en: "Chixoy or Negro River is a notable location in Guatemala where the rich Maya heritage, the volcanic highland landscape and the country's cultural diversity come together in a striking way. A large river flowing through the highlands, known for the Chixoy hydroelectric dam. At the same time Major tributary of the Usumacinta. In addition Chixoy hydroelectric dam. In the surrounding area Deep canyons. Another characteristic feature Challenging whitewater. In this way, Chixoy or Negro River fits naturally into the wider picture of Guatemala, showing how closely Maya culture, the volcanic highlands and the cultivation of coffee, sugar cane and bananas are intertwined." },
    factsAdvanced: { de: ["Der Chixoy entspringt im kühlen Hochland und fließt später in das heiße Tiefland des Usumacinta.", "Im Oberlauf heißt der Fluss auch Río Negro ('Schwarzer Fluss').", "Der Fluss wurde in den 80er Jahren gestaut, um das größte Kraftwerk des Landes anzutreiben.", "Das Staudamm-Projekt veränderte das Ökosystem der tiefen Flussschlucht radikal.", "Im Unterlauf markiert der Chixoy die Grenze zwischen Quiché und Alta Verapaz.", "Die Talsenke des Chixoy war Schauplatz schwerster Menschenrechtsverletzungen während des Bürgerkriegs."], hu: ["Az Usumacinta fontos mellékfolyója", "Chixoy vízerőmű", "Mély szurdokok", "Kihívást jelentő vadvíz", "Guatemalában, a maja örökségéről ismert közép-amerikai országban található.", "Tükrözi a felföld, a Petén-medence és a Csendes-óceáni partvidék közötti régiójára jellemző sajátosságokat.", "Beleilleszkedik Guatemala vulkánjai, az Atitlán-tó és az olyan maja helyszínek, mint Tikal és Antigua alkotta kulturális mozaikba."], ro: ["Afluent important al Usumacintei", "Hidrocentrala Chixoy", "Canioane adânci", "Ape repezi provocatoare", "Se află în Guatemala, o țară central-americană cu o moștenire maya pronunțată.", "Reflectă trăsăturile tipice ale regiunii sale, situată între podișul înalt, bazinul Petén și coasta Pacificului.", "Se integrează în mozaicul guatemalez format din vulcani, lacuri precum Atitlán și situri maya precum Tikal și Antigua."], en: ["Major tributary of the Usumacinta", "Chixoy hydroelectric dam", "Deep canyons", "Challenging whitewater", "Located in Guatemala, a Central American country with a strong Maya heritage.", "Reflects features typical of its region between the highlands, the Petén lowlands and the Pacific coast.", "Set within Guatemala's mosaic of volcanoes, lakes such as Atitlán and Maya sites like Tikal and Antigua."] }, image: "/poi-images/rio-chixoy-negro-nature-v2.webp"},
  {
    id: "volcan-santa-maria-nature-v2",
    type: "mountain",
    parent: "GT-QZ",
    coords: [-91.552, 14.756],
    name: { de: "Volcán Santa María", hu: "Santa María-vulkán", ro: "Vulcanul Santa María", en: "Santa María Volcano" },
    description: { de: "Ein großer aktiver Vulkan bei Quetzaltenango, dessen Ausbruch 1902 einer der größten des 20. Jahrhunderts war.", hu: "Nagy aktív vulkán Quetzaltenango közelében, amelynek 1902-es kitörése a 20. század egyik legnagyobbja volt.", ro: "Un vulcan activ mare lângă Quetzaltenango, a cărui erupție din 1902 a fost una dintre cele mai mari din secolul al XX-lea.", en: "A large active volcano near Quetzaltenango whose 1902 eruption was one of the largest of the 20th century." },
    facts: {
      de: ["Höhe: 3772 m", "Großer Ausbruch 1902", "Aktiver Lavadom (Santiaguito)", "Beliebtes Wanderziel"],
      hu: ["Magasság: 3772 m", "Nagy kitörés 1902-ben", "Aktív lávadóm (Santiaguito)", "Népszerű túracélpont"],
      ro: ["Înălțime: 3772 m", "Erupție majoră în 1902", "Dom de lavă activ (Santiaguito)", "Destinație populară pentru drumeții"],
      en: ["Elevation: 3772 m", "Major eruption in 1902", "Active lava dome (Santiaguito)", "Popular hiking destination"]
    },
    descriptionAdvanced: {
      hu: "A Santa María vulkán (Gagxanul a maják nyelvén) egy hatalmas, 3772 méter magas stratovulkán Quetzaltenango (Xela) városa felett, amely a 20. század egyik legbrutálisabb geológiai eseményének helyszíne volt. 1902 októberében, évszázados 'alvás' után a vulkán délnyugati oldala egy kataklizmikus robbanással (VEI 6, a 20. század harmadik legnagyobb kitörése) megsemmisült. A robbanás több milliárd tonna hamut és habkövet lövellt a légkörbe, elsötétítve a napot Guatemalában és Mexikó egy részén napokig, és több ezer ember halálát okozva. A hegynek ma a várostól (északról) nézve tökéletes kúp alakja van, de a csendes-óceáni oldalról nézve hiányzik a hegy harmada; ebben a gigantikus kráterben nőtt fel és fortyog azóta is a hírhedt Santiaguito lávadóm. A Santa María megmászása rendkívül népszerű és kimerítő túra, ahonnan fentről lehet lenézni a kitörő Santiaguitóra. Földrajz K8 — Plinius-típusú kitörések és a vulkáni katasztrófák.",
      de: "Der Volcán Santa María ist ein gewaltiger, imposanter Schichtvulkan, der wie eine gigantische Pyramide über der Stadt Quetzaltenango (Xela) aufragt. Im Jahr 1902 riss eine katastrophale, plinianische Eruption (VEI 6) fast die gesamte Südflanke des Vulkans weg, wobei ein Kraterriss von über einem Kilometer Breite entstand. Es war einer der drei größten Vulkanausbrüche des 20. Jahrhunderts weltweit. Die weiße Asche verfinsterte den Himmel über Tage und fiel bis nach San Francisco in den USA. Heute ist der 3.772 Meter hohe Vulkan ein extrem beliebtes und herausforderndes Ziel für Bergsteiger. Der Aufstieg beginnt meist nachts, um im Morgengrauen vom Gipfel aus nicht nur die umliegenden Hochlandtäler zu sehen, sondern vor allem direkt in den aktiven, noch immer ständig ausbrechenden Lavadom des Santiaguito hinabzublicken, der in dem gewaltigen Explosionskrater von 1902 heranwächst. Geografie K8 — Supereruptionen des 20. Jahrhunderts."
    },
    factsAdvanced: {
      hu: ["A vulkán 1902-es kitörése (VEI 6 besorolás) a 20. század egyik legnagyobb globális vulkánkitörése volt.", "A robbanás a hegy délnyugati oldalának hatalmas részét a levegőbe röpítette, létrehozva egy óriási krátert.", "A 3 772 méter magas hegycsúcs északi oldala (Xela felől) megőrizte szimmetrikus, erdős kúp alakját.", "A hegymászók gyakran éjjel indulnak a csúcsra, hogy hajnalban fentről nézhessék a szomszédos Santiaguito kitöréseit.", "A vulkán lejtőin a guatemalai őslakosok (k'iche' maják) ma is füstöloket (copal) égetnek vallási szertartásaikon.", "Az 1902-es hamu (arena) beterítette és részben elpusztította a csendes-óceáni partvidék gazdag kávéültetvényeit."],
      de: ["Die Eruption des Santa María 1902 gehört zu den stärksten Vulkanausbrüchen der modernen Geschichte.", "Die Explosion sprengte ein gewaltiges Stück der gesamten Südflanke des Berges weg.", "Der Gipfel des Vulkans ist mit 3.772 Metern ein eisiges und oft stürmisches Umfeld.", "In der riesigen Explosionsnarbe des Vulkans wächst heute der aktive Lavadom Santiaguito heran.", "Der Aufstieg ist extrem steil und gilt als klassischer Initiations-Test für guatemaltekische Bergsteiger.", "An der Basis des Vulkans entspringen heiße Schwefelquellen wie die Fuentes Georginas."]
    },
    descriptionAdvanced: { de: "Der Volcán Santa María ist ein gewaltiger, imposanter Schichtvulkan, der wie eine gigantische Pyramide über der Stadt Quetzaltenango (Xela) aufragt. Im Jahr 1902 riss eine katastrophale, plinianische Eruption (VEI 6) fast die gesamte Südflanke des Vulkans weg, wobei ein Kraterriss von über einem Kilometer Breite entstand. Es war einer der drei größten Vulkanausbrüche des 20. Jahrhunderts weltweit. Die weiße Asche verfinsterte den Himmel über Tage und fiel bis nach San Francisco in den USA. Heute ist der 3.772 Meter hohe Vulkan ein extrem beliebtes und herausforderndes Ziel für Bergsteiger. Der Aufstieg beginnt meist nachts, um im Morgengrauen vom Gipfel aus nicht nur die umliegenden Hochlandtäler zu sehen, sondern vor allem direkt in den aktiven, noch immer ständig ausbrechenden Lavadom des Santiaguito hinabzublicken, der in dem gewaltigen Explosionskrater von 1902 heranwächst. Geografie K8 — Supereruptionen des 20. Jahrhunderts.", hu: "Santa María-vulkán Guatemala egyik figyelemre méltó pontja, ahol a maja örökség, a vulkáni felföld és az ország sokszínű kultúrája kézzelfoghatóan találkozik. Nagy aktív vulkán Quetzaltenango közelében, amelynek 1902-es kitörése a 20. század egyik legnagyobbja volt. Ugyanakkor Magasság: 3772 m. Emellett Nagy kitörés 1902-ben. A környéken Aktív lávadóm (Santiaguito). Jellemző továbbá Népszerű túracélpont. Mindezekkel együtt Santa María-vulkán jól illeszkedik Guatemala összképébe, és megmutatja, mennyire szorosan kapcsolódik egymáshoz a maja kultúra, a vulkanikus felföld, valamint a kávé, a cukornád és a banán termesztése.", ro: "Vulcanul Santa María este un punct remarcabil al Guatemalei, unde moștenirea maya, peisajul vulcanic și diversitatea culturală a țării se întâlnesc într-un mod expresiv. Un vulcan activ mare lângă Quetzaltenango, a cărui erupție din 1902 a fost una dintre cele mai mari din secolul al XX-lea. În același timp Înălțime: 3772 m. Pe lângă acestea Erupție majoră în 1902. În zonă Dom de lavă activ (Santiaguito). De asemenea Destinație populară pentru drumeții. Astfel, Vulcanul Santa María se încadrează firesc în imaginea de ansamblu a Guatemalei, arătând cât de strâns sunt legate cultura maya, peisajul vulcanic și cultivarea cafelei, a trestiei de zahăr și a bananelor.", en: "Santa María Volcano is a notable location in Guatemala where the rich Maya heritage, the volcanic highland landscape and the country's cultural diversity come together in a striking way. A large active volcano near Quetzaltenango whose 1902 eruption was one of the largest of the 20th century. At the same time Elevation: 3772 m. In addition Major eruption in 1902. In the surrounding area Active lava dome (Santiaguito). Another characteristic feature Popular hiking destination. In this way, Santa María Volcano fits naturally into the wider picture of Guatemala, showing how closely Maya culture, the volcanic highlands and the cultivation of coffee, sugar cane and bananas are intertwined." },
    factsAdvanced: { de: ["Die Eruption des Santa María 1902 gehört zu den stärksten Vulkanausbrüchen der modernen Geschichte.", "Die Explosion sprengte ein gewaltiges Stück der gesamten Südflanke des Berges weg.", "Der Gipfel des Vulkans ist mit 3.772 Metern ein eisiges und oft stürmisches Umfeld.", "In der riesigen Explosionsnarbe des Vulkans wächst heute der aktive Lavadom Santiaguito heran.", "Der Aufstieg ist extrem steil und gilt als klassischer Initiations-Test für guatemaltekische Bergsteiger.", "An der Basis des Vulkans entspringen heiße Schwefelquellen wie die Fuentes Georginas."], hu: ["Magasság: 3772 m", "Nagy kitörés 1902-ben", "Aktív lávadóm (Santiaguito)", "Népszerű túracélpont", "Guatemalában, a maja örökségéről ismert közép-amerikai országban található.", "Tükrözi a felföld, a Petén-medence és a Csendes-óceáni partvidék közötti régiójára jellemző sajátosságokat.", "Beleilleszkedik Guatemala vulkánjai, az Atitlán-tó és az olyan maja helyszínek, mint Tikal és Antigua alkotta kulturális mozaikba."], ro: ["Înălțime: 3772 m", "Erupție majoră în 1902", "Dom de lavă activ (Santiaguito)", "Destinație populară pentru drumeții", "Se află în Guatemala, o țară central-americană cu o moștenire maya pronunțată.", "Reflectă trăsăturile tipice ale regiunii sale, situată între podișul înalt, bazinul Petén și coasta Pacificului.", "Se integrează în mozaicul guatemalez format din vulcani, lacuri precum Atitlán și situri maya precum Tikal și Antigua."], en: ["Elevation: 3772 m", "Major eruption in 1902", "Active lava dome (Santiaguito)", "Popular hiking destination", "Located in Guatemala, a Central American country with a strong Maya heritage.", "Reflects features typical of its region between the highlands, the Petén lowlands and the Pacific coast.", "Set within Guatemala's mosaic of volcanoes, lakes such as Atitlán and Maya sites like Tikal and Antigua."] }, image: "/poi-images/volcan-santa-maria-nature-v2.webp"},
  {
    id: "santiaguito-lava-dome-nature-v2",
    type: "mountain",
    parent: "GT-QZ",
    coords: [-91.556, 14.743],
    name: { de: "Santiaguito Lavadom", hu: "Santiaguito lávadóm", ro: "Domul de lavă Santiaguito", en: "Santiaguito Lava Dome" },
    description: { de: "Ein aktiver Komplex von vier Lavadomen am Fuße des Vulkans Santa María.", hu: "Négy lávadómból álló aktív komplexum a Santa María vulkán lábánál.", ro: "Un complex activ de patru domuri de lavă la poalele vulcanului Santa María.", en: "An active complex of four lava domes at the foot of the Santa María volcano." },
    facts: {
      de: ["Ständig aktiv seit 1922", "Wächst am Hang des Santa María", "Gefährliche pyroklastische Ströme", "Von Aussichtspunkten beobachtbar"],
      hu: ["1922 óta folyamatosan aktív", "A Santa María lejtőjén növekszik", "Veszélyes piroklasztikus árak", "Megfigyelhető kilátópontokról"],
      ro: ["Activ constant din 1922", "Crește pe versantul Santa María", "Fluxuri piroclastice periculoase", "Observabil din puncte de belvedere"],
      en: ["Constantly active since 1922", "Grows on the flank of Santa María", "Dangerous pyroclastic flows", "Observable from viewpoints"]
    },
    descriptionAdvanced: {
      hu: "A Santiaguito lávadóm a Föld egyik legaktívabb és legveszélyesebb vulkanikus komplexuma, amely a Santa María vulkán 1902-es kitörése során keletkezett hatalmas kráterben született meg (1922-ben kezdett kiemelkedni). Quetzaltenangótól délre található. A Santiaguito nem egy klasszikus, magas kúp, hanem egymásba fonódó (El Caliente, La Mitad, El Monje, El Brujo), viszkózus lávából felépült masszív dómok sora, amelyek folyamatos, heves kitörésekben (stromboli és vulcani típusú) öntenek ki lávát, hamufelhőket és mérgező gázokat magukból. A hegycsúcs környékét sűrű, kénszagú gőzök borítják. Az esős évszakban a vulkáni hamu vízzel keveredve pusztító kő- és iszapárakat (laharok) alkot, amelyek rendszeresen elsöprik a Nimá- és Samalá-folyók hídjait és a környező (pl. El Palmar) ültetvényeket, falvakat. Földrajz K8 — vulkáni lávadómok növekedése és a lahar (iszapár) folyamatok.",
      de: "Der Santiaguito ist kein Vulkan im klassischen Sinne, sondern ein extrem gefährlicher und hyperaktiver Lavadom-Komplex. Er begann 1922 exakt in der gigantischen, offenen Explosionsnarbe zu wachsen, die der Ausbruch des Vulkans Santa María (1902) hinterlassen hatte. Seit über hundert Jahren wächst der Santiaguito durch das beständige Herausdrücken von dicker, zähflüssiger Dazit-Lava unaufhörlich weiter. Fast täglich erschüttern ohrenbetäubende Explosionen den Dom, die dichte, graue Aschewolken kilometerweit in den Himmel schießen. Diese Asche regnet regelmäßig auf die Kaffeefincas in der Provinz Retalhuleu herab. Noch gefährlicher sind die pyroklastischen Ströme und die Schlammlawinen (Lahare), die während der Regenzeit in das Tal des Río Samalá stürzen und Brücken und Felder zerstören. Santiaguito ist eines der weltweit wichtigsten Freiluftlabore für Vulkanologen, da man seine täglichen Ausbrüche vom sicheren Gipfel des benachbarten Santa María hervorragend beobachten kann. Geografie K8 — Aktive Lavadome und Lahare."
    },
    factsAdvanced: {
      hu: ["A Santiaguito egy folyamatosan növekvő és kitörő (aktív) lávadóm a Santa María vulkán oldalában.", "Több dóm-csúcsból áll (a legaktívabb az 'El Caliente'), amelyek magassága jelenleg kb. 2 500 méter.", "Szinte minden nap produkál kisebb-nagyobb hamukitöréseket és piroklaszt-árakat.", "Az inaktív Santa María csúcsáról lenyűgöző – és biztonságos – kilátás nyílik a Santiaguito robbanásaira.", "Az esőzések idején a felgyülemlett vulkáni hamu hatalmas, pusztító iszapárakká ('laharokká') változik a folyóvölgyekben.", "Veszélyessége miatt megmászása szigorúan tilos, a hatóságok (CONRED) folyamatosan megfigyelik."],
      de: ["Santiaguito ist ein Domkomplex, der in der Ausbruchsnarbe des Vulkans Santa María wächst.", "Seit seiner Geburt im Jahr 1922 bricht der Lavadom fast ununterbrochen täglich aus.", "Er besteht aus extrem dickflüssiger (viskoser) Lava, die Gase festhält und explosive Eruptionen erzeugt.", "Während der Regenzeit verursacht lose Asche massive Schlammlawinen ('Lahare') im Tal des Samalá-Flusses.", "Santiaguito gehört zur Gruppe der weltweit am intensivsten von Wissenschaftlern überwachten Vulkane.", "Ein direkter Aufstieg auf den Santiaguito ist aufgrund extremer Lebensgefahr streng verboten."]
    },
    descriptionAdvanced: { de: "Der Santiaguito ist kein Vulkan im klassischen Sinne, sondern ein extrem gefährlicher und hyperaktiver Lavadom-Komplex. Er begann 1922 exakt in der gigantischen, offenen Explosionsnarbe zu wachsen, die der Ausbruch des Vulkans Santa María (1902) hinterlassen hatte. Seit über hundert Jahren wächst der Santiaguito durch das beständige Herausdrücken von dicker, zähflüssiger Dazit-Lava unaufhörlich weiter. Fast täglich erschüttern ohrenbetäubende Explosionen den Dom, die dichte, graue Aschewolken kilometerweit in den Himmel schießen. Diese Asche regnet regelmäßig auf die Kaffeefincas in der Provinz Retalhuleu herab. Noch gefährlicher sind die pyroklastischen Ströme und die Schlammlawinen (Lahare), die während der Regenzeit in das Tal des Río Samalá stürzen und Brücken und Felder zerstören. Santiaguito ist eines der weltweit wichtigsten Freiluftlabore für Vulkanologen, da man seine täglichen Ausbrüche vom sicheren Gipfel des benachbarten Santa María hervorragend beobachten kann. Geografie K8 — Aktive Lavadome und Lahare.", hu: "Santiaguito lávadóm Guatemala egyik figyelemre méltó pontja, ahol a maja örökség, a vulkáni felföld és az ország sokszínű kultúrája kézzelfoghatóan találkozik. Négy lávadómból álló aktív komplexum a Santa María vulkán lábánál. Ugyanakkor 1922 óta folyamatosan aktív. Emellett A Santa María lejtőjén növekszik. A környéken Veszélyes piroklasztikus árak. Jellemző továbbá Megfigyelhető kilátópontokról. Mindezekkel együtt Santiaguito lávadóm jól illeszkedik Guatemala összképébe, és megmutatja, mennyire szorosan kapcsolódik egymáshoz a maja kultúra, a vulkanikus felföld, valamint a kávé, a cukornád és a banán termesztése.", ro: "Domul de lavă Santiaguito este un punct remarcabil al Guatemalei, unde moștenirea maya, peisajul vulcanic și diversitatea culturală a țării se întâlnesc într-un mod expresiv. Un complex activ de patru domuri de lavă la poalele vulcanului Santa María. În același timp Activ constant din 1922. Pe lângă acestea Crește pe versantul Santa María. În zonă Fluxuri piroclastice periculoase. De asemenea Observabil din puncte de belvedere. Astfel, Domul de lavă Santiaguito se încadrează firesc în imaginea de ansamblu a Guatemalei, arătând cât de strâns sunt legate cultura maya, peisajul vulcanic și cultivarea cafelei, a trestiei de zahăr și a bananelor.", en: "Santiaguito Lava Dome is a notable location in Guatemala where the rich Maya heritage, the volcanic highland landscape and the country's cultural diversity come together in a striking way. An active complex of four lava domes at the foot of the Santa María volcano. At the same time Constantly active since 1922. In addition Grows on the flank of Santa María. In the surrounding area Dangerous pyroclastic flows. Another characteristic feature Observable from viewpoints. In this way, Santiaguito Lava Dome fits naturally into the wider picture of Guatemala, showing how closely Maya culture, the volcanic highlands and the cultivation of coffee, sugar cane and bananas are intertwined." },
    factsAdvanced: { de: ["Santiaguito ist ein Domkomplex, der in der Ausbruchsnarbe des Vulkans Santa María wächst.", "Seit seiner Geburt im Jahr 1922 bricht der Lavadom fast ununterbrochen täglich aus.", "Er besteht aus extrem dickflüssiger (viskoser) Lava, die Gase festhält und explosive Eruptionen erzeugt.", "Während der Regenzeit verursacht lose Asche massive Schlammlawinen ('Lahare') im Tal des Samalá-Flusses.", "Santiaguito gehört zur Gruppe der weltweit am intensivsten von Wissenschaftlern überwachten Vulkane.", "Ein direkter Aufstieg auf den Santiaguito ist aufgrund extremer Lebensgefahr streng verboten."], hu: ["1922 óta folyamatosan aktív", "A Santa María lejtőjén növekszik", "Veszélyes piroklasztikus árak", "Megfigyelhető kilátópontokról", "Guatemalában, a maja örökségéről ismert közép-amerikai országban található.", "Tükrözi a felföld, a Petén-medence és a Csendes-óceáni partvidék közötti régiójára jellemző sajátosságokat.", "Beleilleszkedik Guatemala vulkánjai, az Atitlán-tó és az olyan maja helyszínek, mint Tikal és Antigua alkotta kulturális mozaikba."], ro: ["Activ constant din 1922", "Crește pe versantul Santa María", "Fluxuri piroclastice periculoase", "Observabil din puncte de belvedere", "Se află în Guatemala, o țară central-americană cu o moștenire maya pronunțată.", "Reflectă trăsăturile tipice ale regiunii sale, situată între podișul înalt, bazinul Petén și coasta Pacificului.", "Se integrează în mozaicul guatemalez format din vulcani, lacuri precum Atitlán și situri maya precum Tikal și Antigua."], en: ["Constantly active since 1922", "Grows on the flank of Santa María", "Dangerous pyroclastic flows", "Observable from viewpoints", "Located in Guatemala, a Central American country with a strong Maya heritage.", "Reflects features typical of its region between the highlands, the Petén lowlands and the Pacific coast.", "Set within Guatemala's mosaic of volcanoes, lakes such as Atitlán and Maya sites like Tikal and Antigua."] }, image: "/poi-images/santiaguito-lava-dome-nature-v2.webp"},
  {
    id: "rio-sarstun-nature-v2",
    type: "river",
    parent: "GT-IZ",
    coords: [-88.92, 15.88],
    name: { de: "Río Sarstún", hu: "Sarstún-folyó", ro: "Râul Sarstoon", en: "Sarstoon River" },
    description: { de: "Ein Fluss, der die südliche Grenze zwischen Guatemala und Belize bildet.", hu: "Folyó, amely a déli határt képezi Guatemala és Belize között.", ro: "Un râu care formează granița de sud dintre Guatemala și Belize.", en: "A river that forms the southern border between Guatemala and Belize." },
    facts: {
      de: ["Grenze zwischen Guatemala und Belize", "Mündet in die Bucht von Amatique", "Umstrittener Grenzverlauf", "Wichtige Feuchtgebiete"],
      hu: ["Guatemala és Belize közötti határ", "Az Amatique-öbölbe torkollik", "Vitatott határvonal", "Fontos vizes élőhelyek"],
      ro: ["Granița dintre Guatemala și Belize", "Se varsă în Golful Amatique", "Curs de graniță disputat", "Zone umede importante"],
      en: ["Border between Guatemala and Belize", "Empties into the Bay of Amatique", "Disputed border course", "Important wetlands"]
    },
    descriptionAdvanced: {
      hu: "A Río Sarstún (vagy Sarstoon-folyó) egy rövid, de geopolitikai és biológiai szempontból rendkívül fontos trópusi folyó, amely az Atlanti-óceánba (Amatique-öböl) ömlik. A folyó képezi a hivatalos (bár Guatemala által sokáig vitatott) nemzetközi határvonalat Guatemala (Izabal megye) és Belize délnyugati része között. A folyó torkolatvidéke sűrű mangrovemocsarakból és trópusi esőerdőkből (Sarstún-Temash Nemzeti Park a belize-i oldalon) áll. A guatemalai szakaszon q'eqchi' és garífuna halászfalvak bújnak meg a parton, az élet kizárólag a vízen zajlik. A folyó vize sötét, csendes, és menedéket nyújt a Morelet-krokodilnak, a jaguároknak és a tengeri teheneknek (manátusz). A határvita miatt a folyón gyakoriak a feszültségek a két ország haditengerészete és a helyi halászok között. Földrajz K7 — határfolyók geopolitikája és karibi torkolatok.",
      de: "Der Río Sarstún (Sarstoon River) ist ein breiter, von dichtem Mangrovendschungel gesäumter Fluss, der die offizielle, natürliche, aber extrem konfliktbeladene Grenze zwischen Guatemala (Departamento Izabal) und dem Land Belize bildet. Auf seinem Weg ins Karibische Meer fließt er gemächlich durch eine atemberaubend schöne, unberührte Tropenlandschaft. Die biologische Vielfalt ist immens; Tapire, Krokodile und gelegentlich Jaguare durchstreifen die Ufer. Da es kaum Straßen gibt, bilden Fischer aus den Garífuna- und Q'eqchi'-Dörfern die einzigen menschlichen Gemeinschaften. Leider ist der Río Sarstún ständiger Schauplatz harter geopolitischer Spannungen. Da Guatemala territoriale Ansprüche auf Belize erhebt, kommt es auf dem Fluss regelmäßig zu Patrouillen und hitzigen Konfrontationen zwischen den Militärs beider Länder, was den Versuch, das Gebiet als grenzüberschreitenden Öko-Park zu etablieren, stark behindert. Geografie K7 — Grenzflüsse und Territorialstreitigkeiten."
    },
    factsAdvanced: {
      hu: ["A Río Sarstún alkotja a természetes és politikai határt Guatemala és Belize között a Karib-tengernél.", "A folyó teljes hosszában suru trópusi dzsungel és áthatolhatatlan mangroveerdők szegélyezik.", "Torkolata az Amatique-öbölbe nyílik, vízgyüjtoje fontos élöhely a karibi manátuszok számára.", "Nincsenek hídjai vagy útjai, az egyetlen közlekedési eszköz a motorcsónak ('lancha') vagy a kenu.", "A torkolatában lévő apró sziget, a Sarstoon Island gyakori guatemalai-belize-i határvillongások helyszíne.", "A helyi lakosság többnyire elszigetelt maja q'eqchi' és afro-karibi garífuna halászközösségekből áll."],
      de: ["Der Río Sarstún bildet den südlichsten Grenzverlauf zwischen Guatemala und Belize.", "Die Ufer des breiten, ruhigen Flusses sind fast durchgehend mit dichten Mangrovenwäldern bewachsen.", "Der Fluss mündet im extremen Osten Guatemalas in den Golf von Honduras (Karibik).", "Häufige Militärpatrouillen zeugen von dem anhaltenden territorialen Streit beider Länder.", "Die Region beheimatet stark bedrohte Küsten-Ökosysteme und zahlreiche Seekühe (Manatis).", "Wegen der Abgeschiedenheit leidet das Gebiet unter illegalem Holzeinschlag und Drogenschmuggel."]
    },
    descriptionAdvanced: { de: "Der Río Sarstún (Sarstoon River) ist ein breiter, von dichtem Mangrovendschungel gesäumter Fluss, der die offizielle, natürliche, aber extrem konfliktbeladene Grenze zwischen Guatemala (Departamento Izabal) und dem Land Belize bildet. Auf seinem Weg ins Karibische Meer fließt er gemächlich durch eine atemberaubend schöne, unberührte Tropenlandschaft. Die biologische Vielfalt ist immens; Tapire, Krokodile und gelegentlich Jaguare durchstreifen die Ufer. Da es kaum Straßen gibt, bilden Fischer aus den Garífuna- und Q'eqchi'-Dörfern die einzigen menschlichen Gemeinschaften. Leider ist der Río Sarstún ständiger Schauplatz harter geopolitischer Spannungen. Da Guatemala territoriale Ansprüche auf Belize erhebt, kommt es auf dem Fluss regelmäßig zu Patrouillen und hitzigen Konfrontationen zwischen den Militärs beider Länder, was den Versuch, das Gebiet als grenzüberschreitenden Öko-Park zu etablieren, stark behindert. Geografie K7 — Grenzflüsse und Territorialstreitigkeiten.", hu: "Sarstún-folyó Guatemala egyik figyelemre méltó pontja, ahol a maja örökség, a vulkáni felföld és az ország sokszínű kultúrája kézzelfoghatóan találkozik. Folyó, amely a déli határt képezi Guatemala és Belize között. Ugyanakkor Guatemala és Belize közötti határ. Emellett Az Amatique-öbölbe torkollik. A környéken Vitatott határvonal. Jellemző továbbá Fontos vizes élőhelyek. Mindezekkel együtt Sarstún-folyó jól illeszkedik Guatemala összképébe, és megmutatja, mennyire szorosan kapcsolódik egymáshoz a maja kultúra, a vulkanikus felföld, valamint a kávé, a cukornád és a banán termesztése.", ro: "Râul Sarstoon este un punct remarcabil al Guatemalei, unde moștenirea maya, peisajul vulcanic și diversitatea culturală a țării se întâlnesc într-un mod expresiv. Un râu care formează granița de sud dintre Guatemala și Belize. În același timp Granița dintre Guatemala și Belize. Pe lângă acestea Se varsă în Golful Amatique. În zonă Curs de graniță disputat. De asemenea Zone umede importante. Astfel, Râul Sarstoon se încadrează firesc în imaginea de ansamblu a Guatemalei, arătând cât de strâns sunt legate cultura maya, peisajul vulcanic și cultivarea cafelei, a trestiei de zahăr și a bananelor.", en: "Sarstoon River is a notable location in Guatemala where the rich Maya heritage, the volcanic highland landscape and the country's cultural diversity come together in a striking way. A river that forms the southern border between Guatemala and Belize. At the same time Border between Guatemala and Belize. In addition Empties into the Bay of Amatique. In the surrounding area Disputed border course. Another characteristic feature Important wetlands. In this way, Sarstoon River fits naturally into the wider picture of Guatemala, showing how closely Maya culture, the volcanic highlands and the cultivation of coffee, sugar cane and bananas are intertwined." },
    factsAdvanced: { de: ["Der Río Sarstún bildet den südlichsten Grenzverlauf zwischen Guatemala und Belize.", "Die Ufer des breiten, ruhigen Flusses sind fast durchgehend mit dichten Mangrovenwäldern bewachsen.", "Der Fluss mündet im extremen Osten Guatemalas in den Golf von Honduras (Karibik).", "Häufige Militärpatrouillen zeugen von dem anhaltenden territorialen Streit beider Länder.", "Die Region beheimatet stark bedrohte Küsten-Ökosysteme und zahlreiche Seekühe (Manatis).", "Wegen der Abgeschiedenheit leidet das Gebiet unter illegalem Holzeinschlag und Drogenschmuggel."], hu: ["Guatemala és Belize közötti határ", "Az Amatique-öbölbe torkollik", "Vitatott határvonal", "Fontos vizes élőhelyek", "Guatemalában, a maja örökségéről ismert közép-amerikai országban található.", "Tükrözi a felföld, a Petén-medence és a Csendes-óceáni partvidék közötti régiójára jellemző sajátosságokat.", "Beleilleszkedik Guatemala vulkánjai, az Atitlán-tó és az olyan maja helyszínek, mint Tikal és Antigua alkotta kulturális mozaikba."], ro: ["Granița dintre Guatemala și Belize", "Se varsă în Golful Amatique", "Curs de graniță disputat", "Zone umede importante", "Se află în Guatemala, o țară central-americană cu o moștenire maya pronunțată.", "Reflectă trăsăturile tipice ale regiunii sale, situată între podișul înalt, bazinul Petén și coasta Pacificului.", "Se integrează în mozaicul guatemalez format din vulcani, lacuri precum Atitlán și situri maya precum Tikal și Antigua."], en: ["Border between Guatemala and Belize", "Empties into the Bay of Amatique", "Disputed border course", "Important wetlands", "Located in Guatemala, a Central American country with a strong Maya heritage.", "Reflects features typical of its region between the highlands, the Petén lowlands and the Pacific coast.", "Set within Guatemala's mosaic of volcanoes, lakes such as Atitlán and Maya sites like Tikal and Antigua."] }, image: "/poi-images/rio-sarstun-nature-v2.webp"},
  {
    id: "laguna-del-tigre-national-park-nature-v2",
    type: "forest",
    parent: "GT-PE",
    coords: [-90.8, 17.4],
    name: { de: "Nationalpark Laguna del Tigre", hu: "Laguna del Tigre Nemzeti Park", ro: "Parcul Național Laguna del Tigre", en: "Laguna del Tigre National Park" },
    description: { de: "Das größte Feuchtgebiet und Schutzgebiet in Guatemala, Teil des Maya-Biosphärenreservats.", hu: "Guatemala legnagyobb vizes élőhelye és védett területe, a Maja Bioszféra-rezervátum része.", ro: "Cea mai mare zonă umedă și arie protejată din Guatemala, parte a Rezervației Biosferei Maya.", en: "The largest wetland and protected area in Guatemala, part of the Maya Biosphere Reserve." },
    facts: {
      de: ["Größtes Schutzgebiet Guatemalas", "Wichtiges Ramsar-Feuchtgebiet", "Hohe Jaguar-Population", "Bedroht durch Waldbrände und Besiedlung"],
      hu: ["Guatemala legnagyobb védett területe", "Fontos Ramsari vizes élőhely", "Magas jaguár-populáció", "Erdőtüzek és betelepülés fenyegeti"],
      ro: ["Cea mai mare arie protejată din Guatemala", "Zonă umedă Ramsar importantă", "Populație mare de jaguari", "Amenințat de incendii și așezări"],
      en: ["Guatemala's largest protected area", "Important Ramsar wetland", "High jaguar population", "Threatened by fires and settlement"]
    },
    descriptionAdvanced: {
      hu: "A Parque Nacional Laguna del Tigre (A Tigris Lagúnája Nemzeti Park) Közép-Amerika legnagyobb egybefüggő édesvízi mocsárrendszere (humedales), és a Maya Bioszféra Rezervátum legnagyobb nemzeti parkja Petén megyében. Az UNESCO Ramsari-egyezménye által is védett, hatalmas, lagúnákkal és folyókkal szabdalt dzsungel kritikus fontosságú a nyugati félteke vándormadarai és a mezoamerikai nagyemlősök, különösen a jaguárok (amelyeket a helyiek 'tigre'-nek, tigrisnek neveznek) számára. Sajnos ez a hatalmas (több mint 300 000 hektáros) terület Guatemala egyik legveszélyeztetettebb ökoszisztémája: az állam gyenge jelenléte miatt narco-rancherek (drogkartellek), illegális fakitermelők és a kőolajipar (Xan mező) folyamatosan pusztítják az erdőt, hatalmas tüzeket okozva a száraz évszakban. Földrajz K8 — hatalmas vizesélőhelyek (Ramsar) és környezeti konfliktusok.",
      de: "Der Nationalpark Laguna del Tigre ist das größte geschützte Feuchtgebiet Zentralamerikas und nimmt den gesamten nordwestlichen Teil des Departamentos Petén ein. Diese riesige Landschaft aus Süßwasserseen, Savannen und dichtem Dschungel ist ein globales Biodiversitäts-Mekka. Es ist der wichtigste Lebensraum für den Jaguar in Mittelamerika sowie für Tapire, Brüllaffen und Hunderte von tropischen Vogelarten. Trotz seines Status als Kernzone der Maya-Biosphäre ist der Park ironischerweise eines der am stärksten bedrohten Gebiete des Landes. Drogenkartelle roden illegal massive Flächen für geheime Landebahnen und Rinderzucht (Narco-Ganadería), während die Regierung in einigen Gebieten die Ölförderung (Xan-Feld) erlaubt hat. Der tägliche Kampf der Parkranger gegen diese mächtigen Eindringlinge ist lebensgefährlich. Geografie K8 — Konflikte in Biosphärenreservaten."
    },
    factsAdvanced: {
      hu: ["Ez Közép-Amerika legnagyobb védett édesvízi láp- és mocsárrendszere (Ramsari terület).", "A park a nevét a jaguárról kapta, amelyet a guatemalai vidékiek hagyományosan 'tigre'-nek neveznek.", "Területén folyik a guatemalai kőolaj-kitermelés (petróleo) jelentős része (Xan olajmező).", "A park az észak-amerikai vándormadarak egyik legfontosabb téli pihenőhelye.", "Hatalmas részei pusztultak el az elmúlt évtizedekben illegális marhalegelők kialakítása és erdőtüzek miatt.", "Az elszigetelt dzsungelben több prekolumbián maja romváros is megbújik (pl. El Perú-Waka')."],
      de: ["Laguna del Tigre ist das flächenmäßig größte Feuchtgebiet im gesamten zentralamerikanischen Raum.", "Der Nationalpark ist Teil des grenzüberschreitenden Maya-Biosphärenreservats.", "Das Reservat ist der wichtigste verbliebene Rückzugsort für wilde Jaguare.", "Illegale Abholzung durch die Drogenmafia (Narco-Ganadería) vernichtet jährlich riesige Waldflächen.", "Trotz des Schutzstatus befinden sich aktive Ölförderanlagen innerhalb der Parkgrenzen.", "Die Flüsse und Lagunen sind überlebenswichtig für Krokodile und Flussschildkröten."]
    },
    descriptionAdvanced: { de: "Der Nationalpark Laguna del Tigre ist das größte geschützte Feuchtgebiet Zentralamerikas und nimmt den gesamten nordwestlichen Teil des Departamentos Petén ein. Diese riesige Landschaft aus Süßwasserseen, Savannen und dichtem Dschungel ist ein globales Biodiversitäts-Mekka. Es ist der wichtigste Lebensraum für den Jaguar in Mittelamerika sowie für Tapire, Brüllaffen und Hunderte von tropischen Vogelarten. Trotz seines Status als Kernzone der Maya-Biosphäre ist der Park ironischerweise eines der am stärksten bedrohten Gebiete des Landes. Drogenkartelle roden illegal massive Flächen für geheime Landebahnen und Rinderzucht (Narco-Ganadería), während die Regierung in einigen Gebieten die Ölförderung (Xan-Feld) erlaubt hat. Der tägliche Kampf der Parkranger gegen diese mächtigen Eindringlinge ist lebensgefährlich. Geografie K8 — Konflikte in Biosphärenreservaten.", hu: "Laguna del Tigre Nemzeti Park Guatemala egyik figyelemre méltó pontja, ahol a maja örökség, a vulkáni felföld és az ország sokszínű kultúrája kézzelfoghatóan találkozik. Guatemala legnagyobb vizes élőhelye és védett területe, a Maja Bioszféra-rezervátum része. Ugyanakkor Guatemala legnagyobb védett területe. Emellett Fontos Ramsari vizes élőhely. A környéken Magas jaguár-populáció. Jellemző továbbá Erdőtüzek és betelepülés fenyegeti. Mindezekkel együtt Laguna del Tigre Nemzeti Park jól illeszkedik Guatemala összképébe, és megmutatja, mennyire szorosan kapcsolódik egymáshoz a maja kultúra, a vulkanikus felföld, valamint a kávé, a cukornád és a banán termesztése.", ro: "Parcul Național Laguna del Tigre este un punct remarcabil al Guatemalei, unde moștenirea maya, peisajul vulcanic și diversitatea culturală a țării se întâlnesc într-un mod expresiv. Cea mai mare zonă umedă și arie protejată din Guatemala, parte a Rezervației Biosferei Maya. În același timp Cea mai mare arie protejată din Guatemala. Pe lângă acestea Zonă umedă Ramsar importantă. În zonă Populație mare de jaguari. De asemenea Amenințat de incendii și așezări. Astfel, Parcul Național Laguna del Tigre se încadrează firesc în imaginea de ansamblu a Guatemalei, arătând cât de strâns sunt legate cultura maya, peisajul vulcanic și cultivarea cafelei, a trestiei de zahăr și a bananelor.", en: "Laguna del Tigre National Park is a notable location in Guatemala where the rich Maya heritage, the volcanic highland landscape and the country's cultural diversity come together in a striking way. The largest wetland and protected area in Guatemala, part of the Maya Biosphere Reserve. At the same time Guatemala's largest protected area. In addition Important Ramsar wetland. In the surrounding area High jaguar population. Another characteristic feature Threatened by fires and settlement. In this way, Laguna del Tigre National Park fits naturally into the wider picture of Guatemala, showing how closely Maya culture, the volcanic highlands and the cultivation of coffee, sugar cane and bananas are intertwined." },
    factsAdvanced: { de: ["Laguna del Tigre ist das flächenmäßig größte Feuchtgebiet im gesamten zentralamerikanischen Raum.", "Der Nationalpark ist Teil des grenzüberschreitenden Maya-Biosphärenreservats.", "Das Reservat ist der wichtigste verbliebene Rückzugsort für wilde Jaguare.", "Illegale Abholzung durch die Drogenmafia (Narco-Ganadería) vernichtet jährlich riesige Waldflächen.", "Trotz des Schutzstatus befinden sich aktive Ölförderanlagen innerhalb der Parkgrenzen.", "Die Flüsse und Lagunen sind überlebenswichtig für Krokodile und Flussschildkröten."], hu: ["Guatemala legnagyobb védett területe", "Fontos Ramsari vizes élőhely", "Magas jaguár-populáció", "Erdőtüzek és betelepülés fenyegeti", "Guatemalában, a maja örökségéről ismert közép-amerikai országban található.", "Tükrözi a felföld, a Petén-medence és a Csendes-óceáni partvidék közötti régiójára jellemző sajátosságokat.", "Beleilleszkedik Guatemala vulkánjai, az Atitlán-tó és az olyan maja helyszínek, mint Tikal és Antigua alkotta kulturális mozaikba."], ro: ["Cea mai mare arie protejată din Guatemala", "Zonă umedă Ramsar importantă", "Populație mare de jaguari", "Amenințat de incendii și așezări", "Se află în Guatemala, o țară central-americană cu o moștenire maya pronunțată.", "Reflectă trăsăturile tipice ale regiunii sale, situată între podișul înalt, bazinul Petén și coasta Pacificului.", "Se integrează în mozaicul guatemalez format din vulcani, lacuri precum Atitlán și situri maya precum Tikal și Antigua."], en: ["Guatemala's largest protected area", "Important Ramsar wetland", "High jaguar population", "Threatened by fires and settlement", "Located in Guatemala, a Central American country with a strong Maya heritage.", "Reflects features typical of its region between the highlands, the Petén lowlands and the Pacific coast.", "Set within Guatemala's mosaic of volcanoes, lakes such as Atitlán and Maya sites like Tikal and Antigua."] }, image: "/poi-images/laguna-del-tigre-national-park-nature-v2.webp"},
  {
    id: "cuevas-de-candelaria-nature-v2",
    type: "forest",
    parent: "GT-AV",
    coords: [-90.3, 15.85],
    name: { de: "Candelaria-Höhlen", hu: "Candelaria-barlangok", ro: "Peșterile Candelaria", en: "Candelaria Caves" },
    description: { de: "Ein riesiges Höhlensystem in Alta Verapaz, das von den Maya als heilig angesehen wurde.", hu: "Hatalmas barlangrendszer Alta Verapazban, amelyet a maják szentnek tartottak.", ro: "Un sistem vast de peșteri în Alta Verapaz, considerat sacru de către mayași.", en: "A vast cave system in Alta Verapaz, considered sacred by the Maya." },
    facts: {
      de: ["Großes unterirdisches Flusssystem", "Heiliger Ort für die Maya", "Teilweise mit dem Boot befahrbar", "Nationalpark"],
      hu: ["Nagy földalatti folyórendszer", "Szent hely a maják számára", "Részben hajóval is bejárható", "Nemzeti Park"],
      ro: ["Sistem fluvial subteran mare", "Loc sacru pentru mayași", "Parțial navigabil cu barca", "Parc Național"],
      en: ["Large underground river system", "Sacred place for the Maya", "Partially navigable by boat", "National Park"]
    },
    descriptionAdvanced: {
      hu: "A Cuevas de Candelaria (Candelaria-barlangrendszer) Közép-Amerika egyik legnagyobb, leglátványosabb és kulturálisan legfontosabb karsztos barlanghálózata Alta Verapaz megye északi részén (a Karst de Candelaria Nemzeti Parkban). A földalatti labirintust a Río Candelaria véste ki a mészkőhegyből, és mintegy 30 kilométer hosszan kanyarog (ebből több kilométer magas boltívekkel). A barlangokat a maják szentként tisztelték: az alvilágba, a Xibalbába vezető kapuként tekintettek rájuk. A járatokban ma is hatalmas, akár 30 méter magas mészkőoszlopok (cseppkövek), földalatti vízesések és beomlott krátereken (cenoték) beömlő misztikus fénypászmák láthatók. A barlangrendszer nagy részét gumiabroncsokon lebegve (tubing), sötétben sodródva (a Candelaria folyón) fedezik fel az ide látogató ökoturisták. Földrajz K8 — karsztos (szpeleológiai) barlangrendszerek és a maja Xibalbá.",
      de: "Die Cuevas de Candelaria im Norden der Alta Verapaz sind eines der größten, beeindruckendsten und längsten Höhlensysteme in ganz Lateinamerika. Geformt vom Río Candelaria, der sich kilometerweit durch das Kalksteingebirge gefräst hat, besteht das Netzwerk aus massiven Kavernen, unterirdischen Flüssen und riesigen natürlichen Sälen, die teilweise über 60 Meter hoch sind. Für die alten Maya waren diese dunklen, oft überfluteten Höhlen nicht nur ein geografisches Phänomen, sondern der buchstäbliche Eingang in die Unterwelt 'Xibalbá'. Daher finden Archäologen tief im Inneren regelmäßig zerbrochene Keramiken, die während prähispanischer Rituale dargebracht wurden. Heute wird die Candelaria-Höhle von indigenen Q'eqchi'-Gemeinschaften verwaltet, die Touristen auf 'Tubing'-Touren (in aufgepumpten Reifen) stundenlang mit Stirnlampen durch die spektakulären Tropfsteingewölbe führen. Geografie K7 — Karsthöhlen und die Maya-Unterwelt."
    },
    factsAdvanced: {
      hu: ["Közép-Amerika egyik leghosszabb (kb. 30 km) és legbővízűbb karsztos barlanghálózata.", "A Candelaria folyó (Río Candelaria) folyik rajta keresztül, amelyet barlangi 'tubing'-gal (gumibelsőn lebegve) lehet bejárni.", "A maják számára a barlangrendszer az alvilág, a 'Xibalbá' egyik fő bejárata (szent hely) volt.", "A barlangcsarnokok némelyike eléri a 30 méteres magasságot és 60 méteres szélességet.", "Fellazult karsztablakain (beomlásokon) keresztül sok helyen drámai fénypászmák világítják meg a sötét vizet.", "A park kezelését jórészt a helyi q'eqchi' maja közösségek végzik (pl. Mucbilpe közösség)."],
      de: ["Das Candelaria-Höhlensystem hat eine erforschte, zusammenhängende Länge von über 80 Kilometern.", "Der unterirdische Verlauf des Flusses macht das System perfekt für dunkle Höhlen-Rafting-Touren.", "Die klassischen Maya betrachteten diese Höhlen als heilige Portale in die Unterwelt (Xibalbá).", "Teile der Höhlendecke sind eingestürzt, wodurch dramatische Lichtkegel tief in den Untergrund scheinen.", "Das Gebiet wird nachhaltig von den lokalen indigenen Q'eqchi'-Gemeinschaften verwaltet.", "In den trockenen Seitengalerien findet man unzählige, rituelle Maya-Tonscherben."]
    },
    descriptionAdvanced: { de: "Die Cuevas de Candelaria im Norden der Alta Verapaz sind eines der größten, beeindruckendsten und längsten Höhlensysteme in ganz Lateinamerika. Geformt vom Río Candelaria, der sich kilometerweit durch das Kalksteingebirge gefräst hat, besteht das Netzwerk aus massiven Kavernen, unterirdischen Flüssen und riesigen natürlichen Sälen, die teilweise über 60 Meter hoch sind. Für die alten Maya waren diese dunklen, oft überfluteten Höhlen nicht nur ein geografisches Phänomen, sondern der buchstäbliche Eingang in die Unterwelt 'Xibalbá'. Daher finden Archäologen tief im Inneren regelmäßig zerbrochene Keramiken, die während prähispanischer Rituale dargebracht wurden. Heute wird die Candelaria-Höhle von indigenen Q'eqchi'-Gemeinschaften verwaltet, die Touristen auf 'Tubing'-Touren (in aufgepumpten Reifen) stundenlang mit Stirnlampen durch die spektakulären Tropfsteingewölbe führen. Geografie K7 — Karsthöhlen und die Maya-Unterwelt.", hu: "Candelaria-barlangok Guatemala egyik figyelemre méltó pontja, ahol a maja örökség, a vulkáni felföld és az ország sokszínű kultúrája kézzelfoghatóan találkozik. Hatalmas barlangrendszer Alta Verapazban, amelyet a maják szentnek tartottak. Ugyanakkor Nagy földalatti folyórendszer. Emellett Szent hely a maják számára. A környéken Részben hajóval is bejárható. Jellemző továbbá Nemzeti Park. Mindezekkel együtt Candelaria-barlangok jól illeszkedik Guatemala összképébe, és megmutatja, mennyire szorosan kapcsolódik egymáshoz a maja kultúra, a vulkanikus felföld, valamint a kávé, a cukornád és a banán termesztése.", ro: "Peșterile Candelaria este un punct remarcabil al Guatemalei, unde moștenirea maya, peisajul vulcanic și diversitatea culturală a țării se întâlnesc într-un mod expresiv. Un sistem vast de peșteri în Alta Verapaz, considerat sacru de către mayași. În același timp Sistem fluvial subteran mare. Pe lângă acestea Loc sacru pentru mayași. În zonă Parțial navigabil cu barca. De asemenea Parc Național. Astfel, Peșterile Candelaria se încadrează firesc în imaginea de ansamblu a Guatemalei, arătând cât de strâns sunt legate cultura maya, peisajul vulcanic și cultivarea cafelei, a trestiei de zahăr și a bananelor.", en: "Candelaria Caves is a notable location in Guatemala where the rich Maya heritage, the volcanic highland landscape and the country's cultural diversity come together in a striking way. A vast cave system in Alta Verapaz, considered sacred by the Maya. At the same time Large underground river system. In addition Sacred place for the Maya. In the surrounding area Partially navigable by boat. Another characteristic feature National Park. In this way, Candelaria Caves fits naturally into the wider picture of Guatemala, showing how closely Maya culture, the volcanic highlands and the cultivation of coffee, sugar cane and bananas are intertwined." },
    factsAdvanced: { de: ["Das Candelaria-Höhlensystem hat eine erforschte, zusammenhängende Länge von über 80 Kilometern.", "Der unterirdische Verlauf des Flusses macht das System perfekt für dunkle Höhlen-Rafting-Touren.", "Die klassischen Maya betrachteten diese Höhlen als heilige Portale in die Unterwelt (Xibalbá).", "Teile der Höhlendecke sind eingestürzt, wodurch dramatische Lichtkegel tief in den Untergrund scheinen.", "Das Gebiet wird nachhaltig von den lokalen indigenen Q'eqchi'-Gemeinschaften verwaltet.", "In den trockenen Seitengalerien findet man unzählige, rituelle Maya-Tonscherben."], hu: ["Nagy földalatti folyórendszer", "Szent hely a maják számára", "Részben hajóval is bejárható", "Nemzeti Park", "Guatemalában, a maja örökségéről ismert közép-amerikai országban található.", "Tükrözi a felföld, a Petén-medence és a Csendes-óceáni partvidék közötti régiójára jellemző sajátosságokat.", "Beleilleszkedik Guatemala vulkánjai, az Atitlán-tó és az olyan maja helyszínek, mint Tikal és Antigua alkotta kulturális mozaikba."], ro: ["Sistem fluvial subteran mare", "Loc sacru pentru mayași", "Parțial navigabil cu barca", "Parc Național", "Se află în Guatemala, o țară central-americană cu o moștenire maya pronunțată.", "Reflectă trăsăturile tipice ale regiunii sale, situată între podișul înalt, bazinul Petén și coasta Pacificului.", "Se integrează în mozaicul guatemalez format din vulcani, lacuri precum Atitlán și situri maya precum Tikal și Antigua."], en: ["Large underground river system", "Sacred place for the Maya", "Partially navigable by boat", "National Park", "Located in Guatemala, a Central American country with a strong Maya heritage.", "Reflects features typical of its region between the highlands, the Petén lowlands and the Pacific coast.", "Set within Guatemala's mosaic of volcanoes, lakes such as Atitlán and Maya sites like Tikal and Antigua."] }, image: "/poi-images/cuevas-de-candelaria-nature-v2.webp"},
  {
    id: "parque-nacional-rio-dulce-nature-v2",
    type: "forest",
    parent: "GT-IZ",
    coords: [-88.9, 15.7],
    name: { de: "Nationalpark Río Dulce", hu: "Río Dulce Nemzeti Park", ro: "Parcul Național Río Dulce", en: "Río Dulce National Park" },
    description: { de: "Ein Nationalpark, der den Río Dulce und Teile des Izabal-Sees schützt, inklusive der Schlucht.", hu: "Nemzeti park, amely védi a Río Dulcét és az Izabal-tó egyes részeit, beleértve a szurdokot is.", ro: "Un parc național care protejează Río Dulce și părți ale Lacului Izabal, inclusiv canionul.", en: "A national park protecting the Río Dulce and parts of Lake Izabal, including the gorge." },
    facts: {
      de: ["Schützt den Río Dulce Canyon", "Heimat von Manatis", "Tropischer Regenwald und Feuchtgebiete", "Castillo de San Felipe"],
      hu: ["Védi a Río Dulce kanyont", "Manátuszok otthona", "Trópusi esőerdő és vizes élőhelyek", "Castillo de San Felipe"],
      ro: ["Protejează Canionul Río Dulce", "Habitat pentru lamantini", "Pădure tropicală și zone umede", "Castelul San Felipe"],
      en: ["Protects the Río Dulce canyon", "Home to manatees", "Tropical rainforest and wetlands", "Castillo de San Felipe"]
    },
    descriptionAdvanced: {
      hu: "A Río Dulce (Édes Folyó) egy viszonylag rövid (kb. 43 km), de földrajzilag és gazdaságilag kulcsfontosságú vízi útvonal, amely az Izabal-tó hatalmas víztömegét vezeti le a Karib-tengerbe (Amatique-öböl). A folyó az 'El Golfete' nevű tóvá szélesedik ki, mielőtt bevetné magát a híres Kanyonba (El Cañón del Río Dulce), ahol sűrű trópusi dzsungellel borított, függőleges, 100 méteres mészkőfalak között kanyarog. A folyó sötét, meleg vize az egyik utolsó közép-amerikai menedéke a kihalófélben lévő karibi manátusznak (tengeri tehén), amelyet a helyi Chocón Machacas biotóp próbál védeni. A folyót a spanyoloktól kezdve a kalózokig mindenki használta, ma pedig a jachtok (hurrikánmenedék) és az ökoturizmus paradicsoma, amit a garífuna és q'eqchi' kultúra övez. Földrajz K6 — karibi folyami torkolatok és mészkőkanyonok.",
      de: "Der Parque Nacional Río Dulce schützt die atemberaubende, fast 40 Kilometer lange Schlucht, durch die das Wasser des Izabal-Sees ins Karibische Meer fließt. Diese majestätische Wasserstraße schneidet sich tief in massive, von urwaldüberzogene Kalksteinklippen. Die unzugänglichen Wände des Canyons sind mit Lianen, Tillandsien und Bromelien behangen, während in den ruhigen Seitengewässern weiße Seerosen blühen. Der Park ist ein unverzichtbares Reservat für exotische Vögel (wie Tukane und Kormorane) und die seltene mittelamerikanische Seekuh (Manatí), die in den warmen, trüben Golfgewässern grast. Historisch gesehen war diese Route der einzige Weg für die spanischen Silberflotten ins Landesinnere, weshalb am Eingang die Festung San Felipe errichtet wurde, um Piraten abzuwehren. Heute gleiten luxuriöse Segelyachten und kleine Holzboote der Q'eqchi' friedlich durch diese tropische Märchenlandschaft. Biologie K7 — Flusscanyons und Seekühe."
    },
    factsAdvanced: {
      hu: ["Az Izabal-tavat (Guatemala legnagyobb tava) köti össze a Karib-tengerrel Livingstonnál.", "Alsó folyásán egy látványos, 100 méter mély mészkő kanyonon halad keresztül.", "A 'hurricane hole' (hurrikánmenedék) a Karib-tengeri jachtosok egyik legfontosabb kikötője.", "Otthont ad a ritka és szigorúan védett karibi manátuszoknak (tengeri teheneknek).", "A spanyol gyarmati időkben a Castillo de San Felipe erőd védte a kalózok betöréseitől.", "A folyó feletti hatalmas híd (Puente Río Dulce) az egyik legfontosabb összeköttetés a Petén régió felé."],
      de: ["Der Nationalpark wurde 1955 gegründet, um den einzigartigen Flusscanyon zu schützen.", "Steile Kalksteinklippen säumen den Flusslauf, ähnlich wie in einem tropischen Fjord.", "Die geschützten Biotope am Rande des Flusses dienen als Rückzugsort für Karibik-Manatis.", "Thermische Quellen an den Felswänden leiten kochend heißes Wasser direkt in den Río Dulce.", "Der Park ist die einzige Verbindung zwischen dem größten See Guatemalas und dem Meer.", "Das Naturschutzgebiet kämpft stetig gegen Umweltverschmutzung durch illegale Feriensiedlungen am Ufer."]
    },
    descriptionAdvanced: { de: "Der Parque Nacional Río Dulce schützt die atemberaubende, fast 40 Kilometer lange Schlucht, durch die das Wasser des Izabal-Sees ins Karibische Meer fließt. Diese majestätische Wasserstraße schneidet sich tief in massive, von urwaldüberzogene Kalksteinklippen. Die unzugänglichen Wände des Canyons sind mit Lianen, Tillandsien und Bromelien behangen, während in den ruhigen Seitengewässern weiße Seerosen blühen. Der Park ist ein unverzichtbares Reservat für exotische Vögel (wie Tukane und Kormorane) und die seltene mittelamerikanische Seekuh (Manatí), die in den warmen, trüben Golfgewässern grast. Historisch gesehen war diese Route der einzige Weg für die spanischen Silberflotten ins Landesinnere, weshalb am Eingang die Festung San Felipe errichtet wurde, um Piraten abzuwehren. Heute gleiten luxuriöse Segelyachten und kleine Holzboote der Q'eqchi' friedlich durch diese tropische Märchenlandschaft. Biologie K7 — Flusscanyons und Seekühe.", hu: "Río Dulce Nemzeti Park Guatemala egyik figyelemre méltó pontja, ahol a maja örökség, a vulkáni felföld és az ország sokszínű kultúrája kézzelfoghatóan találkozik. Nemzeti park, amely védi a Río Dulcét és az Izabal-tó egyes részeit, beleértve a szurdokot is. Ugyanakkor Védi a Río Dulce kanyont. Emellett Manátuszok otthona. A környéken Trópusi esőerdő és vizes élőhelyek. Jellemző továbbá Castillo de San Felipe. Mindezekkel együtt Río Dulce Nemzeti Park jól illeszkedik Guatemala összképébe, és megmutatja, mennyire szorosan kapcsolódik egymáshoz a maja kultúra, a vulkanikus felföld, valamint a kávé, a cukornád és a banán termesztése.", ro: "Parcul Național Río Dulce este un punct remarcabil al Guatemalei, unde moștenirea maya, peisajul vulcanic și diversitatea culturală a țării se întâlnesc într-un mod expresiv. Un parc național care protejează Río Dulce și părți ale Lacului Izabal, inclusiv canionul. În același timp Protejează Canionul Río Dulce. Pe lângă acestea Habitat pentru lamantini. În zonă Pădure tropicală și zone umede. De asemenea Castelul San Felipe. Astfel, Parcul Național Río Dulce se încadrează firesc în imaginea de ansamblu a Guatemalei, arătând cât de strâns sunt legate cultura maya, peisajul vulcanic și cultivarea cafelei, a trestiei de zahăr și a bananelor.", en: "Río Dulce National Park is a notable location in Guatemala where the rich Maya heritage, the volcanic highland landscape and the country's cultural diversity come together in a striking way. A national park protecting the Río Dulce and parts of Lake Izabal, including the gorge. At the same time Protects the Río Dulce canyon. In addition Home to manatees. In the surrounding area Tropical rainforest and wetlands. Another characteristic feature Castillo de San Felipe. In this way, Río Dulce National Park fits naturally into the wider picture of Guatemala, showing how closely Maya culture, the volcanic highlands and the cultivation of coffee, sugar cane and bananas are intertwined." },
    factsAdvanced: { de: ["Der Nationalpark wurde 1955 gegründet, um den einzigartigen Flusscanyon zu schützen.", "Steile Kalksteinklippen säumen den Flusslauf, ähnlich wie in einem tropischen Fjord.", "Die geschützten Biotope am Rande des Flusses dienen als Rückzugsort für Karibik-Manatis.", "Thermische Quellen an den Felswänden leiten kochend heißes Wasser direkt in den Río Dulce.", "Der Park ist die einzige Verbindung zwischen dem größten See Guatemalas und dem Meer.", "Das Naturschutzgebiet kämpft stetig gegen Umweltverschmutzung durch illegale Feriensiedlungen am Ufer."], hu: ["Védi a Río Dulce kanyont", "Manátuszok otthona", "Trópusi esőerdő és vizes élőhelyek", "Castillo de San Felipe", "Guatemalában, a maja örökségéről ismert közép-amerikai országban található.", "Tükrözi a felföld, a Petén-medence és a Csendes-óceáni partvidék közötti régiójára jellemző sajátosságokat.", "Beleilleszkedik Guatemala vulkánjai, az Atitlán-tó és az olyan maja helyszínek, mint Tikal és Antigua alkotta kulturális mozaikba."], ro: ["Protejează Canionul Río Dulce", "Habitat pentru lamantini", "Pădure tropicală și zone umede", "Castelul San Felipe", "Se află în Guatemala, o țară central-americană cu o moștenire maya pronunțată.", "Reflectă trăsăturile tipice ale regiunii sale, situată între podișul înalt, bazinul Petén și coasta Pacificului.", "Se integrează în mozaicul guatemalez format din vulcani, lacuri precum Atitlán și situri maya precum Tikal și Antigua."], en: ["Protects the Río Dulce canyon", "Home to manatees", "Tropical rainforest and wetlands", "Castillo de San Felipe", "Located in Guatemala, a Central American country with a strong Maya heritage.", "Reflects features typical of its region between the highlands, the Petén lowlands and the Pacific coast.", "Set within Guatemala's mosaic of volcanoes, lakes such as Atitlán and Maya sites like Tikal and Antigua."] }, image: "/poi-images/parque-nacional-rio-dulce-nature-v2.webp"},
  {
    id: "laguna-chichoj-nature-v2",
    type: "lake",
    parent: "GT-AV",
    coords: [-90.47, 15.37],
    name: { de: "Laguna Chichoj", hu: "Chichoj-lagúna", ro: "Laguna Chichoj", en: "Laguna Chichoj" },
    description: { de: "Ein kleiner See bei San Cristóbal Verapaz, der jedoch ökologisch bedroht ist.", hu: "Kis tó San Cristóbal Verapaz közelében, amely azonban ökológiailag veszélyeztetett.", ro: "Un lac mic lângă San Cristóbal Verapaz, dar care este amenințat ecologic.", en: "A small lake near San Cristóbal Verapaz which is, however, ecologically threatened." },
    facts: {
      de: ["Nahe San Cristóbal Verapaz", "Ökologisch bedroht", "Wichtig für die lokale Gemeinschaft", "Poqomchi'-Maya-Region"],
      hu: ["San Cristóbal Verapaz közelében", "Ökológiailag veszélyeztetett", "Fontos a helyi közösség számára", "Poqomchi'-maja régió"],
      ro: ["Lângă San Cristóbal Verapaz", "Amenințat ecologic", "Important pentru comunitatea locală", "Regiunea mayașă Poqomchi'"],
      en: ["Near San Cristóbal Verapaz", "Ecologically threatened", "Important for the local community", "Poqomchi' Maya region"]
    },
    descriptionAdvanced: {
      hu: "A Laguna Chichoj egy festői, ködbe burkolózó magaslati tó Alta Verapaz megyében, közvetlenül San Cristóbal Verapaz városának szélén. A fenyő- és felhőerdőkkel (bosque nuboso) körbevett lagúna mély, hideg vize és a rajta lassan úszó ködfoltok (chipi-chipi) melankolikus szépséget árasztanak. Bár a tó fontos tájképalkotó elem és a helyi poqomchi' maják legendáinak (köztük egy elsüllyedt város történetének) helyszíne, ökológiai állapota aggasztó: a környező település és a mezőgazdaság szűretlen szennyvize miatt a tó egyre inkább eutrofizálódik (elalgásodik), és felszínét vízi jácintok (ninfa) lepik el. A helyiek komoly erőfeszítéseket tesznek a tavon tenyésző tőzeg (tul) betakarítására, amelyből hagyományos szőnyegeket fonnak (petates), és egyben próbálják megtisztítani a vizet. Földrajz K7 — magaslati tavak eutrofizációja és az ökológiai rehabilitáció.",
      de: "Die Laguna Chichoj ist ein pittoresker, von Bergen umrahmter See direkt am Rande der Stadt San Cristóbal Verapaz (Departamento Alta Verapaz). Für die indigene Poqomchi'-Gemeinschaft ist der See von tiefer spiritueller und identitätsstiftender Bedeutung; zahlreiche Legenden ranken sich um ein versunkenes Dorf und Geister auf dem Grund des Gewässers. Trotz seiner unbestreitbaren Schönheit befand sich der See lange Zeit in einer ökologischen Krise: Die Einleitung von städtischen Abwässern und landwirtschaftlichen Düngemitteln führte zu einer massiven Eutrophierung, weshalb die Oberfläche regelmäßig komplett mit invasiven Wasserhyazinthen (Ninfa) zuwuchs, die dem See den Sauerstoff raubten. In den letzten Jahren haben lokale Umweltschutzgruppen und Studenten bemerkenswerte Anstrengungen unternommen, die Wasserpflanzen manuell zu entfernen und den See in ein Vorzeigemodell für erfolgreiche ökologische Rettung zu verwandeln. Geografie K7 — Eutrophierung und Seerettung."
    },
    factsAdvanced: {
      hu: ["A tó szorosan San Cristóbal Verapaz városa mellé ékelodik be, 1 390 méter magasságban.", "Vize hűvös, a tó környékét gyakran sűrű, szitáló hegyi köd (chipi-chipi) borítja.", "Súlyos eutrofizációval küzd a városi szennyvíz és a mütrágyák bemosódása miatt.", "A vízfelületet gyakran invazív vízi jácintok (ninfa) és nád (tul) borítják el.", "A helyiek a 'tul' nádat begyujtik, hogy 'petates'-eket (hagyományos guatemalai fonott szőnyegeket) készítsenek.", "A helyi legenda szerint a tó alján egy elsüllyedt falu fekszik büntetésből (hasonlóan sok más maja tó-legendához)."],
      de: ["Die Laguna Chichoj liegt idyllisch in einem kühlen, nebeligen Tal der Alta Verapaz.", "Der See litt über Jahrzehnte massiv unter Eutrophierung durch städtische Abwässer.", "Invasive Wasserhyazinthen bedeckten zeitweise fast die gesamte Wasseroberfläche.", "Lokale Gemeinden investieren viel ehrenamtliche Arbeit, um die Pflanzen von Hand zu beseitigen.", "Ein kleiner, bewaldeter Uferpark (Parque Ecológico) dient als beliebtes Naherholungsgebiet.", "Zahlreiche Poqomchi'-Legenden schreiben dem oft dunklen Wasser mystische Kräfte zu."]
    },
    descriptionAdvanced: { de: "Die Laguna Chichoj ist ein pittoresker, von Bergen umrahmter See direkt am Rande der Stadt San Cristóbal Verapaz (Departamento Alta Verapaz). Für die indigene Poqomchi'-Gemeinschaft ist der See von tiefer spiritueller und identitätsstiftender Bedeutung; zahlreiche Legenden ranken sich um ein versunkenes Dorf und Geister auf dem Grund des Gewässers. Trotz seiner unbestreitbaren Schönheit befand sich der See lange Zeit in einer ökologischen Krise: Die Einleitung von städtischen Abwässern und landwirtschaftlichen Düngemitteln führte zu einer massiven Eutrophierung, weshalb die Oberfläche regelmäßig komplett mit invasiven Wasserhyazinthen (Ninfa) zuwuchs, die dem See den Sauerstoff raubten. In den letzten Jahren haben lokale Umweltschutzgruppen und Studenten bemerkenswerte Anstrengungen unternommen, die Wasserpflanzen manuell zu entfernen und den See in ein Vorzeigemodell für erfolgreiche ökologische Rettung zu verwandeln. Geografie K7 — Eutrophierung und Seerettung.", hu: "Chichoj-lagúna Guatemala egyik figyelemre méltó pontja, ahol a maja örökség, a vulkáni felföld és az ország sokszínű kultúrája kézzelfoghatóan találkozik. Kis tó San Cristóbal Verapaz közelében, amely azonban ökológiailag veszélyeztetett. Ugyanakkor San Cristóbal Verapaz közelében. Emellett Ökológiailag veszélyeztetett. A környéken Fontos a helyi közösség számára. Jellemző továbbá Poqomchi'-maja régió. Mindezekkel együtt Chichoj-lagúna jól illeszkedik Guatemala összképébe, és megmutatja, mennyire szorosan kapcsolódik egymáshoz a maja kultúra, a vulkanikus felföld, valamint a kávé, a cukornád és a banán termesztése.", ro: "Laguna Chichoj este un punct remarcabil al Guatemalei, unde moștenirea maya, peisajul vulcanic și diversitatea culturală a țării se întâlnesc într-un mod expresiv. Un lac mic lângă San Cristóbal Verapaz, dar care este amenințat ecologic. În același timp Lângă San Cristóbal Verapaz. Pe lângă acestea Amenințat ecologic. În zonă Important pentru comunitatea locală. De asemenea Regiunea mayașă Poqomchi'. Astfel, Laguna Chichoj se încadrează firesc în imaginea de ansamblu a Guatemalei, arătând cât de strâns sunt legate cultura maya, peisajul vulcanic și cultivarea cafelei, a trestiei de zahăr și a bananelor.", en: "Laguna Chichoj is a notable location in Guatemala where the rich Maya heritage, the volcanic highland landscape and the country's cultural diversity come together in a striking way. A small lake near San Cristóbal Verapaz which is, however, ecologically threatened. At the same time Near San Cristóbal Verapaz. In addition Ecologically threatened. In the surrounding area Important for the local community. Another characteristic feature Poqomchi' Maya region. In this way, Laguna Chichoj fits naturally into the wider picture of Guatemala, showing how closely Maya culture, the volcanic highlands and the cultivation of coffee, sugar cane and bananas are intertwined." },
    factsAdvanced: { de: ["Die Laguna Chichoj liegt idyllisch in einem kühlen, nebeligen Tal der Alta Verapaz.", "Der See litt über Jahrzehnte massiv unter Eutrophierung durch städtische Abwässer.", "Invasive Wasserhyazinthen bedeckten zeitweise fast die gesamte Wasseroberfläche.", "Lokale Gemeinden investieren viel ehrenamtliche Arbeit, um die Pflanzen von Hand zu beseitigen.", "Ein kleiner, bewaldeter Uferpark (Parque Ecológico) dient als beliebtes Naherholungsgebiet.", "Zahlreiche Poqomchi'-Legenden schreiben dem oft dunklen Wasser mystische Kräfte zu."], hu: ["San Cristóbal Verapaz közelében", "Ökológiailag veszélyeztetett", "Fontos a helyi közösség számára", "Poqomchi'-maja régió", "Guatemalában, a maja örökségéről ismert közép-amerikai országban található.", "Tükrözi a felföld, a Petén-medence és a Csendes-óceáni partvidék közötti régiójára jellemző sajátosságokat.", "Beleilleszkedik Guatemala vulkánjai, az Atitlán-tó és az olyan maja helyszínek, mint Tikal és Antigua alkotta kulturális mozaikba."], ro: ["Lângă San Cristóbal Verapaz", "Amenințat ecologic", "Important pentru comunitatea locală", "Regiunea mayașă Poqomchi'", "Se află în Guatemala, o țară central-americană cu o moștenire maya pronunțată.", "Reflectă trăsăturile tipice ale regiunii sale, situată între podișul înalt, bazinul Petén și coasta Pacificului.", "Se integrează în mozaicul guatemalez format din vulcani, lacuri precum Atitlán și situri maya precum Tikal și Antigua."], en: ["Near San Cristóbal Verapaz", "Ecologically threatened", "Important for the local community", "Poqomchi' Maya region", "Located in Guatemala, a Central American country with a strong Maya heritage.", "Reflects features typical of its region between the highlands, the Petén lowlands and the Pacific coast.", "Set within Guatemala's mosaic of volcanoes, lakes such as Atitlán and Maya sites like Tikal and Antigua."] }, image: "/poi-images/laguna-chichoj-nature-v2.webp"},
  {
    id: "cerro-de-la-cruz-nature-v2",
    type: "mountain",
    parent: "GT-SA",
    coords: [-90.725, 14.565],
    name: { de: "Cerro de la Cruz", hu: "Cerro de la Cruz", ro: "Cerro de la Cruz", en: "Hill of the Cross" },
    description: { de: "Ein Hügel mit einem Kreuz nördlich von Antigua, der eine berühmte Aussicht auf die Stadt bietet.", hu: "Hegy kereszttel Antiguától északra, amely híres kilátást nyújt a városra.", ro: "Un deal cu o cruce la nord de Antigua, care oferă o priveliște renumită asupra orașului.", en: "A hill with a cross north of Antigua, offering a famous viewpoint of the city." },
    facts: {
      de: ["Aussichtspunkt über Antigua", "Großes Kreuz auf dem Gipfel", "Leichte Wanderung", "Blick auf den Volcán de Agua"],
      hu: ["Kilátó Antigua fölött", "Nagy kereszt a csúcson", "Könnyű túra", "Kilátás az Agua vulkánra"],
      ro: ["Punct de belvedere asupra Antiguei", "Cruce mare pe vârf", "Drumeție ușoară", "Vedere spre vulcanul de Apă"],
      en: ["Viewpoint over Antigua", "Large cross on top", "Easy hike", "View of Volcán de Agua"]
    },
    descriptionAdvanced: {
      hu: "A Cerro de la Cruz (A Kereszt Dombja) a legismertebb és legkönnyebben megközelíthető kilátópont Antigua Guatemala északi oldalán, a Cerro del Manchén lejtőjén. Ezt a kisebb magaslatot egy hatalmas, masszív kőkereszt koronázza meg, amelyet 1930-ban állítottak fel a város oltalmazására. A hegyoldalból elénk táruló látvány a világ egyik legklasszikusabb képeslap-panorámája: az előtérben Antigua piros cserepes tetői, rejtett udvarai és sárga barokk templomtornyai láthatók tökéletes rácsos (sakktábla) elrendezésben, míg a háttérben fenyegetően, mégis fenségesen magasodik a tökéletes kúp alakú Agua vulkán. A domb sűrű ciprus- és tölgyfákkal (cipreses) van beültetve, és népszerű gyalogos túra (bár a múltbeli közbiztonsági gondok miatt ma már turisztikai rendőrség őrzi). Földrajz K6 — vulkáni völgyek városépítészete (panoráma).",
      de: "Der Cerro de la Cruz (Hügel des Kreuzes) ist ein steiler, bewaldeter Hügel direkt nördlich der Kolonialstadt Antigua Guatemala. Er ist landesweit bekannt als der absolute Premium-Aussichtspunkt, von dem aus man das klassische, perfekte Postkartenmotiv der Stadt bewundern kann. Ein massives, steinernes Kreuz auf dem Gipfel markiert den Ort, von dem aus sich die gesamte Stadt mit ihrem schachbrettartigen Straßenraster (Trazo en Damero), den zerbrochenen Kirchendächern und roten Ziegeln ausbreitet. Dahinter erhebt sich die fast symmetrische, dramatische Form des Volcán de Agua. Der kurze Aufstieg über Steintreppen durch den dichten Wald ist eine der beliebtesten Aktivitäten für Touristen. Historisch diente der Hügel in unruhigen Zeiten den Streitkräften als strategischer Überwachungsort für die Stadt; heute ist er glücklicherweise eine rein friedliche Oase für Fotografen und verliebte Paare. Geografie K7 — Topografische Stadtansichten."
    },
    factsAdvanced: {
      hu: ["Egy könnyen megmászható, sűrű fákkal borított domb Antigua Guatemala északi szélén.", "A csúcson egy hatalmas kőkereszt áll (1930-ból), amely védi a várost.", "Kínálja az ország leghíresebb 'képeslap-panorámáját': a gyarmati város és az Agua vulkán tökéletes együttesét.", "A kilátóból jól kivehető Antigua spanyol gyarmati, szigorú sakktábla-szerű (rácsos) úthálózata.", "A dombot borító növényzet foleg fenyőkből és ciprusfákból áll.", "Az ösvény (bár aszfaltozott út is felvisz) közkedvelt a zarándokok és a sportolók körében."],
      de: ["Der Cerro de la Cruz bietet das berühmteste Panoramabild auf Antigua und den Volcán de Agua.", "Ein großes Steinkreuz aus dem Jahr 1930 krönt die Aussichtsplattform auf dem Gipfel.", "Der Aufstieg erfolgt über sanfte Steintreppen direkt vom Zentrum der Stadt aus.", "Aus dieser Höhe lässt sich das historische spanische Straßenraster (Quadratmuster) Antiguas gut erkennen.", "In der Vergangenheit wurde der bewaldete Hügel durch eine Präsenz der Touristenpolizei sicherer gemacht.", "An Feiertagen, wie in der Karwoche, ist der Aussichtspunkt komplett überfüllt."]
    },
    descriptionAdvanced: { de: "Der Cerro de la Cruz (Hügel des Kreuzes) ist ein steiler, bewaldeter Hügel direkt nördlich der Kolonialstadt Antigua Guatemala. Er ist landesweit bekannt als der absolute Premium-Aussichtspunkt, von dem aus man das klassische, perfekte Postkartenmotiv der Stadt bewundern kann. Ein massives, steinernes Kreuz auf dem Gipfel markiert den Ort, von dem aus sich die gesamte Stadt mit ihrem schachbrettartigen Straßenraster (Trazo en Damero), den zerbrochenen Kirchendächern und roten Ziegeln ausbreitet. Dahinter erhebt sich die fast symmetrische, dramatische Form des Volcán de Agua. Der kurze Aufstieg über Steintreppen durch den dichten Wald ist eine der beliebtesten Aktivitäten für Touristen. Historisch diente der Hügel in unruhigen Zeiten den Streitkräften als strategischer Überwachungsort für die Stadt; heute ist er glücklicherweise eine rein friedliche Oase für Fotografen und verliebte Paare. Geografie K7 — Topografische Stadtansichten.", hu: "Cerro de la Cruz Guatemala egyik figyelemre méltó pontja, ahol a maja örökség, a vulkáni felföld és az ország sokszínű kultúrája kézzelfoghatóan találkozik. Hegy kereszttel Antiguától északra, amely híres kilátást nyújt a városra. Ugyanakkor Kilátó Antigua fölött. Emellett Nagy kereszt a csúcson. A környéken Könnyű túra. Jellemző továbbá Kilátás az Agua vulkánra. Mindezekkel együtt Cerro de la Cruz jól illeszkedik Guatemala összképébe, és megmutatja, mennyire szorosan kapcsolódik egymáshoz a maja kultúra, a vulkanikus felföld, valamint a kávé, a cukornád és a banán termesztése.", ro: "Cerro de la Cruz este un punct remarcabil al Guatemalei, unde moștenirea maya, peisajul vulcanic și diversitatea culturală a țării se întâlnesc într-un mod expresiv. Un deal cu o cruce la nord de Antigua, care oferă o priveliște renumită asupra orașului. În același timp Punct de belvedere asupra Antiguei. Pe lângă acestea Cruce mare pe vârf. În zonă Drumeție ușoară. De asemenea Vedere spre vulcanul de Apă. Astfel, Cerro de la Cruz se încadrează firesc în imaginea de ansamblu a Guatemalei, arătând cât de strâns sunt legate cultura maya, peisajul vulcanic și cultivarea cafelei, a trestiei de zahăr și a bananelor.", en: "Hill of the Cross is a notable location in Guatemala where the rich Maya heritage, the volcanic highland landscape and the country's cultural diversity come together in a striking way. A hill with a cross north of Antigua, offering a famous viewpoint of the city. At the same time Viewpoint over Antigua. In addition Large cross on top. In the surrounding area Easy hike. Another characteristic feature View of Volcán de Agua. In this way, Hill of the Cross fits naturally into the wider picture of Guatemala, showing how closely Maya culture, the volcanic highlands and the cultivation of coffee, sugar cane and bananas are intertwined." },
    factsAdvanced: { de: ["Der Cerro de la Cruz bietet das berühmteste Panoramabild auf Antigua und den Volcán de Agua.", "Ein großes Steinkreuz aus dem Jahr 1930 krönt die Aussichtsplattform auf dem Gipfel.", "Der Aufstieg erfolgt über sanfte Steintreppen direkt vom Zentrum der Stadt aus.", "Aus dieser Höhe lässt sich das historische spanische Straßenraster (Quadratmuster) Antiguas gut erkennen.", "In der Vergangenheit wurde der bewaldete Hügel durch eine Präsenz der Touristenpolizei sicherer gemacht.", "An Feiertagen, wie in der Karwoche, ist der Aussichtspunkt komplett überfüllt."], hu: ["Kilátó Antigua fölött", "Nagy kereszt a csúcson", "Könnyű túra", "Kilátás az Agua vulkánra", "Guatemalában, a maja örökségéről ismert közép-amerikai országban található.", "Tükrözi a felföld, a Petén-medence és a Csendes-óceáni partvidék közötti régiójára jellemző sajátosságokat.", "Beleilleszkedik Guatemala vulkánjai, az Atitlán-tó és az olyan maja helyszínek, mint Tikal és Antigua alkotta kulturális mozaikba."], ro: ["Punct de belvedere asupra Antiguei", "Cruce mare pe vârf", "Drumeție ușoară", "Vedere spre vulcanul de Apă", "Se află în Guatemala, o țară central-americană cu o moștenire maya pronunțată.", "Reflectă trăsăturile tipice ale regiunii sale, situată între podișul înalt, bazinul Petén și coasta Pacificului.", "Se integrează în mozaicul guatemalez format din vulcani, lacuri precum Atitlán și situri maya precum Tikal și Antigua."], en: ["Viewpoint over Antigua", "Large cross on top", "Easy hike", "View of Volcán de Agua", "Located in Guatemala, a Central American country with a strong Maya heritage.", "Reflects features typical of its region between the highlands, the Petén lowlands and the Pacific coast.", "Set within Guatemala's mosaic of volcanoes, lakes such as Atitlán and Maya sites like Tikal and Antigua."] }, image: "/poi-images/cerro-de-la-cruz-nature-v2.webp"},
  {
    id: "monterrico-nature-reserve-nature-v2",
    type: "forest",
    parent: "GT-SR",
    coords: [-90.28, 13.88],
    name: { de: "Naturreservat Monterrico", hu: "Monterrico Természetvédelmi Terület", ro: "Rezervația Naturală Monterrico", en: "Monterrico Nature Reserve" },
    description: { de: "Ein Küstenreservat mit Mangroven und Kanälen, bekannt für seine Meeresschildkröten-Schutzprojekte.", hu: "Part menti rezervátum mangrovékkal és csatornákkal, ismert a tengeri teknősök védelmi projektjeiről.", ro: "O rezervație de coastă cu mangrove și canale, cunoscută pentru proiectele sale de conservare a țestoaselor marine.", en: "A coastal reserve with mangroves and canals, known for its sea turtle conservation projects." },
    facts: {
      de: ["Schutz von Meeresschildkröten", "Schwarze Sandstrände", "Mangroven-Feuchtgebiete", "Vogelbeobachtung"],
      hu: ["Tengeri teknősök védelme", "Fekete homokos strandok", "Mangrove-vizes élőhelyek", "Madármegfigyelés"],
      ro: ["Conservarea țestoaselor marine", "Plaje de nisip negru", "Zone umede cu mangrove", "Observarea păsărilor"],
      en: ["Sea turtle conservation", "Black sand beaches", "Mangrove wetlands", "Bird watching"]
    },
    descriptionAdvanced: {
      hu: "Monterrico Guatemala legismertebb és legnépszerűbb tengerparti nyaralóhelye, amely a Csendes-óceán partján, Santa Rosa megyében fekszik. A falu fő vonzerejét a különleges, finom tapintású, koromfekete vulkáni homokos tengerpartja és az óceán hatalmas, gyakran veszélyes, szörfözésre alkalmas hullámai ('olas') adják. A város hátországát a 'Canal de Chiquimulilla', egy végtelen mangrove-csatornarendszer alkotja, amelyben motorcsónakkal (lancha) lehet hajnalban madárlesre és aligátornézőbe indulni. Monterrico ugyanakkor a guatemalai teknősvédelem központja is: az itt működő Biotopo Monterrico-Hawaii és a helyi 'Tortugarios' (teknőskeltetők) minden évben (főleg szeptember és december között) tízezer számra engedik szabadon az újszülött olajzöld fattyúteknősöket és kérgesteknősöket (liberación de tortugas), amely esemény mágnesként vonzza az ökoturistákat és a családokat. Sachkunde K5 — vulkáni partok és teknős-mentőprogramok.",
      de: "Monterrico ist das berühmteste Stranddorf an der guatemaltekischen Pazifikküste (Santa Rosa) und bekannt für seinen glitzernden, kohlrabenschwarzen Vulkansand, der sich in der Mittagssonne extrem aufheizt. Hinter dem Strand erstreckt sich ein komplexes Netzwerk aus Mangrovensümpfen ('Canal de Chiquimulilla'). Das Herz der Gemeinde schlägt jedoch für den Schildkrötenschutz. Jedes Jahr zwischen Juli und November kommen Hunderte von bedrohten Meeresschildkröten (insbesondere die Oliv-Bastardschildkröte) an diesen Strand, um in der Nacht ihre Eier abzulegen. Lokale Naturschutzorganisationen kaufen die Eier von Sammlern ('Parlameros') auf, die sie sonst essen würden, und brüten sie sicher aus. Die massenhafte Freilassung von zehntausenden kleinen Babyschildkröten am Strand bei Sonnenuntergang ist ein tief bewegendes Ereignis, das Touristen aus aller Welt anzieht. Biologie K6 — Schutz der Meeresschildkröten."
    },
    factsAdvanced: {
      hu: ["Guatemala leghíresebb fekete (vulkáni) homokos tengerpartja a Csendes-óceánon.", "Szeptember és december között itt zajlik az ország legnagyobb tengeri teknős szabadon engedési ('liberación') programja.", "A település mögött a kiterjedt 'Canal de Chiquimulilla' mocsaras mangroveerdeje fekszik.", "A helyi CECON 'Tortugario' (Teknősvédelmi Központ) megvásárolja a helyiektől a tojásokat, hogy védett helyen keltse ki ket.", "Az óceán sodrása és hullámzása ('resaca') gyakran extrém erős és veszélyes a fürdőzők számára.", "A falu klímája egész évben tikkasztóan forró, a fekete homok a déli órákban szinte égeti a talpat."],
      de: ["Der Strand von Monterrico besteht aus extrem heißem, rein schwarzem vulkanischem Sand.", "Das Dorf ist das nationale Zentrum für den Schutz der gefährdeten Meeresschildkröten.", "Eiersammler ('Parlameros') verkaufen die Schildkröteneier an lokale Aufzuchtstationen.", "Im Herbst werden täglich kleine Schildkröten von Touristen in den Ozean entlassen.", "Die gefährliche und starke Pazifikströmung (Unterströmungen) verbietet weites Schwimmen.", "Die Anreise erfolgte traditionell lange Zeit nur über Fähren durch die dichten Mangrovenkanäle."]
    },
    descriptionAdvanced: { de: "Monterrico ist das berühmteste Stranddorf an der guatemaltekischen Pazifikküste (Santa Rosa) und bekannt für seinen glitzernden, kohlrabenschwarzen Vulkansand, der sich in der Mittagssonne extrem aufheizt. Hinter dem Strand erstreckt sich ein komplexes Netzwerk aus Mangrovensümpfen ('Canal de Chiquimulilla'). Das Herz der Gemeinde schlägt jedoch für den Schildkrötenschutz. Jedes Jahr zwischen Juli und November kommen Hunderte von bedrohten Meeresschildkröten (insbesondere die Oliv-Bastardschildkröte) an diesen Strand, um in der Nacht ihre Eier abzulegen. Lokale Naturschutzorganisationen kaufen die Eier von Sammlern ('Parlameros') auf, die sie sonst essen würden, und brüten sie sicher aus. Die massenhafte Freilassung von zehntausenden kleinen Babyschildkröten am Strand bei Sonnenuntergang ist ein tief bewegendes Ereignis, das Touristen aus aller Welt anzieht. Biologie K6 — Schutz der Meeresschildkröten.", hu: "Monterrico Természetvédelmi Terület Guatemala egyik figyelemre méltó pontja, ahol a maja örökség, a vulkáni felföld és az ország sokszínű kultúrája kézzelfoghatóan találkozik. Part menti rezervátum mangrovékkal és csatornákkal, ismert a tengeri teknősök védelmi projektjeiről. Ugyanakkor Tengeri teknősök védelme. Emellett Fekete homokos strandok. A környéken Mangrove-vizes élőhelyek. Jellemző továbbá Madármegfigyelés. Mindezekkel együtt Monterrico Természetvédelmi Terület jól illeszkedik Guatemala összképébe, és megmutatja, mennyire szorosan kapcsolódik egymáshoz a maja kultúra, a vulkanikus felföld, valamint a kávé, a cukornád és a banán termesztése.", ro: "Rezervația Naturală Monterrico este un punct remarcabil al Guatemalei, unde moștenirea maya, peisajul vulcanic și diversitatea culturală a țării se întâlnesc într-un mod expresiv. O rezervație de coastă cu mangrove și canale, cunoscută pentru proiectele sale de conservare a țestoaselor marine. În același timp Conservarea țestoaselor marine. Pe lângă acestea Plaje de nisip negru. În zonă Zone umede cu mangrove. De asemenea Observarea păsărilor. Astfel, Rezervația Naturală Monterrico se încadrează firesc în imaginea de ansamblu a Guatemalei, arătând cât de strâns sunt legate cultura maya, peisajul vulcanic și cultivarea cafelei, a trestiei de zahăr și a bananelor.", en: "Monterrico Nature Reserve is a notable location in Guatemala where the rich Maya heritage, the volcanic highland landscape and the country's cultural diversity come together in a striking way. A coastal reserve with mangroves and canals, known for its sea turtle conservation projects. At the same time Sea turtle conservation. In addition Black sand beaches. In the surrounding area Mangrove wetlands. Another characteristic feature Bird watching. In this way, Monterrico Nature Reserve fits naturally into the wider picture of Guatemala, showing how closely Maya culture, the volcanic highlands and the cultivation of coffee, sugar cane and bananas are intertwined." },
    factsAdvanced: { de: ["Der Strand von Monterrico besteht aus extrem heißem, rein schwarzem vulkanischem Sand.", "Das Dorf ist das nationale Zentrum für den Schutz der gefährdeten Meeresschildkröten.", "Eiersammler ('Parlameros') verkaufen die Schildkröteneier an lokale Aufzuchtstationen.", "Im Herbst werden täglich kleine Schildkröten von Touristen in den Ozean entlassen.", "Die gefährliche und starke Pazifikströmung (Unterströmungen) verbietet weites Schwimmen.", "Die Anreise erfolgte traditionell lange Zeit nur über Fähren durch die dichten Mangrovenkanäle."], hu: ["Tengeri teknősök védelme", "Fekete homokos strandok", "Mangrove-vizes élőhelyek", "Madármegfigyelés", "Guatemalában, a maja örökségéről ismert közép-amerikai országban található.", "Tükrözi a felföld, a Petén-medence és a Csendes-óceáni partvidék közötti régiójára jellemző sajátosságokat.", "Beleilleszkedik Guatemala vulkánjai, az Atitlán-tó és az olyan maja helyszínek, mint Tikal és Antigua alkotta kulturális mozaikba."], ro: ["Conservarea țestoaselor marine", "Plaje de nisip negru", "Zone umede cu mangrove", "Observarea păsărilor", "Se află în Guatemala, o țară central-americană cu o moștenire maya pronunțată.", "Reflectă trăsăturile tipice ale regiunii sale, situată între podișul înalt, bazinul Petén și coasta Pacificului.", "Se integrează în mozaicul guatemalez format din vulcani, lacuri precum Atitlán și situri maya precum Tikal și Antigua."], en: ["Sea turtle conservation", "Black sand beaches", "Mangrove wetlands", "Bird watching", "Located in Guatemala, a Central American country with a strong Maya heritage.", "Reflects features typical of its region between the highlands, the Petén lowlands and the Pacific coast.", "Set within Guatemala's mosaic of volcanoes, lakes such as Atitlán and Maya sites like Tikal and Antigua."] }, image: "/poi-images/monterrico-nature-reserve-nature-v2.webp"},
  {
    id: "fuentes-georginas-nature-v2",
    type: "river",
    parent: "GT-QZ",
    coords: [-91.47, 14.78],
    name: { de: "Fuentes Georginas", hu: "Fuentes Georginas", ro: "Fuentes Georginas", en: "Fuentes Georginas" },
    description: { de: "Natürliche heiße Schwefelquellen an den Hängen des Zunil-Vulkans.", hu: "Természetes, forró kénes források a Zunil-vulkán lejtőin.", ro: "Izvoare termale naturale sulfuroase pe versanții vulcanului Zunil.", en: "Natural hot sulfur springs on the slopes of the Zunil volcano." },
    facts: {
      de: ["Heiße Thermalquellen", "Vulkanischer Ursprung", "Umgeben von Nebelwald", "Beliebtes Erholungsbad"],
      hu: ["Forró termálforrások", "Vulkáni eredetű", "Köderdővel körülvéve", "Népszerű fürdőhely"],
      ro: ["Izvoare termale fierbinți", "Origine vulcanică", "Înconjurat de pădure noroasă", "Stațiune balneară populară"],
      en: ["Hot thermal springs", "Volcanic origin", "Surrounded by cloud forest", "Popular recreational baths"]
    },
    descriptionAdvanced: {
      hu: "A Fuentes Georginas egy lélegzetelállító, vulkáni eredetű melegvízű fürdő (aguas termales) magasan a Zunil vulkán ködös lejtőin, Quetzaltenango (Xela) közelében. Az 1902-ben, Jorge Ubico diktátor (akinek a feleségét Georginának hívták) idején felfedezett és kiépített fürdő a guatemalai magasföld egyik leghíresebb pihenőhelye. A forró (akár 40-50 °C-os), kénes, gyógyító hatású víz egyenesen a vulkanikus sziklafalakból zuhog a természetes kövekből kialakított medencékbe. A fürdő egyedülálló varázsát a drámai kontraszt adja: miközben az ember a forró vízben ázik, a környező fagyos, több mint 2400 méter magasan fekvő felhőerdő (bosque nuboso) vastag páfrányai, óriási orchideái és a fákról csöpögő, sűrű fehér köd öleli körül. Földrajz K7 — geotermikus energia és a magaslati felhőerdők.",
      de: "Versteckt in den eisigen, oft in dichten Nebel gehüllten Bergen oberhalb von Quetzaltenango (Xela) liegen die 'Fuentes Georginas'. Diese natürlichen heißen Quellen ('Aguas Termales') sind ein echtes geologisches Wunder, denn das Wasser wird tief unter der Erde durch die Hitze des aktiven Zunil-Vulkans erwärmt. Der Kontrast könnte nicht dramatischer sein: Während die Lufttemperatur nahe dem Gefrierpunkt liegt, baden die Besucher in dampfend heißem Wasser, umgeben von einem dichten, subtropischen Bergnebelwald mit moosbewachsenen Bäumen und riesigen Farnen. Die Quellen wurden im späten 19. Jahrhundert entdeckt und nach dem damaligen Diktator Jorge Ubico (oder seiner Frau) benannt. Für die lokale Bevölkerung und erschöpfte Touristen ist das Baden in diesen natürlichen, schwefelhaltigen Vulkanpools die ultimative Entspannungstherapie nach kalten Tagen im Hochland. Geografie K7 — Geothermie und Vulkane."
    },
    factsAdvanced: {
      hu: ["A geotermikus hőforrás a 3 542 méter magas inaktív Zunil vulkán magmájából (kénes gőzökbol) nyeri a hojét.", "Jorge Ubico elnök idején építették ki a fürdot, és feleségérol, Georgináról nevezték el.", "A termálmedencék 2 400 méternél is magasabban, sűrű és fagyos felhőerdőben (bosque nuboso) találhatók.", "A víz homérséklete az elso medencében meghaladhatja a 45 °C-ot, ami drasztikus kontraszt a fagyos hegyi levegővel.", "A medencék mögötti mohás sziklafalakon gigantikus páfrányfák (helechos) és broméliák élnek.", "A hely a helyi k'iche' maják számára szakrális jelentoségu is, a gyógyvíz és a vulkáni barlangok miatt."],
      de: ["Die Fuentes Georginas werden durch die unterirdische Hitze des Vulkans Zunil gespeist.", "Die heißen Thermalquellen (Aguas Termales) fließen aus einer Felswand direkt in die Badebecken.", "Die Anlage liegt in einem feuchtkalten Nebelwald auf über 2.400 Metern Höhe.", "Der Ort ist bekannt für den extremen Kontrast zwischen heißem Wasser und eisiger Bergluft.", "Das schwefelhaltige Wasser gilt als heilend für Muskel- und Gelenkbeschwerden.", "Der Weg zu den Quellen führt durch steile, fruchtbare Gemüseterrassen indigener Bauern."]
    },
    descriptionAdvanced: { de: "Versteckt in den eisigen, oft in dichten Nebel gehüllten Bergen oberhalb von Quetzaltenango (Xela) liegen die 'Fuentes Georginas'. Diese natürlichen heißen Quellen ('Aguas Termales') sind ein echtes geologisches Wunder, denn das Wasser wird tief unter der Erde durch die Hitze des aktiven Zunil-Vulkans erwärmt. Der Kontrast könnte nicht dramatischer sein: Während die Lufttemperatur nahe dem Gefrierpunkt liegt, baden die Besucher in dampfend heißem Wasser, umgeben von einem dichten, subtropischen Bergnebelwald mit moosbewachsenen Bäumen und riesigen Farnen. Die Quellen wurden im späten 19. Jahrhundert entdeckt und nach dem damaligen Diktator Jorge Ubico (oder seiner Frau) benannt. Für die lokale Bevölkerung und erschöpfte Touristen ist das Baden in diesen natürlichen, schwefelhaltigen Vulkanpools die ultimative Entspannungstherapie nach kalten Tagen im Hochland. Geografie K7 — Geothermie und Vulkane.", hu: "Fuentes Georginas Guatemala egyik figyelemre méltó pontja, ahol a maja örökség, a vulkáni felföld és az ország sokszínű kultúrája kézzelfoghatóan találkozik. Természetes, forró kénes források a Zunil-vulkán lejtőin. Ugyanakkor Forró termálforrások. Emellett Vulkáni eredetű. A környéken Köderdővel körülvéve. Jellemző továbbá Népszerű fürdőhely. Mindezekkel együtt Fuentes Georginas jól illeszkedik Guatemala összképébe, és megmutatja, mennyire szorosan kapcsolódik egymáshoz a maja kultúra, a vulkanikus felföld, valamint a kávé, a cukornád és a banán termesztése.", ro: "Fuentes Georginas este un punct remarcabil al Guatemalei, unde moștenirea maya, peisajul vulcanic și diversitatea culturală a țării se întâlnesc într-un mod expresiv. Izvoare termale naturale sulfuroase pe versanții vulcanului Zunil. În același timp Izvoare termale fierbinți. Pe lângă acestea Origine vulcanică. În zonă Înconjurat de pădure noroasă. De asemenea Stațiune balneară populară. Astfel, Fuentes Georginas se încadrează firesc în imaginea de ansamblu a Guatemalei, arătând cât de strâns sunt legate cultura maya, peisajul vulcanic și cultivarea cafelei, a trestiei de zahăr și a bananelor.", en: "Fuentes Georginas is a notable location in Guatemala where the rich Maya heritage, the volcanic highland landscape and the country's cultural diversity come together in a striking way. Natural hot sulfur springs on the slopes of the Zunil volcano. At the same time Hot thermal springs. In addition Volcanic origin. In the surrounding area Surrounded by cloud forest. Another characteristic feature Popular recreational baths. In this way, Fuentes Georginas fits naturally into the wider picture of Guatemala, showing how closely Maya culture, the volcanic highlands and the cultivation of coffee, sugar cane and bananas are intertwined." },
    factsAdvanced: { de: ["Die Fuentes Georginas werden durch die unterirdische Hitze des Vulkans Zunil gespeist.", "Die heißen Thermalquellen (Aguas Termales) fließen aus einer Felswand direkt in die Badebecken.", "Die Anlage liegt in einem feuchtkalten Nebelwald auf über 2.400 Metern Höhe.", "Der Ort ist bekannt für den extremen Kontrast zwischen heißem Wasser und eisiger Bergluft.", "Das schwefelhaltige Wasser gilt als heilend für Muskel- und Gelenkbeschwerden.", "Der Weg zu den Quellen führt durch steile, fruchtbare Gemüseterrassen indigener Bauern."], hu: ["Forró termálforrások", "Vulkáni eredetű", "Köderdővel körülvéve", "Népszerű fürdőhely", "Guatemalában, a maja örökségéről ismert közép-amerikai országban található.", "Tükrözi a felföld, a Petén-medence és a Csendes-óceáni partvidék közötti régiójára jellemző sajátosságokat.", "Beleilleszkedik Guatemala vulkánjai, az Atitlán-tó és az olyan maja helyszínek, mint Tikal és Antigua alkotta kulturális mozaikba."], ro: ["Izvoare termale fierbinți", "Origine vulcanică", "Înconjurat de pădure noroasă", "Stațiune balneară populară", "Se află în Guatemala, o țară central-americană cu o moștenire maya pronunțată.", "Reflectă trăsăturile tipice ale regiunii sale, situată între podișul înalt, bazinul Petén și coasta Pacificului.", "Se integrează în mozaicul guatemalez format din vulcani, lacuri precum Atitlán și situri maya precum Tikal și Antigua."], en: ["Hot thermal springs", "Volcanic origin", "Surrounded by cloud forest", "Popular recreational baths", "Located in Guatemala, a Central American country with a strong Maya heritage.", "Reflects features typical of its region between the highlands, the Petén lowlands and the Pacific coast.", "Set within Guatemala's mosaic of volcanoes, lakes such as Atitlán and Maya sites like Tikal and Antigua."] }
  }
];

