# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# next.js
/.next/

# build output at root level (prevent accidental root pollution)
# NOTE: /out/ is NOT ignored — build artifacts must be committed for deployment
/index.html
/404.html
/sw.js
/manifest.json
/_next/
/_not-found/
/__next.*.txt

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files
# .env.local is committed intentionally (contains only public NEXT_PUBLIC_ anon keys)
.env*.local
!.env.local

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Service account credentials (NEVER commit!)
scripts/service-account.json
supabase/.temp/
.claude/

# POI images (synced separately via scripts/sync-poi-images.sh, 2.3GB)
public/poi-images/
__pycache__/
*.pyc

# Local SEO and script artifacts
lib/visualLab/.seo_tmp/
generate_seo_batch*.py
tsfiles.txt
*.bak
*_old.ts
lib/visualLab/data/basic-poi-*.json
lib/visualLab/data/_all_v2_pois.json
