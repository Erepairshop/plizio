n    box-shadow: none;\n  }\n\n  /*\n  Correct the inability to style the border radius in iOS Safari.\n*/\n\n  button,\n  input:where([type=\"button\"], [type=\"reset\"], [type=\"submit\"]),\n  ::file-selector-button {\n    appearance: button;\n  }\n\n  /*\n  Correct the cursor style of increment and decrement buttons in Safari.\n*/\n\n  ::-webkit-inner-spin-button,\n  ::-webkit-outer-spin-button {\n    height: auto;\n  }\n\n  /*\n  Make elements with the HTML hidden attribute stay hidden by default.\n*/\n\n  [hidden]:where(:not([hidden=\"until-found\"])) {\n    display: none !important;\n  }\n}\n\n@layer utilities {\n  @tailwind utilities;\n}\n","@import \"tailwindcss\";\r\n\r\n:root {\r\n  --color-bg: #0A0A1A;\r\n  --color-card: #12122A;\r\n  --color-neon-pink: #FF2D78;\r\n  --color-neon-blue: #00D4FF;\r\n  --color-neon-green: #00FF88;\r\n  --color-gold: #FFD700;\r\n  --color-neon-purple: #B44DFF;\r\n}\r\n\r\nbody {\r\n  background-color: var(--color-bg);\r\n  color: white;\r\n  overflow-x: hidden;\r\n}\r\n\r\n/* Neon glow utilities */\r\n.glow-pink {\r\n  box-shadow: 0 0 20px rgba(255, 45, 120, 0.5), 0 0 40px rgba(255, 45, 120, 0.2);\r\n}\r\n\r\n.glow-blue {\r\n  box-shadow: 0 0 20px rgba(0, 212, 255, 0.5), 0 0 40px rgba(0, 212, 255, 0.2);\r\n}\r\n\r\n.glow-green {\r\n  box-shadow: 0 0 20px rgba(0, 255, 136, 0.5), 0 0 40px rgba(0, 255, 136, 0.2);\r\n}\r\n\r\n.glow-purple {\r\n  box-shadow: 0 0 20px rgba(180, 77, 255, 0.5), 0 0 40px rgba(180, 77, 255, 0.2);\r\n}\r\n\r\n.glow-gold {\r\n  box-shadow: 0 0 20px rgba(255, 215, 0, 0.5), 0 0 40px rgba(255, 215, 0, 0.2);\r\n}\r\n\r\n/* Text glow */\r\n.text-glow-pink {\r\n  text-shadow: 0 0 10px rgba(255, 45, 120, 0.8), 0 0 20px rgba(255, 45, 120, 0.4);\r\n}\r\n\r\n.text-glow-blue {\r\n  text-shadow: 0 0 10px rgba(0, 212, 255, 0.8), 0 0 20px rgba(0, 212, 255, 0.4);\r\n}\r\n\r\n.text-glow-green {\r\n  text-shadow: 0 0 10px rgba(0, 255, 136, 0.8), 0 0 20px rgba(0, 255, 136, 0.4);\r\n}\r\n\r\n/* Pulse animation for timer */\r\n@keyframes pulse-fast {\r\n  0%, 100% { transform: scale(1); opacity: 1; }\r\n  50% { transform: scale(1.1); opacity: 0.8; }\r\n}\r\n\r\n.animate-pulse-fast {\r\n  animation: pulse-fast 0.5s ease-in-out infinite;\r\n}\r\n\r\n/* Shimmer effect for cards */\r\n@keyframes shimmer {\r\n  0% { background-position: -200% 0; }\r\n  100% { background-position: 200% 0; }\r\n}\r\n\r\n.animate-shimmer {\r\n  background: linear-gradient(90deg, transparent, rgba(255,255,255,0.1), transparent);\r\n  background-size: 200% 100%;\r\n  animation: shimmer 2s infinite;\r\n}\r\n\r\n/* Confetti burst */\r\n@keyframes confetti-fall {\r\n  0% { transform: translateY(-10px) rotate(0deg); opacity: 1; }\r\n  100% { transform: translateY(100vh) rotate(720deg); opacity: 0; }\r\n}\r\n\r\n/* Ripple effect */\r\n@keyframes ripple {\r\n  0% { transform: scale(0); opacity: 0.6; }\r\n  100% { transform: scale(2.5); opacity: 0; }\r\n}\r\n\r\n.animate-ripple {\r\n  animation: ripple 0.6s ease-out;\r\n}\r\n\r\n/* Float animation for logo */\r\n@keyframes float {\r\n  0%, 100% { transform: translateY(0px); }\r\n  50% { transform: translateY(-8px); }\r\n}\r\n\r\n.animate-float {\r\n  animation: float 3s ease-in-out infinite;\r\n}\r\n\r\n@keyframes shake {\r\n  0% { transform: translate(0, 0); }\r\n  20% { transform: translate(-2.5px, 2.5px); }\r\n  40% { transform: translate(-2.5px, -2.5px); }\r\n  60% { transform: translate(2.5px, 2.5px); }\r\n  80% { transform: translate(2.5px, -2.5px); }\r\n  100% { transform: translate(0, 0); }\r\n}\r\n\r\n.animate-shake {\r\n  animation: shake 0.1s ease-in-out infinite;\r\n}\r\n\r\n"],"sourceRoot":""}]);
