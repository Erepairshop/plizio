{"name": "Sysmä", "description": "Perinteikäs kylä Päijänteen rannalla, tunnettu historiallisista kartanoistaan ja perinteisestä sahdista.", "facts": ["Sahdin valmistuksen keskus", "Historialliset kartanot ja tilat", "Sijaitsee suuren Päijänteen rannalla", "Itä-Hämeen museon kotipaikka", "Suosittu mökkilomakohde kesäisin", "Entinen suomalaisen aateliston keskus", "Maisemalliset pyöräily- ja vaellusreitit", "Perinteiset suomalaiset markkinat"], "faq": [{"q": "Mistä Sysmä on tunnettu?", "a": "Kartanoistaan ja suomalaisen kirjallisuuskulttuurin keskuksena (kirjakylä)."}, {"q": "Onko siellä historiallisia rakennuksia?", "a": "Kyllä, 1400-luvun Pyhän Olavin kirkko on ehdottomasti vierailun arvoinen."}, {"q": "Mikä on Kammi-festivaali?", "a": "Paikallinen kamarimusiikkitapahtuma, joka järjestetään vuosittain idyllisissä puitteissa."}, {"q": "Voiko Päijänteessä kalastaa?", "a": "Kyllä, järvi on tunnettu suurista taimenen ja lohen saaliistaan."}, {"q": "Millainen tunnelma on kesällä?", "a": "Erittäin vilkas, sillä lukuisat kesävieraiden mökit tuovat paljon elämää."}], "sights": [{"sourceName": "Sysmän kotiseutumuseo", "name": "Sysmän kotiseutumuseo", "desc": "Paikallishistoriallinen museo historiallisessa rakennuksessa Sysmässä."}, {"sourceName": "Hautaröykkiöitä", "name": "Hautaröykkiöitä", "desc": "Hautaröykkiöitä on arkeologinen kohde, jossa on muinaisia hautakummuja Sysmässä."}, {"sourceName": "Uhrikivi", "name": "Uhrikivi", "desc": "Muinaisaikainen uhrikivi ennen kristillistä aikaa Sysmässä."}, {"sourceName": "Kalmisto", "name": "Kalmisto", "desc": "Esihistoriallinen hautapaikka hautakumpuineen Sysmässä."}, {"sourceName": "Suomen Harmonikkamuseo", "name": "Suomen Harmonikkamuseo", "desc": "Suomen harmonikkamuseo Sysmässä, avattu 1993."}, {"sourceName": "Uimaranta", "name": "Uimaranta", "desc": "Julkinen järvenranta-uimaranta Sysmässä."}, {"sourceName": "ITtE näyttely", "name": "ITtE näyttely", "desc": "Intuitiivisen outsider-taiteen (ITtE) näyttely Sysmässä."}, {"sourceName": "Sysmän helluntaiseurakunta", "name": "Sysmän helluntaiseurakunta", "desc": "Helluntaiseurakunta Sysmässä."}, {"sourceName": "Sysmän Pyhän Olavin kirkko", "name": "Sysmän Pyhän Olavin kirkko", "desc": "Keskiaikainen kivikirkko vuodelta 1520."}, {"sourceName": "Jyrtinlampi", "name": "Jyrtinlampi", "desc": "Puhdas metsäjärvi Sysmän kunnassa."}]}
