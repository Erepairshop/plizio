{"name": "Lapuan tuomiokirkko", "description": "Lapuan tuomiokirkko on vaikuttava sakraalirakennus. Se on Lapuan henkinen keskus.", "facts": ["Uusklassismi", "1800-luku", "Lapua", "Tuomiokirkko"], "faq": [{"q": "Kuka suunnitteli Lapuan tuomiokirkon?", "a": "Kuuluisa arkkitehti Carl Ludvig Engel suunnitteli sen vuonna 1827."}, {"q": "Mikä on erityistä urkujen suhteen?", "a": "Ne ovat Suomen suurimmat urut, yli 85 registrillä."}, {"q": "Onko tuomiokirkossa kellotorni?", "a": "Kyllä, erillinen kellotorni rakennettiin jo vuonna 1730."}, {"q": "Järjestetäänkö konserteja säännöllisesti?", "a": "Kyllä, tuomiokirkko on tunnettu urkukonserteistaan."}, {"q": "Onko tuomiokirkko avoinna talvella?", "a": "Kyllä, se on avoinna vierailijoille ympäri vuoden."}], "sights": [{"sourceName": "Lapuan helluntaiseurakunta", "name": "Lapuan helluntaiseurakunta", "desc": "Helluntaiseurakunta Lapualle."}, {"sourceName": "Lapuan kaupungintalo", "name": "Lapuan kaupungintalo", "desc": "Rakennus Lapualla, Suomi."}, {"sourceName": "Lapuan vapaaseurakunta", "name": "Lapuan vapaaseurakunta", "desc": "Vapaaseurakunta Lapualla."}, {"sourceName": "Lapua Cathedral", "name": "Lapua Cathedral", "desc": "Tuomiokirkko Lapualla, Suomi."}, {"sourceName": "Lapuanliikkeen näyttely", "name": "Lapuanliikkeen näyttely", "desc": "Näyttely entisestä suomalaisesta oikeistoradikaalista järjestöstä."}, {"sourceName": "Pyhälahden valokuvaamomuseo", "name": "Pyhälahden valokuvaamomuseo", "desc": "Valokuvamuseo Lapualla."}, {"sourceName": "Lapuan Patruunatehtaan museo", "name": "Lapuan Patruunatehtaan museo", "desc": "Museo Lapuan patruunatehtaasta, Lapua, Suomi."}, {"sourceName": "Teatteri Lapua", "name": "Teatteri Lapua", "desc": "Teatteri Lapualla."}, {"sourceName": "Lapuan taidemuseo", "name": "Lapuan taidemuseo", "desc": "Taidemuseo Suomessa."}]}
