{"name": "Olavinlinna", "description": "Olavinlinna Savonlinnassa on mahtava 1400-luvun vesilinna.", "facts": ["Rakennettu vuonna 1475.", "Keskeinen esiintymispaikka Savonlinnan oopperajuhlille.", "Sijainti saarella tekee siitä erittäin puolustettavan."], "faq": [{"q": "Missä Olavinlinna sijaitsee?", "a": "Pienellä saarella Savonlinnassa, keskellä Saimaata."}, {"q": "Milloin linna rakennettiin?", "a": "Rakentaminen alkoi vuonna 1475 itärajan suojelemiseksi."}, {"q": "Mikä on oopperajuhla?", "a": "Maailmankuulu heinäkuinen tapahtuma, jossa oopperoita esitetään linnan pihalla."}, {"q": "Miten linnansaarelle pääsee?", "a": "Maantieltä saarelle johtavan kelluvan sillan kautta."}, {"q": "Onko opastuksia englanniksi?", "a": "Kyllä, englanninkielisiä opastuksia on saatavilla päivittäin kesällä."}], "sights": [{"sourceName": "Heikinpohjan uimaranta", "name": "Heikinpohjan uimaranta", "desc": "Heikinpohjan ranta sijaitsee Olavinlinnan läheisyydessä."}, {"sourceName": "Kulttuurikellari", "name": "Kulttuurikellari", "desc": "Paikallinen kulttuurikeskus ja tapahtumapaikka Savonlinnassa."}, {"sourceName": "Pikku-Kakkosen uimaranta", "name": "Pikku-Kakkosen uimaranta", "desc": "Perheystävällinen uimaranta lähellä Olavinlinnaa."}, {"sourceName": "Sireenisaari", "name": "Sireenisaari", "desc": "Luonnonsuojelualue saarella Savonlinnassa."}, {"sourceName": "Savonlinnasali - Savonlinnan teatteri", "name": "Savonlinnasali - Savonlinnan teatteri", "desc": "Konsertti- ja teatterirakennus Savonlinnan kaupungissa."}, {"sourceName": "Summer Theatre", "name": "Summer Theatre", "desc": "Ulkoilmateatteri lähellä historiallista Olavinlinnaa."}, {"sourceName": "Savonlinnan uimahalli", "name": "Savonlinnan uimahalli", "desc": "Savonlinnan paikallinen uimahalli lähellä Olavinlinnaa."}]}
